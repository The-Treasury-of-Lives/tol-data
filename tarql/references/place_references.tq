PREFIX bdo: <http://purl.bdrc.io/ontology/core/>
PREFIX bdr: <http://purl.bdrc.io/resource/>
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX gist: <https://w3id.org/semanticarts/ns/ontology/gist/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX told: <https://w3id.org/treasuryoflives/ns/data/tol/>
PREFIX tolo: <https://w3id.org/treasuryoflives/ns/ontology/tol/>
PREFIX tolx: <https://w3id.org/treasuryoflives/ns/taxonomy/tol/>
PREFIX xml: <http://www.w3.org/XML/1998/namespace>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX wiki: <https://www.wikidata.org/wiki/>
PREFIX media-txt: <https://www.iana.org/assignments/media-types/text/>
PREFIX relators: <http://id.loc.gov/vocabulary/relators/>
PREFIX viaf: <https://viaf.org/viaf/>
PREFIX lccn: <https://id.loc.gov/resources/works/>
PREFIX olid: <https://openlibrary.org/works/>


## COLUMNS
# TOL Source ID
# Source
# PLACE ID
# Source Display
# Pages
# BDRC ID
# VIAF ID
# OCLC ID
# url other
# Source Lang Tag
# Source Display Lang Tag

# Run:
# tarql -e utf-8 --dedup 50000 place_references.tq place-sources-11-13-24.csv > tolPlaceReferences.ttl

# NB This is preliminary data and should not be ingested into the knowledge graph in its current form.

CONSTRUCT {

    ?place_iri rdfs:seeAlso ?reference_iri .

    ?reference_iri
        a gist:ContentExpression ;
        skos:prefLabel ?reference_label ;
        tolo:pageNumbers ?Pages ;
        ?predicate_iri
            ?bdrc_iri ,
            ?viaf_iri ;

        # gist:isIdentifiedBy
        #     ?oclc_id_iri ;
        .

    ?display_text_iri
        a gist:FormattedContent ;
        gist:isAbout ?reference_iri ;
        gist:containedText ?display_text ;
        gist:isExpressedIn media-txt:html ;
        .

    # ?worldcat_id_iri
    #     a gist:ID ;
    #     gist:uniqueText ?OCLC_ID ;
    #     gist:isCategorizedBy tolx:_IdType_worldcat ;
    #     .

}

WHERE {

    # Testing
    # FILTER(?ROWNUM = 1)

    BIND(tarql:expandPrefixedName(CONCAT("told:_ContentExpression_", ?TOL_Source_ID)) AS ?reference_iri)

    BIND(tarql:expandPrefixedName(CONCAT("told:_Place_", ?PLACE_ID)) AS ?place_iri)

    #BIND(STRLANG(?Source, ?Source_Lang_Tag) AS ?reference_label)

    BIND(tarql:expandPrefixedName(CONCAT("told:_FormattedContent_ContentExpression_DisplayText_", ?TOL_Source_ID)) AS ?display_text_iri)
    #BIND(STRLANG(?Source_Display, ?Source_Display_Lang_Tag) AS ?display_text)
    BIND(?Source_Display AS ?display_text)

    # owl:SameAs
    BIND(tarql:expandPrefixedName(CONCAT("bdr:", ?BDRC_ID)) AS ?bdrc_iri)
    BIND(tarql:expandPrefixedName(CONCAT("viaf:", ?VIAF_ID)) AS ?viaf_iri)

    # WorldCat
    BIND(tarql:expandPrefixedName(CONCAT("told:_ID_worldcat_", ?OCLC_ID)) AS ?worldcat_id_iri)

    # If there are page numbers, then the reference is part of the complete work referenced by the BDRC and VIAF IRIs.
    BIND(IF(BOUND(?Pages), "gist:isPartOf", "owl:sameAs") AS ?predicate)
    BIND(tarql:expandPrefixedName(?predicate) AS ?predicate_iri)

}
