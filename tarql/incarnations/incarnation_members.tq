PREFIX bdo: <http://purl.bdrc.io/ontology/core/>
PREFIX bdr: <http://purl.bdrc.io/resource/>
PREFIX gist: <https://w3id.org/semanticarts/ns/ontology/gist/>
PREFIX media-image: <https://www.iana.org/assignments/media-types/image/>
PREFIX media-txt: <https://www.iana.org/assignments/media-types/text/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX told: <https://w3id.org/treasuryoflives/ns/data/tol/>
PREFIX tolo: <https://w3id.org/treasuryoflives/ns/ontology/tol/>
PREFIX tolx: <https://w3id.org/treasuryoflives/ns/taxonomy/tol/>
PREFIX viaf: <https://viaf.org/viaf/>
PREFIX wiki: <https://www.wikidata.org/wiki/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

## Columns
# Incarnation Name - ignore - comes from incarnation lineage data
# Incarnation BDRC ID - ignore - comes from incarnation lineage data
# Incarnation Lineage TOL ID - ?incarnation_lineage_iri
# Previous Incarnation Lineage TOL ID - Used to form ?previous_incarnation_iri for split lineages
# Immediately Preceding Incarnation Unknown
# Previous Incarnation Person TOL ID - ?previous_incarnation_iri
# Incarnation Sequence - ?sequence_int
# Ordinal - ?ordinal_int
# Person BDRC ID - ignore -- comes from person data
# Person TOL ID - ?person_iri
# Branched Lineage - ignore
# New Seat Established - ignore
# Notes - ignore
# Questions for Katie - ignore
# Katie/Alex reply - ignore

# Run:
# tarql -e utf-8 --dedup 5000 incarnation_members.tq incarnation-members-8-4-25.csv > tolIncarnationMembers.ttl

CONSTRUCT {

    ?incarnation_lineage_iri
        tolo:isDerivedFrom ?parent_lineage_iri ;
        .

    ?incarnation_iri
        a tolo:Incarnation ;
        skos:prefLabel ?pref_label_en ;
        gist:providesOrderFor ?person_iri ;
        gist:sequence ?sequence_int ;
        tolo:ordinal ?ordinal_int ;
        ?member_predicate_iri ?incarnation_lineage_iri ;
        .

    ?previous_incarnation_iri ?precedes_predicate_iri ?incarnation_iri .

}

WHERE {

    # Testing
    # FILTER(?ROWNUM IN (688))

    BIND(tarql:expandPrefixedName(CONCAT("told:_IncarnationLineage_", ?Incarnation_Lineage_TOL_ID)) AS ?incarnation_lineage_iri)

    BIND(tarql:expandPrefixedName(CONCAT("told:_IncarnationLineage_", ?Previous_Incarnation_Lineage_TOL_ID)) AS ?parent_lineage_iri)

    BIND(tarql:expandPrefixedName(CONCAT("told:_Incarnation_", ?Incarnation_Lineage_TOL_ID, "_", ?Person_TOL_ID)) AS ?incarnation_iri)

    BIND(tarql:expandPrefixedName(CONCAT("told:_Person_", ?Person_TOL_ID)) AS ?person_iri)

    BIND(STRLANG(CONCAT("Lineage ", ?Incarnation_Lineage_TOL_ID, " Person ", ?Person_TOL_ID), "en") AS ?pref_label_en)

    BIND(STRDT(?Ordinal, xsd:integer) AS ?ordinal_int)
    BIND(STRDT(?Incarnation_Sequence, xsd:integer) AS ?sequence_int)

    BIND(IF(?sequence_int = 1, gist:isFirstMemberOf, gist:isMemberOf) AS ?member_predicate_iri)

    # Previous incarnation
    # Belongs to same lineage unless a value is noted
    BIND(COALESCE(?Previous_Incarnation_Lineage_TOL_ID, ?Incarnation_Lineage_TOL_ID) AS ?lineage_of_previous_incarnation)
    BIND(IF(BOUND(?Previous_Incarnation_Person_TOL_ID), tarql:expandPrefixedName(CONCAT("told:_Incarnation_", ?lineage_of_previous_incarnation, "_", ?Previous_Incarnation_Person_TOL_ID)), ?unbound) AS ?previous_incarnation_iri)

    BIND(
        COALESCE(
            IF(BOUND(?previous_incarnation_iri) && ?Immediately_Preceding_Incarnation_Unknown = "yes", gist:precedes, ?unbound),
            IF(BOUND(?Previous_Incarnation_Person_TOL_ID), gist:precedesDirectly, ?unbound)
        )
    AS ?precedes_predicate_iri)

}
