PREFIX bdo: <http://purl.bdrc.io/ontology/core/>
PREFIX bdr: <http://purl.bdrc.io/resource/>
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX gist: <https://w3id.org/semanticarts/ns/ontology/gist/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX told: <https://w3id.org/treasuryoflives/ns/data/tol/>
PREFIX tolo: <https://w3id.org/treasuryoflives/ns/ontology/tol/>
PREFIX tolx: <https://w3id.org/treasuryoflives/ns/taxonomy/tol/>
PREFIX xml: <http://www.w3.org/XML/1998/namespace>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX wiki: <https://www.wikidata.org/wiki/>
PREFIX media-txt: <https://www.iana.org/assignments/media-types/text/>
PREFIX media-image: <https://www.iana.org/assignments/media-types/image/>

## COLUMNS
# sponsor_id
# sponsor_name
# sponsor_url
# sponsor_description
# image_file_name (ignore)
# image_path
# person_id (semicolon-delimited list)

# Run:
# tarql -e utf-8 --dedup 1000 sponsors.tq bio-sponsor-1-9-25.csv > tolSponsors.ttl


CONSTRUCT {

  ?sponsor_iri
    a tolo:Sponsor ;
    gist:name ?sponsor_name_en ;
    skos:prefLabel ?sponsor_name_en ;
    tolo:hasPrimaryDisplayImage ?image_file_iri ;
    gist:hasAddress ?sponsor_url_iri ;
    .

  ?bio_iri tolo:isSponsoredBy ?sponsor_iri .

  ?sponsor_description_iri
    a gist:FormattedContent ;
    gist:containedText ?sponsor_description_en ;
    gist:isAbout ?sponsor_iri ;
    gist:isExpressedIn media-txt:html ;
    .

  ?image_file_iri
    a tolo:Image ;
    skos:prefLabel ?sponsor_name_en ;
    tolo:filePath ?image_file_name ;
    gist:isExpressedIn ?media_type_iri ;
    .

  ?sponsor_url_iri
    a gist:ElectronicAddress ;
    gist:isCategorizedBy tolx:_ElectronicAddressType_url ;
    tolo:url ?url ;
    .

}

WHERE {

  # Testing
  # FILTER(?ROWNUM = 1)

  FILTER(BOUND(?sponsor_url) || BOUND(?sponsor_description) || BOUND(?image_path) || BOUND(?person_id))

  BIND(REPLACE(REPLACE(?sponsor_name, "&", "and"), "\\W+", "_") AS ?sponsor_local_name)
  BIND(tarql:expandPrefixedName(CONCAT("told:_Organization_", ?sponsor_local_name)) AS ?sponsor_iri)
  BIND(STRLANG(?sponsor_name, "en") AS ?sponsor_name_en)

  # Sponsor description
  BIND(tarql:expandPrefixedName(CONCAT("told:_FormattedContent_Sponsor_", ?sponsor_local_name)) AS ?sponsor_description_iri)
  BIND(STRLANG(?sponsor_description, "en") AS ?sponsor_description_en)

  # Sponsored biographies
  # Note: not all sponsors are linked to individual biographies.
  OPTIONAL { ?bio_id apf:strSplit(?person_id ";") }
  BIND(tarql:expandPrefixedName(CONCAT("told:_Biography_", ?bio_id)) AS ?bio_iri)

  # Sponsor image
  BIND(LCASE(REPLACE(REPLACE(REPLACE(?image_path, "^/", ""), "['()]", ""), "\\W", "_")) AS ?file_path)
  BIND(tarql:expandPrefixedName(CONCAT("told:_Image_", ?file_path)) AS ?image_file_iri)

  BIND(LCASE(REPLACE(?file_path, "^.+\\.", "")) AS ?image_file_ext)
  BIND(
    COALESCE(
      IF(?image_file_ext IN ("jpg", "jpeg"), media-image:jpg, ?unbound),
      IF(?image_file_ext = "png", media-image:png, ?unbound)
    ) AS ?media_type_iri
  )

  # Sponsor website
  BIND(REPLACE(REPLACE(?sponsor_url, "[^a-zA-Z0-9]", "_"), "_$", "") AS ?sponsor_url_iri_safe)
  BIND(tarql:expandPrefixedName(CONCAT("told:_ElectronicAddress_", ?sponsor_url_iri_safe)) AS ?sponsor_url_iri)
  BIND(STRDT(?sponsor_url, xsd:anyURI) AS ?url)

}
