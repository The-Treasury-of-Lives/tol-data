told:_FormattedContent_Biography_Summary_13139
	gist:containedText
		'''<p class="p1">
	ཨ་གཡུ་མཁའ་འགྲོ་ནི་འཇམ་དབྱངས་མཁྱེན་བརྩེ་ཆོས་ཀྱི་དབང་པོ་དང་།<span class="s1"> </span>འཇམ་མགོན་ཀོང་སྤྲུལ།<span class="s1"> </span>མཆོག་གྱུར་གླིང་པ།<span class="s1"> </span>ཨ་འཛོམ་འབྲུག་པ་སོགས་སྐྱེས་ཆེན་དམ་པ་མང་པོའི་<span class="s2">ཞབས་ལ་གཏུགས་མྱོང་བའི་རྣལ་འབྱོར་མ་ཞིག་</span>ཡིན།<span class="s1"> </span>ཁོང་གི་སྐུ་ཚེ་ཕལ་<span class="s3">ཆེར་</span>བོད་ཡུལ་དབུས་དང་ཁམས་ཕྱོགས་སུ་གཅོད་ཉམས<span class="s4">་སུ་</span>ལེན་པའི་ཚུལ་དུ་<span class="s2">བཞུགས་ཤིང་</span>།<span class="s1"> </span>རྫོགས་ཆེན་མུན་མཚམས་ལ་ཡང་ལོ་ལྔ་བཅུ་ཙམ་<span class="s5">བཞུགས་པའི་གྲགས་པ་ཆེ།</span><span class="s1"> </span><span class="s3">ཁོང་གི་སློབ་མ་གཙོ་བོའི་གྲས་སུ་ཆོས་རྒྱལ་ནམ་མཁའི་ནོར་བུ་ཡང་ཡོད་དོ།།</span></p>'''@tibetan ,
		"""<p>
	阿玉康卓是一位女瑜伽士。她曾在当时享誉盛名的教师如蒋扬钦哲旺波、蒋贡康楚、秋吉林巴和阿宗朱巴等坐下学习。她一生的大部分时间都以施身法行者的身份云游于卫藏和康区。她因完成近五十年的大圆满黑暗闭关而闻名。她的主要弟子中包括南喀罗布。</p>"""@chinese
		;
	.

told:_FormattedContent_Biography_Summary_13141
	gist:containedText '''<p>
	<style type="text/css">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 14.0px Kailasa}
span.s1 {font-kerning: none}
span.s2 {font: 14.0px Calibri; font-kerning: none}	</style>
</p>
<p class="p1">
	<span class="s1">སངས་རྒྱས་དབོན་གྲགས་པ་དཔལ་</span><span class="s1">ནི་ཕྱི་ལོ་༡༢༧༦</span><span class="s2"> </span><span class="s1">ལོར་རི་བོ་ཆེ་དགོན་པ་</span><span class="s1">ཕྱག་འདེབས་མཁན་གྱི་བླ་མ་ཡིན།</span><span class="s2"> </span><span class="s1">ཕྱི་ལོ་༡༢༩༦</span><span class="s2"> </span><span class="s1">བར་དགོན་པའི་མཁན་རབས་དང་པོ་མཛད།</span><span class="s2"> </span><span class="s1">ཁོང་སངས་རྒྱས་ཡར་བྱོན་</span><span class="s1">གྱི་སློབ་མ་ཡིན་ཞིང་།</span><span class="s2"> </span><span class="s1">ཕྱི་ལོ་༡༢༧༢</span><span class="s2"> </span><span class="s1">ནས་བཟུང་ཕྱི་ལོ་༡༢༧༣</span><span class="s2"> </span><span class="s1">ལོར་ཁོང་གི་སྐུ་ཚ་བཀྲ་ཤིས་བླ་མས་</span><span class="s1">ཁོང་སྟག་ལུང་དགོན་པ་</span><span class="s1">ནས་བཙན་འབུད་མ་བྱས་ཀྱི་བར་དགོན་པའི་མཁན་པོ་ཡུན་ཙམ་གནང་།</span><span class="s2"> </span><span class="s1">སངས་རྒྱས་དབོན་གྲགས་པ་དཔལ་ནི་སྒམ་པོ་པ་རིན་ཆེན་དཔལ་</span><span class="s1">གྱི་སྐུ་སྐྱེ་ཡིན་པར་བཤད།</span></p>'''@tibetan ;
	.

told:_FormattedContent_Biography_Summary_13142
	gist:containedText '''<p>
	<style type="text/css">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 14.0px Kailasa}
