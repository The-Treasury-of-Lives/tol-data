told:_FormattedContent_Biography_Summary_3906
	gist:containedText """<p>
	<style type=\"text/css\">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 14.0px Kokonor}
span.s1 {font-kerning: none}
span.s2 {font: 14.0px 'Times New Roman'; font-kerning: none}	</style>
</p>
<p class=\"p1\">
	<span class=\"s1\">བཅུ་གཉིས་པ་རྡོ་རྗེ་རིན་ཆེན་ནི་འབྲི་གུང་གདན་རབས་དགུ་པ་ཡིན་ལ།</span><span class=\"s2\"> </span><span class=\"s1\">སྤྱི་ལོ</span><span class=\"s2\"> </span><span class=\"s1\">༡༢༨༧</span><span class=\"s2\"> </span><span class=\"s1\">ལོ་ནས</span><span class=\"s2\"> </span><span class=\"s1\">༡༣༡༤</span><span class=\"s2\"> </span><span class=\"s1\">ལོའི་བར་དུ་གདན་ས་བསྐྱངས།</span><span class=\"s2\"> </span><span class=\"s1\">སྤྱི་ལོ</span><span class=\"s2\"> </span><span class=\"s1\">༡༢༩༠</span><span class=\"s2\"> </span><span class=\"s1\">ལོར་ས་སྐྱ་དང་སོག་པོའི་དམག་དཔུང་གིས་འབྲི་གུང་དགོན་པ་བཅོམ་རྗེས།</span><span class=\"s2\"> </span><span class=\"s1\">ཁོང་གིས་གཟིགས་རྟོག་བྱས་ཏེ་དགོན་པ་བསྐྱར་བཞེངས་མཛད་པ་རེད།</span></p>"""@tibetan ;
	.

told:_FormattedContent_Biography_Summary_3907
	gist:containedText """<p>
	<style type=\"text/css\">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 14.0px Kokonor}
span.s1 {font-kerning: none}
span.s2 {font: 14.0px 'Times New Roman'; font-kerning: none}	</style>
</p>
<p class=\"p1\">
	<span class=\"s1\">ཉེར་བརྒྱད་པ་རྡོ་རྗེ་རྒྱལ་པོ་ནི་འབྲི་གུང་གདན་རབས་བཅུ་པ་ཡིན་ལ།</span><span class=\"s2\"> </span><span class=\"s1\">སྤྱི་ལོ</span><span class=\"s2\"> </span><span class=\"s1\">༡༣༡༤</span><span class=\"s2\"> </span><span class=\"s1\">ལོ་ནས</span><span class=\"s2\"> </span><span class=\"s1\">༡༣༥༠</span><span class=\"s2\"> </span><span class=\"s1\">ལོའི་བར་གདན་ས་བསྐྱངས།</span><span class=\"s2\"> </span><span class=\"s1\">ཁོང་ཉིད་སློབ་དཔོན་པདྨ་འབྱུང་གནས་ཀྱི་རྣམ་སྤྲུལ་ཡིན་པར་བཤད་སྲོལ་ཡོད་པ་རེད།</span></p>"""@tibetan ;
	.

told:_FormattedContent_Biography_Summary_3936
	gist:containedText '''<p>
	<style type="text/css">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 12.0px Kailasa}
span.s1 {font-kerning: none}
span.s2 {font: 12.0px Arial; font-kerning: none}	</style>
</p>
<p class="p1">
	<span class="s1">འབྲི་གུང་ལོ་ཙཱ་བ་མ་ཎིཀ་ཤྲཱི་ཛྙཱ</span><span class="s2"> </span><span class="s1">ན་</span><span class="s1">ནི་རྗེ་དོལ་པོ་</span><span class="s2"> </span><span class="s1">པ་</span><span class="s1">ཆོས་རྗེ་ཡབ་སྲས་བཅུ་</span><span class="s2"> </span><span class="s1">བཞིའི་ཡ་གྱལ་ཡིན་ཞིང་།</span><span class="s2"> </span><span class="s1">རྒྱ་གར་སཾསྐྲྀཏ་ཡི་བརྡ་སྤྲོད་རི</span><span class="s2"> </span><span class="s1">ག་གནས་སོགས་ལ་མཁས་པར་གྲགས།</span><span class="s2"> </span><span class="s1">སྐུ་དར་མའི་དུས་ནས་བཀའ་བརྒྱུད་</span><span class="s2"> </span><span class="s1">འབྲི་གུང་དགོན་</span><span class="s1">གྱི་གདན་ས་མཛད།</span><span class="s2"> </span><span class="s1">དོལ་པོ་པའི་དྲུང་ནས་ཆོས་གསན་པའི</span><span class="s2"> </span><span class="s1">་རྗེས་སུ་འབྲི་གུང་ལོ་ཙཱ་བས་</span><span class="s2"> </span><span class="s1">གཞན་སྟོང་གི་ལྟ་བ་གཅེས་པར་བསྲུ</span><span class="s2"> </span><span class="s1">ངས།</span><span class="s2"> </span><span class="s1">ཇོ་ནང་ལུགས་ཀྱི་དུས་འཁོར་དང་འབྲེ</span><span class="s2"> </span><span class="s1">ལ་བའི་ཆོས་རྒྱ་ཆེར་སྤེལ།</span><span class="s2"> </span><span class="s1">སྐུ་ཚེ་སྨད་ལ་ཇོ་ནང་དགོན་</span><span class="s1">དུ་ལོ་བརྒྱད་ཙམ་འགྲེ</span><span class="s2"> </span><span class="s1">ལ་ཆེན་དྲི་མེད་འོད་འཆད་ཁྲིད་བསྐྱ</span><span class="s2"> </span><span class="s1">ངས་ཏེ་འགྲོ་དོན་མཛད།</span><span class="s2">&nbsp;</span></p>'''@tibetan ;
	.

told:_FormattedContent_Biography_Summary_3938
	gist:containedText """<p>
	<style type=\"text/css\">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 14.0px Kailasa}
span.s1 {font: 14.0px 'Times New Roman'}	</style>
</p>
<p class=\"p1\">
	ཐང་པོ་ཆེ་ཀུན་དགའ་འབུམ་ནི་དོལ་པོ་པའི་བུ་སློབ་ཐུ་བོ་བཅུ་བཞི་གྲས་ཀྱི་ཡ་གྱལ་ཞིག་ཡིན་ལ།<span class=\"s1\"> </span>ཐོག་མར་ས་སྐྱའི་ལུགས་ལ་ཐོས་བསམ་མཛད།<span class=\"s1\"> </span>དོལ་པོ་པས་མཛད་པའི་བསྟན་པ་སྤྱི་འབྲེལ་ཡིད་ཀྱི་མུན་སེལ་མཇལ་བས།<span class=\"s1\"> </span>དད་པ་འཁྲུངས་ནས་ཐོག་མར་མཇལ།<span class=\"s1\"> </span>ཁོང་གིས་དོལ་པོ་པ་ལས་ཐོས་བསམ་རྒྱ་ཆེར་མཛད་ཅིང་།<span class=\"s1\"> </span>གསོ་རིག་ལག་ལེན་ལའང་ཉམས་མྱོང་ཐུན་མོང་མ་ཡིན་པ་འཐོབ།<span class=\"s1\"> </span>ཁོང་ནི་དུས་འཁོར་དང་དུས་འཁོར་འགྲེལ་ཆེན་དྲི་མེད་འོད་རྒྱན་གྱི་འཆད་ཉན་སྤེལ་བ་ལ་ཤིན་ཏུ་མཁས་པར་གྱུར།</p>"""@tibetan ;
	.

told:_FormattedContent_Biography_Summary_3939
	gist:containedText '''<p>
	<style type="text/css">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 12.0px Kailasa}
span.s1 {font-kerning: none}
span.s2 {font: 12.0px Arial; font-kerning: none}	</style>
</p>
<p class="p1">
	<span class="s1">སྨན་ཆུ་ཁ་བ་བློ་གྲོས་རྒྱལ་མཚན་</span><span class="s1">ནི་རྗེ་དོལ་པོ་པ་</span><span class="s1">ཆོས་རྗེ་ཡབ་སྲས་བཅུ་བཞི</span><span class="s2"> </span><span class="s1">འི་ཡ་གྱལ་ཡིན།</span><span class="s2"> </span><span class="s1">སྐུ་གཞོན་ནུའི་དུས་སུ་ས་སྐྱ་དགོ</span><span class="s2"> </span><span class="s1">ན་པར་</span><span class="s1">སློབ་གཉེར་གནང་།</span><span class="s2"> </span><span class="s1">སྐབས་དེར་སྨན་ཆུ་རི་ཁྲོད་</span><span class="s1">ཉིད་ཀྱི་བཞུགས་གནས་</span><span class="s2"> </span><span class="s1">གཙོ་བོར་མཛད།</span><span class="s2"> </span><span class="s1">སྐུ་ཚེ་སྨད་ལ་དབུས་གཙང་དུ་བཞུ</span><span class="s2"> </span><span class="s1">གས་ནས་ཇོ་ནང་པའི་ལྟ་གྲུབ་དང་།</span><span class="s2"> </span><span class="s1">དཔལ་དུས་ཀྱི་འཁོར་ལོའི་གདམས་པ་</span><span class="s2"> </span><span class="s1">རྣམས་རྒྱ་ཆེར་སྤེལ།</span></p>'''@tibetan ;
	.

told:_FormattedContent_Biography_Summary_3940
	gist:containedText '''<p>
	<style type="text/css">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 12.0px Kailasa}
span.s1 {font-kerning: none}
span.s2 {font: 12.0px Arial; font-kerning: none}	</style>
</p>
<p class="p1">
	<span class="s1">རིན་ཆེན་ཚུལ་ཁྲིམས་</span><span class="s1">ནི་རྗེ་དོལ་པོ་པ་</span><span class="s1">ཆོས་རྗེ་ཡབ་སྲས་བཅུ་བཞི</span><span class="s2"> </span><span class="s1">འི་ཡ་གྱལ་ཡིན།</span><span class="s2"> </span><span class="s1">སྐུ་གཞོན་ནུའི་དུས་སུ་བོད་དབུས་</span><span class="s2"> </span><span class="s1">ཀྱི་བཀའ་བརྒྱུད་པའི་མཚུར་ཕུ་དགོ</span><span class="s2"> </span><span class="s1">ན་པ་</span><span class="s1">དང་།</span><span class="s2"> </span><span class="s1">གཙང་གི་ས་སྐྱ་དགོན་པ་</span><span class="s1">བཅས་སུ་སློབ་གཉེར་</span><span class="s2"> </span><span class="s1">གནང་།</span><span class="s2"> </span><span class="s1">དོལ་པོ་པ་དང་།</span><span class="s2"> </span><span class="s1">རྗེ་དེའི་སློབ་མ་གཙོ་བོ་རྣམས་ཀྱི</span><span class="s2"> </span><span class="s1">་དྲུང་ནས་དཔལ་དུས་ཀྱི་འཁོར་ལོ་</span><span class="s2"> </span><span class="s1">སོགས་ཆོས་མཐའ་ཡས་པ་གསན།</span><span class="s2"> </span><span class="s1">རྗེས་སུ་བོད་དབུས་གཙང་ཁུལ་དུ་</span><span class="s2"> </span><span class="s1">བཞུགས་ཏེ་དཔལ་དུས་ཀྱི་འཁོར་ལོའི</span><span class="s2"> </span><span class="s1">་ཉམས་ལེན་དང་གདམས་པ་རྣམས་རྒྱ་ཆེ</span><span class="s2"> </span><span class="s1">ར་སྤེལ།</span><span class="s2">&nbsp;</span></p>'''@tibetan ;
	.

told:_FormattedContent_Biography_Summary_3977
	gist:containedText """<p>
	<style type=\"text/css\">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 12.0px Kailasa}
span.s1 {font: 12.0px 'Times New Roman'}	</style>
</p>
<p class=\"p1\">
	སྒིས་སྟེང་བློ་བཟང་དཔལ་ལྡན་ནི་སྒིས་སྟེང་དགོན་གདན་སར་མཛད་པའི་དགེ་ལུགས་པའི་བླ་མ་གྲགས་ཆེན་ཞིག་ཡིན་ལ།<span class=\"s1\"> </span>རོང་བོ་དགོན་དང་ལྡི་ཚ་དགོན་དུ་ཐོས་བསམ་མཛད་ཅིང་།<span class=\"s1\"> </span>རོང་བོ་གྲུབ་ཆེན་སྐུ་ཕྲེང་བདུན་པས་གཙོས་པའི་མཁས་ཆེན་དུ་མ་བསྐྱངས་པར་མཛད།<span class=\"s1\"> </span>ཁོང་གིས་མཛད་པའི་སྙན་ངག་ནི་ཤིན་ཏུ་གྲགས་ཆེ་ཞིང་།<span class=\"s1\"> </span>དེང་གི་བོད་ཀྱི་སློབ་ཆེན་རྣམས་སུའང་དེ་ལ་སློབ་གཉེར་བྱེད་པ་རེད།</p>"""@tibetan ;
	.

told:_FormattedContent_Biography_Summary_4000
	gist:containedText """<p>
	<style type=\"text/css\">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 12.0px Kailasa}
span.s1 {font: 12.0px 'Times New Roman'}	</style>
</p>
<p class=\"p1\">
	སྟག་ཕུ་སྐུ་ཕྲེང་གསུམ་པ་པདྨ་བཛྲ་འཇམ་དཔལ་བསྟན་པའི་དངོས་གྲུབ་ལ་ཀུན་གྱིས་སྟག་ཕུ་རྡོ་རྗེ་འཆང་ཞེས་འབོད་ལ།<span class=\"s1\"> </span>དགེ་ལུགས་པའི་རྣལ་འབྱོར་པ་ཞིག་དང་ཕ་བོང་ཁ་བདེ་ཆེན་སྙིང་པོའི་དགེ་རྒན་ཡིན།<span class=\"s1\"> </span>སྐུ་འཚོ་མུས་ཀྱི་དུས་དུ་ཁམས་དང་དབུས་གཙང་བར་དུ་ཐེངས་མང་པོ་ཕེབས་བཞུད་མཛད།<span class=\"s1\"> </span>རྣམ་འབྱོར་ལ་བརྟེན་ནས་དག་སྣང་སྐྱེས་ཤིང་དགའ་ལྡན་གྱི་གནས་ལ་བགྲོད་ཐུབ་པར་གསུང་།<span class=\"s1\"> </span>དགའ་ལྡན་གྱི་གནས་སུ་ཕེབས་ཏེ་རྡོ་རྗེ་ཤུགས་ལྡན་དང་འབྲེལ་བའི་ཆོས་སྐོར་མང་དུ་ཐོབ།<span class=\"s1\"> </span>ཁོང་ནི་སྒྲོལ་མ་ཡིད་བཞིན་ནོར་བུའི་རྗེས་གནང་གི་ཁོངས་གཏུགས་ས་ཞིག་ཡིན་ལ།<span class=\"s1\"> </span>དེ་ཡང་ཕལ་ཆེར་དག་སྣང་ལས་བྱུང་བར་སྣང་།</p>"""@tibetan ;
	.

told:_FormattedContent_Biography_Summary_4002
	gist:containedText '''<p>
	<style type="text/css">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 12.0px Kailasa}
span.s1 {font-kerning: none}
span.s2 {font: 12.0px Calibri; font-kerning: none}	</style>
</p>
<p class="p1">
	<span class="s1">རྗེ་དྲུང་སྔགས་རམས་པ་དགེ་འདུན་བཀྲ་ཤིས་</span><span class="s1">ནི་ཆབ་མདོ་བྱམས་པ་གླིང་དགོན་</span><span class="s1">པའི་མཁན་རབས་བརྒྱད་པ་ཡིན།</span><span class="s2"> </span><span class="s1">ཁོང་ཕྱི་ལོ་༡༤༨༦</span><span class="s2"> </span><span class="s1">ལོར་དབུས་གཙང་དུ་འཁྲུངས།</span><span class="s2"> </span><span class="s1">༸རྒྱལ་མཆོག་སྐུ་ཕྲེང་གཉིས་པ་</span><span class="s1">གཙོས་པའི་བླ་མ་སོ་བདུན་ཙམ་བསྟེན་ནས་གསན་བསམ་མཐར་ཕྱིན་པར་མཛད།</span><span class="s2"> </span><span class="s1">རྗེས་སུ་༸རྒྱལ་མཆོག་སྐུ་ཕྲེང་གསུམ་པའི་</span><span class="s1">གསང་སྔགས་ཀྱི་ཡོངས་འཛིན་གནང་།</span><span class="s2">&nbsp;&nbsp;</span></p>'''@tibetan ;
	.

told:_FormattedContent_Biography_Summary_4028
	gist:containedText """<p>
	<style type=\"text/css\">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 12.0px Kailasa}
span.s1 {font: 12.0px 'Times New Roman'}	</style>
</p>
<p class=\"p1\">
	ཀཿཐོག་པ་ཡེ་ཤེས་རྒྱལ་མཚན་ནི་ཀཿཐོག་དགོན་གྱི་གདན་རབས་བཅོ་ལྔ་པ་ཡིན་ལ།<span class=\"s1\"> </span>རྙིང་མའི་མཁས་ཆེན་དམ་པ་ཞིག་ཡིན།<span class=\"s1\"> </span>ཁོང་ནི་ཀཿཐོག་པ་བྱང་ཆུབ་རྒྱལ་མཚན་གྱི་བུ་སློབ་ཅིག་ཡིན་པ་དང་།<span class=\"s1\"> </span>དགོན་དེ་ཉིད་ཕྱག་འདེབས་མཁན་དམ་པ་བདེ་གཤེགས་ཀྱི་རྣམ་སྤྲུལ་ཡིན་པར་བཤད།<span class=\"s1\"> </span>ཁོང་ནི་རིག་པའི་གནས་མཐའ་དག་ལ་ནང་བྱན་ཆུབ་ཡོད་པས།<span class=\"s1\"> </span>ཀཿཐོག་ལ་ཆོས་སྐོར་གསར་པ་མང་པོ་སྤེལ་བར་མཛད་ཅིང་།<span class=\"s1\"> </span>ཕྱིས་སུ་ཟུར་བཞུགས་མཛད་དེ་བུ་འབོར་ཕག་མཚོ་རི་ཁྲོད་དུ་བཞུགས།</p>"""@tibetan ;
	.

told:_FormattedContent_Biography_Summary_4043
	gist:containedText """<p>
	<style type=\"text/css\">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 14.0px Kailasa}
span.s1 {font: 14.0px 'Times New Roman'}	</style>
</p>
<p class=\"p1\">
	ཀུ་མཱ་རཱ་ཛ་ནི་རྫོགས་ཆེན་སྙིང་ཐིག་གི་ཆོས་རྒྱུད་འཛིན་མཁན་གྱི་བླ་མ་ཞིག་ཡིན་ལ།<span class=\"s1\"> </span>ཁོང་ནི་མེ་ལོང་རྡོ་རྗེ་དང་ཀློང་ཆེན་པ་གཉིས་ཀྱི་བུ་སློབ་ཡིན།</p>"""@tibetan ;
	.

told:_FormattedContent_Biography_Summary_4077
	gist:containedText '''<p>
	<style type="text/css">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 14.0px Kailasa}
span.s1 {font-kerning: none}
span.s2 {font: 14.0px Calibri; font-kerning: none}	</style>
</p>
<p class="p1">
	<span class="s1">ཆེ་ཤོས་སྐུ་ཕྲེང་གསུམ་པ་བློ་བཟང་བྱང་ཆུབ་བསྟན་པའི་སྒྲོན་མེ་</span><span class="s1">ནི་སྐུ་འབུམ་དགོན་པའི་</span><span class="s1">ཁྲི་རབས་དོན་གཅིག་པ་ཡིན།</span><span class="s2"> </span><span class="s1">གཙོ་བོར་དབུས་གཙང་དང་ཨ་མདོ་གཉིས་སུ་གསན་བསམ་སློབ་གཉེར་གནང་།</span></p>'''@tibetan ;
	.

told:_FormattedContent_Biography_Summary_4085
	gist:containedText """<p>
	<style type=\"text/css\">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 12.0px Kailasa}
span.s1 {font: 12.0px 'Times New Roman'}	</style>
</p>
<p class=\"p1\">
	ཀུན་དགའ་གྲོལ་མཆོག་གིས་ས་སྐྱ་དང་།<span class=\"s1\"> </span>ཤངས་པ།<span class=\"s1\"> </span>ཇོ་ནང་བཅས་ཀྱི་གཙོས་པའི་གྲུབ་མཐའ་མང་པོར་ཐོས་བསམ་སྒོམ་གསུམ་མཛད་ཅིང་འཆད་ཉན་སྤེལ།<span class=\"s1\"> </span>ཁོང་གིས་གྲུབ་མཐའ་རིས་མེད་ལ་ཐོས་བསམ་སྒོམ་གསུམ་མཛད་ལུགས་དང་གསུང་རྩོམ་དག་ནི་འཇམ་མགོན་ཀོང་སྤྲུལ་གྱི་མིག་དཔེ་རུ་གྱུར་པར་བཤད།</p>"""@tibetan ;
	.

told:_FormattedContent_Biography_Summary_4092
	gist:containedText
		'''<p>
	<style type="text/css">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 12.0px Kailasa; color: #000000}	</style>
</p>
<p class="p1">
	དམ་ཆོས་དཔལ་བ་ནི་དགའ་ལྡན་ཁྲི་ཐོག་སོ་གཅིག་པ་ཡིན་ཞིང་། ཕྱི་ལོ་༡༦༡༨ ནས་༡༦༢༠ བར་ཁྲི་པ་མཛད། སློབ་གཉེར་ཕལ་ཆེ་བ་འབྲས་སྤུངས་དགོན་པར་གནང་སྟེ་རྗེས་སུ་དེར་འཆད་ཉན་སློབ་དཔོན་མཛད། དེ་བཞིན་དགའ་ལྡན་ཤར་རྩེ་གྲྭ་ཚང་དུའང་སློབ་དཔོན་གྱི་མཛད་ཁུར་བཞེས།</p>'''@tibetan ,
		"""<p>
	党曲巴瓦于1618-1620年任第三十一任甘丹赤巴。他主要在哲蚌寺修学，后担任哲蚌寺的导师，同时也担任甘丹绛孜学院的导师。</p>"""@chinese
		;
	.

told:_FormattedContent_Biography_Summary_4113
	gist:containedText '''<p>
	<style type="text/css">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 12.0px Kailasa}
span.s1 {font-kerning: none}
span.s2 {font: 12.0px Arial; font-kerning: none}	</style>
</p>
<p class="p1">
	<span class="s1">ཐང་པོ་ཆུང་བ་བློ་གྲོས་དཔལ་</span><span class="s1">ནི་རྗེ་དོལ་པོ་པ་</span><span class="s1">ཆོས་རྗེ་ཡབ་སྲས་བཅུ་བཞིའི་ཡ་གྱ</span><span class="s2"> </span><span class="s1">ལ་ཡིན།</span><span class="s2"> </span><span class="s1">ས་སྐྱ་དགོན་པ་</span><span class="s1">སོགས་དབུས་གཙང་ཁུལ་གྱི</span><span class="s2"> </span><span class="s1">་དགོན་སྡེ་ཁག་ཏུ་སློབ་གཉེར་མཛད།</span><span class="s2"> </span><span class="s1">དོལ་པའི་དྲུང་ནས་དཔལ་དུས་ཀྱི་</span><span class="s2"> </span><span class="s1">འཁོར་ལོའི་དབང་དང་གདམས་པ་ཐོག་</span><span class="s2"> </span><span class="s1">མར་ཞུས་པའི་སྐབས་ཁོང་ཕྱི་ལོ་བརྒྱ</span><span class="s2"> </span><span class="s1">་ཕྲག་བཅུ་གཅིག་པའི་རྣལ་འབྱོར་པ་</span><span class="s2"> </span><span class="s1">ཡུ་མོ་མི་བསྐྱོད་རྡོ་རྗེའི་</span><span class="s1">སྐུ་སྐྱེར་ངོས་འཛིན་གནང་</span><span class="s2"> </span><span class="s1">།</span><span class="s2"> </span><span class="s1">དོལ་པོ་པའི་སློབ་མ་རྣམས་ཀྱི་ས་</span><span class="s2"> </span><span class="s1">ནས་ཀྱང་ཆོས་མང་དུ་གསན།</span><span class="s2"> </span><span class="s1">སྐུ་ཚེ་སྨད་ལ་བོད་དབུས་ཀྱི་སྟོ</span><span class="s2"> </span><span class="s1">ད་ལུང་དུ་བཞུགས་ཏེ་དཔལ་དུས་ཀྱི་</span><span class="s2"> </span><span class="s1">འཁོར་ལོའི་རྒྱུད་དང་།</span><span class="s2"> </span><span class="s1">འགྲེལ་ཆེན་དྲི་མེད་འོད་སོགས་</span><span class="s2"> </span><span class="s1">འཆད་སྤེལ་རྒྱ་ཆེར་མཛད།</span></p>'''@tibetan ;
	.

told:_FormattedContent_Biography_Summary_4114
	gist:containedText '''<p>
	<style type="text/css">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 12.0px Kailasa}
span.s1 {font-kerning: none}
span.s2 {font: 12.0px Arial; font-kerning: none}	</style>
</p>
<p class="p1">
	<span class="s1">ཕུན་ཚོགས་དཔལ་བཟང་</span><span class="s1">ནི་རྗེ་དོལ་པོ་པ་</span><span class="s1">ཆོས་རྗེ་ཡབ་སྲས་བཅུ་བཞི</span><span class="s2"> </span><span class="s1">འི་ཡ་གྱལ་ཡིན།</span><span class="s2"> </span><span class="s1">དང་ཐོག་བཀའ་བརྒྱུད་པའི་ལུགས་ལ་</span><span class="s2"> </span><span class="s1">གསན་བསམ་དཔྱིས་ཕྱིན་མཛད།</span><span class="s2"> </span><span class="s1">དོལ་པོ་པས་མཛད་པའི་ངེས་དོན་རྒྱ་</span><span class="s2"> </span><span class="s1">མཚོ་གཟིགས་པའི་རྗེས་སུ་ཁོང་གི་</span><span class="s2"> </span><span class="s1">སར་ཕེབས་ཏེ་ཐུན་མིན་གྱི་ཆོས་མང་</span><span class="s2"> </span><span class="s1">དུ་གསན།</span><span class="s2"> </span><span class="s1">དེ་ནས་བོད་དབུས་གསང་ཕུ་ནེའུ་ཐོ</span><span class="s2"> </span><span class="s1">ག་དགོན་</span><span class="s1">དང་།</span><span class="s2"> </span><span class="s1">ཀ་ལ་པ་རི་ཁྲོད་</span><span class="s1">སོགས་སུ་བཞུགས་ནས་ཆོ</span><span class="s2"> </span><span class="s1">ས་མང་དུ་གསུངས།</span><span class="s2"> </span><span class="s1">སྐུ་ཚེའི་དུས་ཡུན་ཕལ་ཆེ་བར་དཔལ་</span><span class="s2"> </span><span class="s1">དུས་ཀྱི་འཁོར་ལོ་དང་།</span><span class="s2"> </span><span class="s1">རྣལ་འབྱོར་སྦྱོར་བ་ཡན་ལག་དྲུག་</span><span class="s2"> </span><span class="s1">གི་ཉམས་ལེན་མཛད།</span></p>'''@tibetan ;
	.

told:_FormattedContent_Biography_Summary_4115
	gist:containedText '''<p>
	<style type="text/css">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 12.0px Kailasa}
span.s1 {font-kerning: none}
span.s2 {font: 12.0px Arial; font-kerning: none}	</style>
</p>
<p class="p1">
	<span class="s1">གྷ་རུང་བ་ལྷའི་རྒྱལ་མཚན་</span><span class="s1">ནི་རྗེ་དོལ་པོ་པ་</span><span class="s1">ཆོས་རྗེ་ཡབ་སྲས་བཅུ་བཞི</span><span class="s2"> </span><span class="s1">འི་ཡ་གྱལ་ཡིན།</span><span class="s2"> </span><span class="s1">དོལ་པོ་པ་དང་མ་མཇལ་བའི་གོང་དུ་</span><span class="s2"> </span><span class="s1">ས་སྐྱ་དང་བཀའ་བརྒྱུད་པའི་དགོན་</span><span class="s2"> </span><span class="s1">པ་ཁག་ཏུ་སློབ་གཉེར་མཛད།</span><span class="s2"> </span><span class="s1">དོལ་པོ་པའི་དྲུང་ནས་ཟབ་ལམ་རྡོ་</span><span class="s2"> </span><span class="s1">རྗེའི་རྣལ་འབྱོར་སྦྱོར་བ་ཡན་ལག་</span><span class="s2"> </span><span class="s1">དྲུག་གི་ཆོས་གསན་ནས་ཉམས་རྟོགས་</span><span class="s2"> </span><span class="s1">ཁྱད་པར་ཅན་འཁྲུངས་པར་བཤད།</span><span class="s2"> </span><span class="s1">དེ་བཞིན་རྗེ་དོལ་པོ་པའི་སློབ་མ་</span><span class="s2"> </span><span class="s1">གཙོ་བོ་རྣམས་ཀྱི་ས་ནས་ཀྱང་ཆོས་</span><span class="s2"> </span><span class="s1">མང་དུ་གསན།</span><span class="s2"> </span><span class="s1">རྗེས་སུ་དགེ་བའི་བཤེས་གཉེན་མཚན་</span><span class="s2"> </span><span class="s1">ཉིད་དང་ལྡན་པར་གྱུར།</span><span class="s2"> </span><span class="s1">དོལ་པོ་པའི་རྣམ་ཐར་དང་།</span><span class="s2"> </span><span class="s1">གཞང་ཡང་གཞུང་ལུགས་མཐའ་ཡས་པ་བརྩ</span><span class="s2"> </span><span class="s1">མས།</span></p>'''@tibetan ;
	.

told:_FormattedContent_Biography_Summary_4125
	gist:containedText """<p>
	<style type=\"text/css\">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 12.0px Kokonor}
span.s1 {font-kerning: none}
span.s2 {font: 12.0px 'Times New Roman'; font-kerning: none}	</style>
</p>
<p class=\"p1\">
	<span class=\"s1\">ཉག་བླ་པདྨ་བདུད་འདུལ་ནི་ཀཿ་ཐོག་དགོན་དང་འབྲེལ་བའི་རྙིང་མའི་གཏེར་སྟོན་དང་མཁན་གྲུབ་ཅིག་ཡིན་ལ།</span><span class=\"s2\"> </span><span class=\"s1\">གྲུབ་ཆེན་ཆོས་དབྱིངས་རང་གྲོལ་བསྟེན་ནས་རྫོགས་ཆེན་ལ་མཁས་པར་བསླབས།</span><span class=\"s2\"> </span><span class=\"s1\">སྐུ་གཤེགས་འཇའ་ལུས་སུ་གྲུབ་པ་རེད།</span><span class=\"s2\"> </span><span class=\"s1\">ཁོང་གིས་རང་གི་གདན་ས་སྐལ་བཟང་སངས་རྒྱས་ཆོས་གླིང་དང་གསང་སྔགས་བདེ་ཆེན་གླིང་།</span><span class=\"s2\"> </span><span class=\"s1\">མཚོ་རྒྱལ་ཇོ་མོ་དགོན་བཅས་ཕྱག་བཏབ།</span></p>"""@tibetan ;
	.

told:_FormattedContent_Biography_Summary_4140
	gist:containedText """<p>
	<style type=\"text/css\">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 12.0px Kokonor}
span.s1 {font-kerning: none}
span.s2 {font: 12.0px 'Times New Roman'; font-kerning: none}	</style>
</p>
<p class=\"p1\">
	<span class=\"s1\">སྤོམ་བྲག་པ་བསོད་ནམས་རྡོ་རྗེ་ནི་ཀརྨ་བཀའ་བརྒྱུད་ཀྱི་ཆོས་རྒྱུན་འཛིན་མཁན་སྔ་རབས་པ་ཞིག་ཡིན་ལ།</span><span class=\"s2\"> </span><span class=\"s1\">ཁོང་ནི་སངས་རྒྱས་རས་ཆེན་གྱི་བུ་སློབ་དང་ཉིད་ཀྱིས་ཀརྨ་པ་སྐུ་ཕྲེང་དང་པོའི་སྤྲུལ་སྐུར་ངོས་བཟུང་བ་ཀརྨ་པ་སྐུ་ཕྲེང་གཉིས་པ་ཀརྨ་པཀྵི་ཡི་དགེ་རྒན་ཡིན།</span><span class=\"s2\"> </span><span class=\"s1\">ཁྲ་ཤོད་སྤོམ་བྲག་དགོན་ལ་བདག་སྐྱོང་མཛད་དེ་བསྐྱར་བཞེངས་བྱས།</span></p>"""@tibetan ;
	.

told:_FormattedContent_Biography_Summary_4141
	gist:containedText '''<p class="p1">
	<span class="s1">༸</span>རྒྱལ་དབང་སྐུ་ཕྲེང་བཅུ་གཉིས་པ་འཕྲིན་ལས་རྒྱ་མཚོ་ནི། དགུང་ལོ་ལྔ་པའི་ཐོག་གསེར་ཁྲིར་མངའ་གསོལ། དགུང་ལོ་བཅུ་བདུན་ལ་ཆབ་སྲིད་ཀྱི་ཐུགས་འགན་བཞེས། དེ་ནས་སྙུང་གཞི་དྲག་པོས་བསྙུན་ཏེ་དགུང་ལོ་བཅུ་དགུའི་ཐོག་དགོངས་པ་མྱ་ངན་ལས་འདས།</p>'''@tibetan ;
	.

told:_FormattedContent_Biography_Summary_4163
	gist:containedText '''<p>
	<style type="text/css">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 14.0px Kokonor}
span.s1 {font-kerning: none}	</style>
</p>
<p class="p1">
	<span class="s1">རྟ་ཚག་རྗེ་དྲུང་སྐུ་ཕྲེང་བཅུ་པ་ངག་དབང་དཔལ་ལྡན་ཆོས་ཀྱི་ཡེ་ཤེས་ཀྱིས་རྒྱལ་དབང་སྐུ་ཕྲེང་བཅུ་གསུམ་པ་སྐུ་ན་ཆུང་བའི་སྐབས་སུ་བོད་ཀྱི་རྒྱལ་ཚབ་མཛད།</span></p>'''@tibetan ;
	.

told:_FormattedContent_Biography_Summary_4164
	gist:containedText
		'''<p>
	<style type="text/css">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 12.0px Kailasa}
span.s1 {font-kerning: none}
span.s2 {font: 12.0px Arial; font-kerning: none}	</style>
</p>
<p class="p1">
	<span class="s1">བསོད་ནམས་བཟང་པོའམ་</span><span class="s1">མཚན་གཞན་གཉག་ཕུ་བ་</span><span class="s1">ནི་རྗེ་དོལ་པོ་པ་</span><span class="s1">ཆོས་རྗེ་ཡབ་སྲས་བཅུ་བཞི</span><span class="s2"> </span><span class="s1">འི་ཡ་གྱལ་ཡིན།</span><span class="s2"> </span><span class="s1">ཆོས་ཕལ་ཆེ་བ་དོལ་པ་པའི་སློབ་མ་</span><span class="s2"> </span><span class="s1">རྣམས་ཀྱི་དྲུང་ནས་གསན།</span><span class="s2"> </span><span class="s1">ཁོང་ཕྱོགས་ལས་རྣམ་རྒྱལ་</span><span class="s1">གྱི་གདུང་འཚོབ་ཏུ་ངོས་</span><span class="s2"> </span><span class="s1">འཛིན་བྱས།</span><span class="s2"> </span><span class="s1">གཙོ་བོ་དཔལ་དུས་ཀྱི་འཁོར་ལོ་ལ་</span><span class="s2"> </span><span class="s1">མཁས་པར་གྲགས་ཤིང་།</span><span class="s2"> </span><span class="s1">ཆོས་བརྒྱུད་འདྲ་མིན་གྱི་མཁས་པ་</span><span class="s2"> </span><span class="s1">མང་པོ་རྗེས་སུ་བཟུང་།</span><span class="s2">&nbsp;</span></p>'''@tibetan ,
		'''<p>
	<style type="text/css">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 12.0px Kailasa}
span.s1 {font-kerning: none}
span.s2 {font: 12.0px Calibri; font-kerning: none}	</style>
</p>
<p class="p1">
	<span class="s1">གཉག་ཕུ་བ་བསོད་ནམས་བཟང་པོ་</span><span class="s1">ནི་པཎ་ཆེན་ཤཱཀྱ་ཤྲཱི་བྷདྲ་</span><span class="s1">ནས་མཆེད་པའི་འདུལ་བའི་སྡོམ་བརྒྱུད་རྒྱུན་སྐྱོང་ཆེར་སྤེལ་མཛད་མཁན་གྱི་ས་སྐྱ་པའི་སྐྱེས་ཆེན་ཞིག་ཡིན།</span><span class="s2"> </span><span class="s1">ཁོང་སྨྲ་བའི་སེངྒེ་རོང་སྟོན་ཤེས་བྱ་ཀུན་རིག་</span><span class="s1">གི་བླ་མ་ཡིན།</span></p>'''@tibetan
		;
	.

told:_FormattedContent_Biography_Summary_4167
	gist:containedText """<p>
	<style type=\"text/css\">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 14.0px Kailasa}
span.s1 {font: 14.0px 'Times New Roman'}	</style>
</p>
<p class=\"p1\">
	གྲུབ་ཆེན་ཀུན་དགའ་བློ་གྲོས་ནི་སྐུ་དྲག་ཁྱིམ་རྒྱུད་ཅིག་དུ་སྐུ་འཁྲུངས་ཤིང་།<span class=\"s1\"> </span>རབ་ཏུ་བྱུང་སྟེ་མི་ཚེ་གང་བོར་དམ་པའི་ཆོས་ལ་འབད་པར་མཛད།<span class=\"s1\"> </span>དགེ་བའི་བཤེས་གཉེན་མང་པོ་བསྟེན་ནས་ཐོས་བསམ་མཛད་པས།<span class=\"s1\"> </span>རྗེ་དོལ་པོ་པའི་སྲས་ཀྱི་ཐུ་བོ་ཉ་དབོན་ཀུན་དགའ་དཔལ་གྱི་རྒྱུད་འཛིན་དུ་གྱུར་ཏེ།<span class=\"s1\"> </span>རྩེ་ཆེན་དགོན་དུ་གདན་སར་བྱས།<span class=\"s1\"> </span>ཁོང་ནི་ཇོ་ནང་དང་ས་སྐྱའི་ལུགས་གཉིས་ལ་ཤིན་ཏུ་མཁས་ཤིང་།<span class=\"s1\"> </span>ཇོ་ནང་ལུགས་ཀྱི་དུས་འཁོར་དང་ས་སྐྱའི་ལམ་འབྲས་ལ་ཤིན་ཏུན་མཁས་པར་གྲགས།<span class=\"s1\"> </span>བུ་སྟོན་རིན་ཆེན་གྲུབ་གྱི་རྣམ་སྤྲུལ་དུ་གསུང་།<span class=\"s1\">&nbsp;</span></p>"""@tibetan ;
	.

told:_FormattedContent_Biography_Summary_4168
	gist:containedText """<p>
	<style type=\"text/css\">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 14.0px Kailasa}
span.s1 {font: 14.0px 'Times New Roman'}	</style>
</p>
<p class=\"p1\">
	འཇམ་དབྱངས་དཀོན་མཆོག་བཟང་པོ་ནི་གྲུབ་ཆེན་ཀུན་དགའ་བློ་གྲོས་ཀྱི་བུ་སློབ་ཀྱི་ཐུ་བོ་ཡིན་ལ།<span class=\"s1\"> </span>ཇོ་ནང་དགོན་གྱི་ཁྲི་རབས་བཅུ་བཞི་པ་དང་གཞན་དགོན་སྡེ་སྐོར་ཞིག་གི་ཁྲི་པའི་འགན་བཞེས།<span class=\"s1\"> </span>ཁོང་ཆོས་རྒྱུད་གྲུབ་མཐའ་ཀུན་ལ་མཁས་ལ།<span class=\"s1\"> </span>ཇོ་ནང་ལུགས་ཀྱི་དུས་འཁོར་དང་ས་སྐྱའི་ལུགས་ཀྱི་ལམ་འབྲས་ལ་ཤིན་ཏུ་མཁས་པར་གྲགས།<span class=\"s1\"> </span>ཁོང་གིས་ཡི་དམ་གྱི་ཞལ་མང་དུ་མཇལ་ཞིང་མཁས་ཆེན་མང་པོ་ཞིག་གིས་དགེ་རྒན་དུ་བསྟེན་མྱོང་པ་རེད།</p>"""@tibetan ;
	.

told:_FormattedContent_Biography_Summary_4170
	gist:containedText """<p>
	<style type=\"text/css\">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 14.0px Kailasa}
span.s1 {font: 14.0px 'Times New Roman'}	</style>
</p>
<p class=\"p1\">
	ནམ་མཁའ་ཆོས་སྐྱོང་ནི་ཇོ་ནང་དགོན་པའི་གདན་རབས་བཅོ་བརྒྱད་པ་ཡིན་ལ།<span class=\"s1\"> </span>ཁོང་གིས་གདན་ས་དེ་ཉིད་དང་ཉེ་འཁོར་གྱི་སྒྲུབ་སྡེ་གཉིས་བཅས་ལྷན་དུ་བསྐྱར་བཞེངས་མཛད།<span class=\"s1\"> </span>ཁོང་ནི་འཇམ་དབྱངས་དཀོན་མཆོག་བཟང་པོ་དང་སྒོ་རུམ་པ་སོགས་ཇོ་ནང་པའི་ཆོས་རྒྱུད་འཛིན་མཁན་མཁས་ཆེན་སྐོར་ཞིག་གི་བུ་སློབ་ཡིན།<span class=\"s1\">&nbsp;</span></p>"""@tibetan ;
	.

told:_FormattedContent_Biography_Summary_4175
	gist:containedText """<p>
	<style type=\"text/css\">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 12.0px Kailasa; -webkit-text-stroke: #000000}
span.s1 {font-kerning: none}
span.s2 {font: 12.0px 'Helvetica Neue'; font-kerning: none}	</style>
</p>
<p class=\"p1\">
	<span class=\"s1\">རོ་སྐམ་ཉི་མ་ཤེས་རབ་ནི་ཞང་གཡུ་བྲག་པའི་སློབ་མ་དང་།</span><span class=\"s2\"> </span><span class=\"s1\">ཉེ་གནས་མཛད།</span><span class=\"s2\"> </span><span class=\"s1\">དེ་ནས་རོ་སྐམ་དགོན་པ་ཕྱག་བཏབ།</span><span class=\"s2\"> </span><span class=\"s1\">ཚལ་པ་བཀའ་བརྒྱུད་པའི་སྔོན་གྱི་བྱུང་རབས་ལོ་རྒྱུས་ནང་གི་མི་སྣ་གཙོ་ཆེ་བ་ཞིག་ཡིན།</span><span class=\"s2\"> </span><span class=\"s1\">ཁོང་གིས་བར་ཚལ་ཞེས་པའི་ཚལ་པ་བཀའ་བརྒྱུད་པའི་ལུགས་ཤིག་གསར་དུ་གཏོད།</span></p>"""@tibetan ;
	.

told:_FormattedContent_Biography_Summary_4185
	gist:containedText """<p>
	<style type=\"text/css\">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 14.0px Kailasa}
span.s1 {font: 14.0px 'Times New Roman'}	</style>
</p>
<p class=\"p1\">
	རྡོ་གྲུབ་ཆེན་སྐུ་ཕྲེང་གསུམ་པ་འཇིགས་མེད་བསྟན་པའི་ཉི་མ་ནི་ཀློང་ཆེན་སྙིང་ཐིག་གི་ཆོས་རྒྱུད་འཛིན་མཁན་གྲགས་ཆེན་ཞིག་ཡིན་ལ།<span class=\"s1\"> </span>ཁོང་ནི་བདུད་འཇོམས་གླིང་པའི་གདུང་སྲས་བགྲེས་པ་ཡིན།<span class=\"s1\"> </span>ཁོང་གིས་རང་ཉིད་ཀྱི་གདན་ས་རྡོ་གྲུབ་ཆེན་དགོན་བསྐྱར་བཞེངས་མཛད་ཅིང་།<span class=\"s1\"> </span>ཚེ་མཇུག་ཏུ་དབེན་གནས་བསྟེན་ཏེ་རི་ཁྲོད་འགྲིམས།<span class=\"s1\">&nbsp;</span></p>"""@tibetan ;
	.

told:_FormattedContent_Biography_Summary_4196
	gist:containedText '''<p>
	<style type="text/css">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 14.0px Kailasa}
span.s1 {font-kerning: none}
span.s2 {font: 14.0px Calibri; font-kerning: none}	</style>
</p>
<p class="p1">
	<span class="s1">ཀིརྟི་སྐུ་ཕྲེང་བརྒྱད་པ་བློ་བཟང་འཕྲིན་ལས་བསྟན་པ་རྒྱ་མཚོ་</span><span class="s1">ནི་ཕྱི་ལོ་༡༨༧༤</span><span class="s2"> </span><span class="s1">ལོར་རྔ་ཡུལ་ཀིརྟི་དགོན་པ་</span><span class="s1">ཕྱག་འདེབས་མཁན་གྱི་བླ་མ་ཡིན།</span><span class="s2"> </span><span class="s1">ཁོང་བླ་བྲང་བཀྲ་ཤིས་འཁྱིལ་</span><span class="s1">དུ་གསན་བསམ་སློབ་གཉེར་མཛད།</span><span class="s2">&nbsp;</span></p>'''@tibetan ;
	.

told:_FormattedContent_Biography_Summary_4228
	gist:containedText """<p>
	<style type=\"text/css\">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 12.0px Kokonor}
span.s1 {font-kerning: none}
span.s2 {font: 12.0px 'Times New Roman'; font-kerning: none}	</style>
</p>
<p class=\"p1\">
	<span class=\"s1\">འཇུ་མི་ཕམ་རྒྱ་མཚོ་ནི་མཁས་པ་དབང་བོ་ཞིག་ཡིན་ལ།</span><span class=\"s2\"> </span><span class=\"s1\">ཁོང་གིས་ཚད་མ་རིག་པ་ལས་རྟགས་གསལ་གཏོང་ལུགས་ཀྱང་རྙིང་མ་ལ་ངོ་སྤྲོད་མཛད།</span><span class=\"s2\"> </span><span class=\"s1\">ཁམས་སུ་གྲུབ་མཐའ་ཕན་ཚུན་བར་ཧ་ཅང་སློབ་གཉེར་གནང་པའི་སྐབས།</span><span class=\"s2\"> </span><span class=\"s1\">བཀའ་བརྒྱུད་བླ་མ་འཇམ་མགོན་ཀོང་སྤྲུལ་དང་།</span><span class=\"s2\"> </span><span class=\"s1\">ས་སྐྱ་བླ་མ་འཇམ་དབྱངས་མཁྱེན་བརྩེ་དབང་པོ་སོགས་དང་ལྷན་དུ་ཐོས་བསམ་མཛད་ནའང་།</span><span class=\"s2\"> </span><span class=\"s1\">རྙིང་མའི་ལུགས་ཀྱི་ཐོབ་ཐང་དེ་མ་འདོར་བར་མཛད།</span><span class=\"s2\"> </span><span class=\"s1\">ཁོང་ལ་ངེས་ཤེས་རིན་པོ་ཆེའི་སྒྲོན་མེ་ཞེས་བྱ་བ་དང་བྱང་ཆུབ་སེམས་དཔའི་སྤྱོད་པ་ལ་འཇུག་པ་ཞེས་བྱ་བའི་ལེའུ་དགུ་པའི་འགྲེལ་སོགས་གསུང་རྩོམ་མང་དུ་བཞུགས།</span><span class=\"s2\"> </span><span class=\"s1\">རིག་པའི་གནས་ཀུན་ལ་ཐོས་བསམ་རྒྱ་ཆེར་བྱས་པར་མ་ཟད།</span><span class=\"s2\"> </span><span class=\"s1\">སྒོམ་སྒྲུབ་ལའང་ལོ་མང་བོ་གཞོལ་པར་མཛད།</span></p>"""@tibetan ;
	.

told:_FormattedContent_Biography_Summary_4249
	gist:containedText """<p>
	<style type=\"text/css\">
