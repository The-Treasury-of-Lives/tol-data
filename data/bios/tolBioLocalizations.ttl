span.s2 {font: 12.0px 'Times New Roman'; font-kerning: none}	</style>
</p>
<p class=\"p1\">
	<span class=\"s1\">རྒྱ་ཁོབ་སྤྲུལ་སྐུ་ཀུན་བཟང་ནི་ཀཿཐོག་དགོན་དུ་ཐོས་བསམ་མཛད་པའི་རྙིང་མའི་བླ་མ་ཞིག་ཡིན་ལ།</span><span class=\"s2\"> </span><span class=\"s1\">ཕྱིས་སུ་ཁམས་ཀྱི་དགོན་པ་དང་སྒྲུབ་སྡེ་མང་པོར་འགྲིམ་ནས་ཁྲིད་རྒྱུན་དང་ཆོས་རྒྱུན་དཀོན་པོའི་ཟབ་ཆོས་འབའ་ཞིག་བཙལ།</span><span class=\"s2\"> </span><span class=\"s1\">ཕྱིས་སུ་ཁོང་གིས་བསྡུ་ཉར་བྱས་པའི་དཔེ་རྒྱུན་དཀོན་པོ་དག་ཀཿཐོག་དགོན་པར་ཕུལ་བ་རེད།</span><span class=\"s2\">&nbsp;</span></p>"""@tibetan ;
	.

told:_FormattedContent_Biography_Summary_13162
	gist:containedText """<p>
	<style type=\"text/css\">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 12.0px Kailasa}
span.s1 {font: 12.0px 'Lucida Grande'}
span.s2 {font: 12.0px Georgia}	</style>
</p>
<p class=\"p1\">
	གར་དབང་ལས་རབ་གླིང་པ་ནི་རྫོགས་ཆེན་དགོན་གྱི་དགེ་མང་སྤྲུལ་སྐུ་སྐུ་ཕྲེང་གསུམ་པ་ཡིན། ཁོང་སྨན་དཔྱད་ལ་མཁས་པར་གྲགས། ཕྱི་ལོ་༡༩༥༩ ལོར་དགུང་ལོ་༢༩ ཐོག་བཙོན་ཁང་ནང་སྐུ་དགོངས་པ་མྱ་ངན་ལས་འདས།</p>"""@tibetan ;
	.

told:_FormattedContent_Biography_Summary_13163
	gist:containedText """<p>
	<style type=\"text/css\">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 12.0px Kailasa}
span.s1 {font: 12.0px 'Lucida Grande'}
span.s2 {font: 12.0px Georgia}	</style>
</p>
<p class=\"p1\">
	བསྟན་པའི་ཉི་མ་ནི་ཁམས་རྫོགས་ཆེན་དགོན་གྱི་དགེ་མང་སྤྲུལ་སྐུ་སྐུ་ཕྲེང་གཉིས་པ་ཡིན། ཁོང་སྔ་འགྱུར་རྙིང་མའི་ལུགས་ཀྱི་སོ་སོར་ཐར་པའི་མདོའི་བརྒྱུད་པ་འཛིན་པའི་སྐྱེས་ཆེན་ཞིག་ཡིན་ཞིང་། དགུང་ལོ་ཉེར་ལྔ་ཙམ་ནས་སྐུ་ཚེ་ཧྲིལ་པོ་མཚམས་བསྙེན་སྒྲུབ་ཁོ་ན་བཅད་དེ་བཞུགས།</p>"""@tibetan ;
	.

told:_FormattedContent_Biography_Summary_13166
	gist:containedText """<p>
	<style type=\"text/css\">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 12.0px Kailasa}
span.s1 {font: 12.0px 'Lucida Grande'}
span.s2 {font: 12.0px Georgia}	</style>
</p>
<p class=\"p1\">
	ངག་དབང་མདོ་རྒྱུད་ཡོན་ཏན་རབ་རྒྱས་ནི་སྟོང་འཁོར་སྐུ་ཕྲེང་བརྒྱད་པའི་མཚན་འཛིན་པའི་སྐུ་སྐྱེ་གཉིས་ཀྱི་ཡ་གྱལ་ཡིན་ཞིང་། ཁམས་སྟོང་འཁོར་བཀྲ་ཤིས་ལྷུན་པོ་དགོན་པར་བཞུགས། ཁོང་བློ་བཟང་མདོ་རྒྱུད་ཡེ་ཤེས་རྒྱལ་མཚན་གྱི་ཡང་སྲིད་དུ་ངོས་འཛིན་བྱུང་། སྟོང་འཁོར་སྐུ་ཕྲེང་བརྒྱད་པ་གཅིག་ཤོས་ནི་ཨ་མདོར་བཞུགས་པའི་བླ་མ་ཐུབ་བསྟན་འཇིགས་མེད་སྐལ་བཟང་ཞུ་བ་ཁོང་ཡིན།&nbsp;</p>"""@tibetan ;
	.

