<p class="p1">
	<span class="s1">ངག་དབང་ཐུབ་བསྟན་སྐལ་བཟང་བསྟན་པའི་སྒྲོན་མེ་ནི་ཁམས་ཀྱི་དཔའ་ཤོད་དགོན་དང་ལྷ་སའི་ཀུན་བདེ་གླིང་གཉིས་གདན་སར་མཛད་པའི་རྟ་ཚག་སྐུ་ཕྲེང་བཅུ་གཅིག་པ་ཡིན།</span></p>'''@tibetan ;
	.

told:_FormattedContent_Biography_Summary_10412
	gist:containedText """<p>
	<style type=\"text/css\">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 12.0px Kailasa}
span.s1 {font: 12.0px 'Lucida Grande'}
span.s2 {font: 12.0px Georgia}	</style>
</p>
<p class=\"p1\">
	ཉི་གྲགས་སྤྲུལ་སྐུ་སྐུ་ཕྲེང་གསུམ་པ་མི་འགྱུར་ཕན་བདེ་རྒྱ་མཚོ་ནི་རྫོགས་ཆེན་གྲུབ་དབང་སྐུ་ཕྲེང་གསུམ་པ་ངེས་དོན་བསྟན་འཛིན་བཟང་པོའི་སློབ་མ་ཡིན། ཉི་གྲགས་སྐུ་རབས་རིམ་བྱོན་གྱི་གདན་ས་སྲིན་རྫོང་འོད་གསལ་སྒྲུབ་སྡེ་དང་སྟག་མོ་སྒང་སྐལ་བཟང་ཕུན་ཚོགས་གླིང་དུ་བཞུགས། ལྷ་ཁང་དང་སྐུ་གསུང་ཐུགས་རྟེན་མང་པོ་གསར་དུ་བཞེངས།</p>"""@tibetan ;
	.

told:_FormattedContent_Biography_Summary_10413
	gist:containedText """<p>
	<style type=\"text/css\">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 12.0px Kokonor}
span.s1 {font-kerning: none}
span.s2 {font: 12.0px 'Times New Roman'; font-kerning: none}	</style>
</p>
<p class=\"p1\">
	<span class=\"s1\">འཇིགས་མེད་ཆོས་དབྱིངས་རྡོ་རྗེ་ནི་རྫོགས་ཆེན་མི་འགྱུར་ནམ་མཁའི་རྡོ་རྗེ་ཡི་བུ་སློབ་ཞིག་ཡིན་ལ།</span><span class=\"s2\"> </span><span class=\"s1\">ཉི་མ་གྲགས་པའི་སྤྲུལ་སྐུ་རིམ་བྱོན་གྱི་གདན་ས་ལྕགས་རི་ཉི་གྲགས་དགོན་དང་སྟག་མོ་སྒང་སྐལ་བཟང་ཕུན་ཚོགས་གླིང་གི་ཉི་སྤྲུལ་སྐུ་ཕྲེང་བཞི་པ་ཡིན།</span><span class=\"s2\">&nbsp;</span></p>"""@tibetan ;
	.

told:_FormattedContent_Biography_Summary_10422
	gist:containedText """<p>
	<style type=\"text/css\">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 12.0px Kailasa}
span.s1 {font: 12.0px 'Lucida Grande'}
span.s2 {font: 12.0px Georgia}	</style>
</p>
<p class=\"p1\">
	ཁྱུང་བྲག་རྡོ་རྗེ་ནི་ཀློང་གསལ་སྙིང་པོའི་དྲུང་ནས་གསན་བསམ་ཚུལ་བཞིན་མཛད་པའི་ཀཿཐོག་དགོན་པའི་གཏེར་སྟོན་ཞིག་ཡིན།&nbsp;</p>"""@tibetan ;
	.

told:_FormattedContent_Biography_Summary_10442
	gist:containedText """<p>
	<style type=\"text/css\">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 14.0px Kailasa}
span.s1 {font: 14.0px 'Times New Roman'}	</style>
</p>
<p class=\"p1\">
	དྲུང་དྲུང་རྒྱལ་མཆོག་ལ་ཧུམ་རལ་དྲུང་དྲུང་རྒྱལ་མཆོག་ཞེས་ཀྱང་འབོད་ལ།<span class=\"s1\"> </span>དུས་རབས་བཅོ་ལྔ་པའི་འབྲུག་ཡུལ་གྱི་བླ་མ་ཡིན།<span class=\"s1\"> </span>ཁོང་ནི་འབྲུག་ཡུལ་དུ་འབྲུག་པ་བཀའ་བརྒྱུད་དར་ཞིང་སྤེལ་བར་མཛད་མཁན་ཡིན་ལ།<span class=\"s1\"> </span>དུས་རབས་བཅུ་བདུན་པར་ཞབས་དྲུང་ངག་དབང་རྣམ་རྒྱལ་གྱི་འབྲུག་པའི་ཐེངས་དང་པོའི་སྲིད་གཞུང་འཛུགས་དུས།<span class=\"s1\"> </span>ཁོང་གི་རྗེས་འཇུག་དག་གིས་རོགས་རམ་ཆེན་མོ་མཛད།</p>"""@tibetan ;
	.

told:_FormattedContent_Biography_Summary_10457
	gist:containedText '''<p class="p1">
	མཁན་པོ་འཇིགས་མེད་ཕུན་ཚོགས་ནི་དུས་རབས་ཉི་ཤུ་པའི་ནང་གི་སྔ་འགྱུར་རྙིང་མའི་བླ་མ་མཚན་སྙན་ཆེ་བའི་ཁོངས་སུ་བགྲངས། ཁོང་ཕྱི་ལོ་༡༩༥༩ ཡི་དོན་རྐྱེན་རྗེས་བོད་ནང་བཞུགས། བོད་དུ་རིག་གནས་གསར་བརྗེ་མཇུག་བསྒྲིལ་མཚམས་ཁོང་ནས་མགོ་ལོག་གསེར་རྟ་ཁུལ་དུ་བླ་རུང་སྒར་ཕྱག་བཏབ། དེ་ནི་དེང་སང་འཛམ་གླིང་ནང་གི་དགོན་སྡེ་ཆེ་ཤོས་ཤིག་ཏུ་གྱུར། ཁོང་གཏེར་སྟོན་བསོད་རྒྱལ་ལས་རབ་གླིང་པའི་ཡང་སྲིད་ཡིན་ཞེས་འཁོད།</p>'''@tibetan ;
	.

told:_FormattedContent_Biography_Summary_10482
	gist:containedText """<p>
	<style type=\"text/css\">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 12.0px Kailasa}
span.s1 {font: 12.0px 'Times New Roman'}	</style>
</p>
<p class=\"p1\">
	པདྨ་ཚེ་དབང་ནི་འབྲུག་ཡུལ་གྱི་བླ་མ་གྲགས་ཆེན་ཞིག་ཡིན་ལ།<span class=\"s1\"> </span>ཡུལ་དེའི་སློབ་གསོ་དེང་རབས་ཅན་དུ་གཏོང་བར་ཕྱག་ལས་གནང་མྱོང་ལ།<span class=\"s1\"> </span>སྐད་ཡིག་གི་སློབ་ཁྲིད་ཐད་ལ་ལྷག་པར་མཛད་རྗེས་ཆེ།</p>"""@tibetan ;
	.

told:_FormattedContent_Biography_Summary_10497
	gist:containedText """<p>
	<style type=\"text/css\">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 14.0px Kailasa}
span.s1 {font: 14.0px 'Times New Roman'}	</style>
</p>
<p class=\"p1\">
	ཀློ་བོ་མཁན་ཆེན་བསོད་ནམས་ལྷུན་གྲུབ་ནི་གློ་མོན་ཐང་གི་ས་སྐྱ་དྲུང་ཆེན་གྱི་ཁྱིམ་དུ་སྐུ་འཁྲུངས་ཤིང་།<span class=\"s1\"> </span>ཁོང་གི་ཁྱིམ་མི་ལྟར་ཁོང་ཡང་ངོར་ཆེན་ཀུན་དགའ་བཟང་པོ་དང་ཁོའི་རྗེས་འཇུག་རྣམས་ལ་ཤིན་ཏུ་དད།<span class=\"s1\"> </span>ཁོ་རང་གཙང་དུ་ཐེངས་གཉིས་ལ་ཕྱག་ཕེབས་ནས་སྣེ་གདོང་དང་།<span class=\"s1\"> </span>ས་སྐྱ།<span class=\"s1\"> </span>ངོར་སོགས་ལ་མཇལ།<span class=\"s1\"> </span>ས་སྐྱ་པཎྜིཏའི་གསུང་ལ་འགྲེལ་རྩོམ་པར་ཤིན་ཏུ་མཁས་པས།<span class=\"s1\"> </span>ཕྱིས་སུ་ཁོང་ཉིད་ས་སྐྱ་པཎྜིཏའི་རྣམ་སྤྲུལ་ལ་ངོས་འཛིན་བྱེད་ཀྱིན་ཡོད་པ་རེད།</p>"""@tibetan ;
	.

told:_FormattedContent_Biography_Summary_10531
	gist:containedText """<p>
	<style type=\"text/css\">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 14.0px Kailasa}
span.s1 {font: 14.0px 'Times New Roman'}	</style>
</p>
<p class=\"p1\">
	ཕ་ཇོ་འབྲུག་སྒོམ་ཞིག་པོ་ནི་འབྲུག་ཡུལ་གྱི་ལོ་རྒྱུས་མི་སྣ་གལ་ཆེན་ཞིག་ཡིན་ལ།<span class=\"s1\"> </span>ར་ལུང་དགོན་གྱི་ཁྲི་རབས་གཉིས་པའི་བུ་སློབ་འབྲུག་པ་སྐྱ་ཕོ་ཞིག་ཡིན།<span class=\"s1\"> </span>ཁོང་ནི་རྫོགས་ཆེན་དང་འབྲུག་པ་བཀའ་བརྒྱུད་ཀྱི་རྒྱ་རྟགས་ཆེན་མོ།<span class=\"s1\"> </span>ཞི་བྱེད་བཅས་ཀྱི་ལུང་རྒྱུན་འཛིན་མཁན་ཞིག་ཡིན་ལ།<span class=\"s1\"> </span>ལྷའི་ལུང་བསྟན་ལྟར་ཚེ་སྨད་དུ་འབྲུག་ཡུལ་དུ་བཞུགས་ཤིང་།<span class=\"s1\"> </span>དེ་རུ་ཆབ་སྲིད་ཀྱི་གོ་གནས་མཐོན་པོ་ལྷགས།<span class=\"s1\"> </span>ཁོང་གི་འབྲུག་པ་བཀའ་བརྒྱུད་དང་ལྷ་པ་བཀའ་བརྒྱུད་གཉིས་འགལ་ཟླར་གྱུར་པ་ལས་རྒྱལ་ཞིང་།<span class=\"s1\"> </span>འབྲུག་ཡུལ་དུ་འབྲུག་པ་བཀའ་བརྒྱུད་ཀྱི་ལུགས་རྒྱ་ཆེར་སྤེལ་བ་རེད།<span class=\"s1\"> </span>ཕ་ཇོ་འབྲུག་སྒོམ་ཞིག་པོས་འབྲུག་ཡུལ་གྱི་ཆེས་ཐོག་མའི་དགོན་པ་འགའ་ཕྱག་འདེབས་གནང་།<span class=\"s1\">&nbsp;</span></p>"""@tibetan ;
	.

told:_FormattedContent_Biography_Summary_10536
	gist:containedText """<p>
	<style type=\"text/css\">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 14.0px Kailasa}
span.s1 {font: 14.0px 'Times New Roman'}	</style>
</p>
<p class=\"p1\">
	སྟག་ཚང་རས་པ་ངག་དབང་རྒྱ་མཚོ་ནི་འབྲུག་པ་བཀའ་བརྒྱུད་ཀྱི་དཔོན་རིགས་གཙོ་ཤོས་ཤིག་ཡིན་ལ།<span class=\"s1\"> </span>ལ་དྭགས་རྒྱལ་པོ་སེངྒེ་རྣམ་རྒྱལ་དང་ལྷན་དུ་ཡུལ་དེ་རུ་འབྲུག་པ་བཀའ་བརྒྱུད་ཀྱི་ལུགས་སྤེལ་བར་མཛད་པས།<span class=\"s1\"> </span>ལ་དྭགས་ཆོས་འབྱུང་ལོ་རྒྱུས་སུ་མི་སྣ་གལ་ཆེན་ཞིག་ཏུ་གྱུར་ཡོད་པ་རེད།<span class=\"s1\"> </span>ཁོང་ནི་ཡ་གླིང་དབུས་ཁུལ་དང་།<span class=\"s1\"> </span>རྒྱ་ནག་གླིང་ཆེན་འགྱིང་རི།<span class=\"s1\"> </span>རྗེ་མི་ལ་རས་པ་དང་འབྲེལ་བའི་བོད་ཀྱི་ལྷོ་ཁུལ་ཀྱི་ཡུལ་གྲུ་སྐོར་ཞིག་དང་།<span class=\"s1\"> </span>ལོ་རྒྱུས་སུ་སངས་རྒྱས་ཆོས་ལུགས་ལ་དད་པའི་རྒྱ་གར་བྱང་ཕྱོགས་ཀྱི་རྒྱལ་ཁམས་སྐོར་ཞིག་ལ་ཕེབས་བཞུད་མཛད་པས་ཤིན་ཏུ་སྙན་གྲགས་ཆེ།<span class=\"s1\"> </span>ལ་དྭགས་སུ་ཝཾ་ལེ་དགོན་དང་ཧེ་མི་དགོན་གཉིས་ཕྱག་བཏབ་ཅིང་།<span class=\"s1\"> </span>ཁོང་གི་སྐུ་ཕྲེང་རིམ་བྱོན་གྱིས་སྐྱོང་བཞིན་ཡོད་དོ།<span class=\"s1\">&nbsp;</span></p>"""@tibetan ;
	.

told:_FormattedContent_Biography_Summary_10548
	gist:containedText """<p>
	<style type=\"text/css\">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 14.0px Kokonor}
span.s1 {font-kerning: none}
span.s2 {font: 14.0px 'Times New Roman'; font-kerning: none}	</style>
</p>
<p class=\"p1\">
	<span class=\"s1\">ངག་དབང་ཆོས་གྲགས་ནི་ས་སྐྱ་པའི་ལམ་འབྲས་སློབ་བཤད་ཀྱི་བླ་བརྒྱུད་གྲགས་ཆེན་ཞིག་ཡིན་ལ།</span><span class=\"s2\"> </span><span class=\"s1\">ཁོང་གིས་སྤྱི་ལོ</span><span class=\"s2\"> </span><span class=\"s1\">༡༦༠༧ལོ་ནས</span><span class=\"s2\"> </span><span class=\"s1\">༡༦༡༣</span><span class=\"s2\"> </span><span class=\"s1\">ལོའི་བར་དུ་བཀའ་བརྒྱུད་དགོན་ཡངས་པ་ཅན་དུ་མཁན་པོ་མཛད་ཅིང་།</span><span class=\"s2\"> </span><span class=\"s1\">ས་སྐྱ་དགོན་གྱི་ཁྲི་ལ་བཞུགས་མིན་གསལ་བོ་མི་ཤེས།</span></p>"""@tibetan ;
	.

told:_FormattedContent_Biography_Summary_10571
	gist:containedText """<p>
	<style type=\"text/css\">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 12.0px Kailasa}
span.s1 {font: 12.0px 'Times New Roman'}	</style>
</p>
<p class=\"p1\">
	ཀཿཐོག་པ་བྱང་ཆུབ་སེངྒེ་ནི་ཀཿཐོག་དགོན་གྱི་གདན་རབས་བཅུ་གསུམ་པ་ཡིན་ལ།<span class=\"s1\"> </span>ཚེ་མཇུག་ཏུ་ལོ་འགའ་ལ་གདན་ས་དེ་ཉིད་བསྐྱངས་པར་མཛད་ཅིང་།<span class=\"s1\"> </span>དེའི་སྐབས་སུ་ཆོས་སྐྱོང་དམ་ཅན་རྡོ་རྗེ་ལ་བཀའ་བསྒོས་མཛད་དེ་རྒྱ་གར་ནས་སྟོན་པའི་སྐུ་ཞིག་ཀཿཐོག་དགོན་དུ་གདན་དྲངས།</p>"""@tibetan ;
	.

told:_FormattedContent_Biography_Summary_10572
	gist:containedText """<p>
	<style type=\"text/css\">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 12.0px Kailasa}
span.s1 {font: 12.0px 'Times New Roman'}	</style>
</p>
<p class=\"p1\">
	ཀཿཐོག་པ་བློ་གྲོས་སེངྒེ་ནི་རྙིང་མའི་བླ་མ་གྲགས་ཆེན་ཞིག་ཡིན་ལ།<span class=\"s1\"> </span>སྤྱི་ལོ<span class=\"s1\"> </span>༡༤༠༦<span class=\"s1\"> </span>ལོ་ནས<span class=\"s1\"> </span>༡༤༣༠<span class=\"s1\"> </span>ལོའི་བར་ཀཿཐོག་དགོན་དུ་གདན་རབས་བཅུ་གཅིག་པའི་འགན་བཞེས།<span class=\"s1\"> </span>ཁོང་གིས་གདན་ས་བསྐྱངས་པའི་སྐབས་སུ་ཀཿཐོག་གི་འཆད་ཉན་མ་ཉམས་པར་མཛད་ཅིང་།<span class=\"s1\"> </span>གཏེར་ཆོས་ལ་འཆད་ཉན་དང་ཉམས་ལེན་བྱེད་པར་ཡང་བརྩོན་པར་མཛད།<span class=\"s1\">&nbsp;</span></p>"""@tibetan ;
	.

told:_FormattedContent_Biography_Summary_10573
	gist:containedText """<p>
	<style type=\"text/css\">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 12.0px Kailasa}
span.s1 {font: 12.0px 'Times New Roman'}	</style>
</p>
<p class=\"p1\">
	གཙང་སྟོན་རྡོ་རྗེ་རྒྱལ་མཚན་ནི་ཀཿཐོག་པ་དམ་པ་བདེ་གཤེགས་ཀྱི་བུ་སློབ་གཙོ་ཤོས་ཤིག་ཡིན་ལ།<span class=\"s1\"> </span>སྤྱི་ལོ<span class=\"s1\"> </span>༡༡༩༢<span class=\"s1\"> </span>ལོ་ནས་སྤྱི་ལོ<span class=\"s1\"> </span>༡༢༢༧<span class=\"s1\"> </span>ལོར་དགོངས་པ་གཤེགས་པའི་བར་དུ་ཀཿཐོག་དགོན་གྱི་གདན་རབས་གཉིས་པའི་འགན་བཞེས།</p>"""@tibetan ;
	.

told:_FormattedContent_Biography_Summary_10580
	gist:containedText """<p>
	<style type=\"text/css\">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 12.0px Kailasa}
span.s1 {font: 12.0px 'Lucida Grande'}
span.s2 {font: 12.0px Georgia}	</style>
</p>
<p class=\"p1\">
	འཇམ་དབྱངས་མཐུ་སྟོབས་དབང་ཕྱུག་ནི་འཇམ་མགོན་ཨ་མྱེས་ཞབས་ཀྱི་ནུ་བོ་ཡིན།</p>"""@tibetan ;
	.

told:_FormattedContent_Biography_Summary_10613
	gist:containedText """<p>
	<style type=\"text/css\">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 14.0px Kokonor}
span.s1 {font-kerning: none}
span.s2 {font: 14.0px 'Times New Roman'; font-kerning: none}	</style>
</p>
<p class=\"p1\">
	<span class=\"s1\">ངག་དབང་ཀུན་དགའ་དབང་རྒྱལ་ནི་ས་སྐྱ་ཁྲི་འཛིན་ནམ་ས་སྐྱ་དགོན་པའི་ཁྲི་རབས་ཉེར་དྲུག་པ་ཡིན་ལ།</span><span class=\"s2\"> </span><span class=\"s1\">སྤྱི་ལོ</span><span class=\"s2\"> </span><span class=\"s1\">༡༦༡༨</span><span class=\"s2\"> </span><span class=\"s1\">ནས་སྤྱི་ལོ</span><span class=\"s2\"> </span><span class=\"s1\">༡༦༢༠ལོར་དགོངས་པ་རྫོགས་པའི་བར་དུ་གདན་ས་བསྐྱངས།</span></p>"""@tibetan ;
	.

told:_FormattedContent_Biography_Summary_10633
	gist:containedText """<p>
