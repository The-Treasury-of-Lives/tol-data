p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 12.0px Kailasa; color: #000000}
span.s1 {font: 12.0px 'Lucida Grande'}	</style>
</p>
<p class=\"p1\">
	བྱམས་པ་བཀྲ་ཤིས་ནི་དགའ་ལྡན་ཁྲི་པ་ཞེ་གཉིས་པ་ཡིན་ཞིང་། ཕྱི་ལོ་༡༦༧༥<span class=\"s1\"> </span>ནས་༡༦༨༡<span class=\"s1\"> </span>བར་ཁྲི་པ་མཛད། ཁོང་དྭགས་པོ་དང་རྒྱུད་སྟོད་བཅས་སུ་སློབ་གཉེར་གནང་སྟེ་དགོན་པ་དེ་དག་ཏུ་འཆད་ཉན་སློབ་དཔོན་གྱི་ཐུགས་འགན་བཞེས། རྗེས་སུ་དགའ་ལྡན་བྱང་རྩེ་གྲྭ་ཚང་དུ་སློབ་དཔོན་གནང་། དེ་ནས་རིམ་གྱིས་དགའ་ལྡན་གྱི་གསེར་ཁྲིར་བཞུགས། ཁྲི་པ་མཛད་པའི་སྐབས་ཁོང་ནས་དགའ་ལྡན་ཡངས་པ་ཅན་གྱི་གསེར་ཟངས་ཀྱི་རྒྱ་ཕིབས་དང་། ༧རྒྱལ་དབང་ལྔ་པ་ཆེན་པོའི་དངུལ་གྱི་སྐུ་བརྙན་སོགས་གསར་དུ་བཞེངས།</p>"""@tibetan ,
		"""<p>
	强巴扎西于1675至1681年担任第四十三任甘丹赤巴。他在达波寺及上密院学习，并随后担任那里的导师。他同时也是甘丹绛孜寺的导师，后成为赤巴。在任职期间，他为甘丹羊八井寺建造了镀金屋顶，绘制了五世达赖喇嘛银像。</p>"""@chinese
		;
	.

told:_FormattedContent_Biography_Summary_8116
	gist:containedText '''<p>
	<style type="text/css">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 12.0px Kailasa}
span.s1 {font-kerning: none}
span.s2 {font: 12.0px Arial; font-kerning: none}	</style>
</p>
<p class="p1">
	<span class="s1">དཀོན་རྡོར་སྤྲུལ་སྐུ་སྐུ་ཕྲེང་</span><span class="s2"> </span><span class="s1">དང་པོ་</span><span class="s1">མཁས་གྲུབ་ཤཱཀྱ་ལྷ་དབང་</span><span class="s1">ནི་འཕགས་པ་ལྷ་སྐུ་ཕྲེང་</span><span class="s2"> </span><span class="s1">གཉིས་པ་</span><span class="s1">དང་།</span><span class="s2"> </span><span class="s1">ཞི་བ་ལྷ་སྐུ་ཕྲེང་གསུམ་པ་</span><span class="s1">དང་བཞི་པ་བཅས་ཀྱི་ཉེ་འབྲེལ་</span><span class="s2"> </span><span class="s1">ཡིན།</span><span class="s2"> </span><span class="s1">ཉང་ཡུལ་ཕན་བདེ་དགོན་</span><span class="s1">གྱི་མཁན་པོ་མཛད།</span><span class="s2"> </span><span class="s1">དེར་འདུ་ཁང་དང་ལྷ་ཁང་གསར་རྒྱག་</span><span class="s2"> </span><span class="s1">དང་།</span><span class="s2"> </span><span class="s1">ཕྱག་དཔེ་དཔར་སྐྲུན།</span><span class="s2"> </span><span class="s1">སྐུ་བརྙན་གསར་བཞེངས་སོགས་དགོན་</span><span class="s2"> </span><span class="s1">པའི་རྟེན་དང་བརྟེན་པ་བཅས་པར་སྨ</span><span class="s2"> </span><span class="s1">ན་པའི་ཞབས་འདེགས་རྒྱ་ཆེར་བསྒྲུ</span><span class="s2"> </span><span class="s1">བས།</span><span class="s2"> </span><span class="s1">དཔལ་ཧེ་རུ་ཀའི་བརྒྱུད་པ་ཉམས་གསོ</span><span class="s2"> </span><span class="s1">་དཔྱིས་ཕྱིན་མཛད།</span><span class="s2"> </span><span class="s1">ཁོང་དགོངས་པ་རྫོགས་ཏེ་དཀོན་རྡོ</span><span class="s2"> </span><span class="s1">ར་སྐུ་ཕྲེང་གཉིས་པ་</span><span class="s1">རྗེ་དབོན་དཀོན་མཆོག་རྡོ་</span><span class="s2"> </span><span class="s1">རྗེ་</span><span class="s1">ཡང་སྲིད་དུ་ངོས་འཛིན་བྱུ</span><span class="s2"> </span><span class="s1">ང་རྗེས་བསྡུས་མིང་དཀོན་རྡོར་ཞེ</span><span class="s2"> </span><span class="s1">ས་པ་སྤྲུལ་སྐུ་སྔ་ཕྱི་ན་རིམ་རྣ</span><span class="s2"> </span><span class="s1">མས་ལ་སྦྱར།</span><span class="s2">&nbsp;</span></p>'''@tibetan ;
	.

told:_FormattedContent_Biography_Summary_8128
	gist:containedText """<p>
	<style type=\"text/css\">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 14.0px Kailasa}
span.s1 {font: 14.0px 'Times New Roman'}	</style>
</p>
<p class=\"p1\">
	གུང་ཐང་སྐུ་ཕྲེང་དྲུག་པ་འཇིགས་མེད་བསྟན་པའི་དབང་ཕྱུག་གིས་སྤྱི་ལོ<span class=\"s1\"> </span>༡༩༥༤<span class=\"s1\"> </span>ནས<span class=\"s1\"> </span>༡༩༥༨<span class=\"s1\"> </span>ལོའི་བར་བླ་བྲང་དགོན་གྱི་ཁྲི་པའི་འགན་བཞེས་ཤིང་།<span class=\"s1\"> </span>ཕྱིས་སུ་སྤྱི་ལོ<span class=\"s1\"> </span>༡༩༩༠<span class=\"s1\"> </span>ལོར་ཡང་བསྐྱར་ཁྲི་པར་བཞུགས།<span class=\"s1\"> </span>ཁོང་ནི་ལོ་རྒྱུས་ཀྱི་གོ་ཆག་རྐྱེན་གྱིས་ལོ་ངོ་ཉེར་གཅིག་ལ་བཙོན་དུ་བཅུག་ཅིང་སྤྱི་ལོ<span class=\"s1\"> </span>༡༩༧༩<span class=\"s1\"> </span>ལོར་བཙོན་གྲོལ་འཐོབ།<span class=\"s1\"> </span>ཁོང་ཉིད་བཙོན་གྲོལ་ཐོབ་རྗེས་བླ་བྲང་དང་ཨ་མདོའི་ཡུལ་དུ་ཆོས་ལུགས་སླར་གསོ་བྱེད་པ་ལ་མཛད་རྗེ་བླ་ན་ཆེ།<span class=\"s1\"> </span>རྒྱལ་དབང་སྐུ་ཕྲེང་བཅུ་པར་དད་པ་ཡོད་ཚུལ་དང་བོད་རང་བཙན་ཡོང་བར་རེ་བ་བྱེད་བཞིན་ཡོད་ཅེས་ཁྲོམ་བསྒྲགས་མཛད།<span class=\"s1\"> </span>སྤྱི་ལོ<span class=\"s1\"> </span>༡༩༩༤<span class=\"s1\"> </span>ལོར་ཁོང་གི་དུས་འཁོར་དབང་ཆེན་ཆེས་རྗེས་མ་སྟེ་ཐེངས་བཅུ་པ་གནང་བས་མི་ཚོགས་ཁྲི་ཕྲག་མང་པོ་བླ་བྲང་དུ་འདུས།<span class=\"s1\"> </span>སྤྱི་ལོ<span class=\"s1\"> </span>༢༠༠༠ལོར་པེ་ཅིན་དུ་སྨན་ཁང་ཞིག་ནས་སྐུ་གཤེགས་ཤིང་།<span class=\"s1\"> </span>ཁོང་གི་གཤེགས་རྐྱེན་ནི་ད་ལྟ་བར་དུ་དད་ལྡན་མང་ཚོགས་ཀྱི་དོགས་པའི་གནས་ཤིག་ཏུ་གྱུར་ཡོད་པ་རེད།</p>"""@tibetan ;
	.

told:_FormattedContent_Biography_Summary_8177
	gist:containedText '''<p class="p1">
	སྨྱོ་ཤུལ་མཁན་པོ་འཇམ་དབྱངས་རྡོ་རྗེ་ནི་དུས་རབས་ཉི་ཤུ་པའི་སྔ་འགྱུར་རྫོགས་པ་ཆེན་པོའི་ལུགས་ཀྱི་སློབ་དཔོན་མཚན་སྙན་ཆེ་བ་ཞིག་ཡིན། ཁོང་ནི་མདོ་ཁམས་སུ་འཁྲུངས། ཆུང་དུས་མཁན་པོ་ང་དགའ་སོགས་སྐབས་དེའི་སློབ་དཔོན་ཆེན་པོ་རྣམས་ཀྱི་ཞབས་ལ་གཏུགས། ལོ་མང་རིང་དབེན་གནས་བསྟེན་ཏེ་མཚམས་བསྙེན་སྒྲུབ་མཛད། རྒྱ་ནག་དམར་དམག་གིས་བོད་ནང་བཙན་འཛུལ་བྱས་པས་ཁོང་ཕྱི་ལོ་༡༩༥༠ ཡས་མས་བཙན་བྱོལ་ལ་ཕེབས། འབྲུག་ཡུལ་དུ་བཞུགས་ནས་སྲིད་ཀྱི་སྣེ་མོར་གཏོགས་པ་ནས་ཁྱིམ་ནས་ཁྱིམ་མེད་པར་རབ་ཏུ་བྱུང་བ་བཅས་སྐྱ་སེར་ཐམས་ཅད་དང་། དེ་བཞིན་ནུབ་ཕྱོགས་ཡུལ་གྲུ་ཁག་ལ་དམ་ཆོས་འཆད་སྤེལ་གྱི་བྱ་བ་རྒྱ་ཆེར་མཛད།</p>'''@tibetan ;
	.

told:_FormattedContent_Biography_Summary_8181
	gist:containedText
		'''<p class="p1">
	གཏེར་ཆེན་མཆོག་གྱུར་གླིང་པ<span class="s1">་ནི་</span>དུས་རབས་བཅུ་དགུ་པའི་<span class="s1">ནང་དུ་བྱོན་པའི་</span>གཏེར་སྟོན་གྲགས་ཅན་ཞིག་ཡིན་ཅིང་།<span class="s2"> </span>ཁོང་<span class="s1">གིས་གཙོ་བོ་ཁམས་ཕྱོགས་སུ་མཛད་འཕྲིན་བསྐྱངས་ཡོད།</span><span class="s3"> </span>འཇམ་མགོན་ཀོང་སྤྲུལ་དང་འཇམ་དབྱངས་མཁྱེན་བརྩེ་དབང་པོ་རྣམ་གཉིས་དང་ཐུགས་འདྲིས་ཤིན་ཏུ་ཆེ་བས། ཁོང་རྣམ་པ་གསུམ་ལ་<span class="s4">མཁྱེན་ཀོང་མཆོག་གསུམ་ཞེས</span><span class="s5">་</span>གྲགས། ཁོང་<span class="s5">གི་གཏེར་མ་གྲགས་ཆེ་ཤོས</span><span class="s1">་ནི་</span>བར་ཆད་ཀུན་སེལ་དང་།<span class="s2"> </span>ཟབ་པ་སྐོར་བདུན།<span class="s2"> </span><span class="s5">ལམ་རིམ་ཡེ་ཤེས་སྙིང་པོ་སོགས་ཡིན་ཏེ། ཕྱི་མ་དེར་</span>འཇམ་མགོན་ཀོང་སྤྲུལ་གྱིས་འགྲེལ་པ་ཞིག་ཀྱང་མཛད་ཡོད།<span class="s2"> </span>གཏེར་ཆེན་འདིས་ཁམས་ཕྱོགས་སུ་<span class="s5">གནས་སྒོ་མང་པོ་ཞིག་ཕྱེས་ཡོད་པའང་། </span><span class="s4">ཁམས་ཁུལ་གྱི་གནས་ཆེན་ཁག་གི་ས་བཀྲ་ཆགས་ཚུལ་ལ་ཤུགས་རྐྱེན་</span>མངོན་གསལ་དུ་བཞག་ཡོད་ལ།<span class="s2"> </span>རྩི་ཀེ་<span class="s5">དགོན་ད</span>ང་གནས་བརྟན་དགོན་<span class="s5">གཉིས་ཀྱང་</span>ཕྱག་བཏབ་ཡོད་<span class="s5">པའང་།</span><span class="s6"> </span>དུས་ཕྱིས་<span class="s4">གང་ཉིད་ཀྱི་རྣམ་སྤྲུལ་</span>ཀེ་ལ་མཆོག་གླིང་དང་གནས་བརྟན་མཆོག་གླིང་<span class="s5">ཟུང་</span>སྐུ་ཕྲེང་རིམ་བྱོན་གྱི་<span class="s5">གདན་སར་གྱུར་ཡོད་དོ།།</span></p>'''@tibetan ,
		"""<p>
	秋吉林巴是十九世纪掘藏数量最多的伏藏师之一。他以康区为主要活动区域，与蒋贡康楚以及蒋扬钦哲旺波关系亲密，三人合称“钦贡秋三尊”。在他诸多的伏藏发现中，以《心修遍除诸障》、《甚深七法》以及《本智精华道次第》最为著名，蒋贡康楚为后者写了一本非常有名的论释。秋吉林巴在康区发现了多处圣地，这些圣地对康区神圣地理的形成有很大的影响。他建立了则吉寺以及涅殿寺，分别成为他自己的两个转世体系吉喇与涅殿的驻锡寺院。</p>"""@chinese
		;
	.

told:_FormattedContent_Biography_Summary_8194
	gist:containedText '''<p>
	<span style="caret-color: rgb(0, 0, 0); color: rgb(0, 0, 0); font-family: &quot;Monlam Uni OuChan1&quot;; font-size: 16px;">པ་ཚབ་ཉི་མ་གྲགས་ནི་མགོན་པོ་ཀླུ་སྒྲུབ་དང་སློབ་དཔོན་ཟླ་བ་གྲགས་པའི་དབུ་མའི་བསྟན་བཅོས་གསར་དུ་བསྒྱུར་ཏེ། བོད་དུ་དབུ་མའི་འཆད་ཉན་གྱི་ལམ་སྲོལ་འབྱེད་པའི་སློབ་དཔོན་ལོ་ཙཱ་བ་ཆེན་པོ་ཞིག་ཡིན། ཁོང་གིས་མངོན་པ་དང་ཚད་མ། སྐྱེས་རབས། དེ་བཞིན་གསང་སྔགས་ཀྱི་བསྟན་བཅོས་བསྒྱུར་ཡོད་མོད། གཙོ་བོར་དབུ་མའི་འཆད་ཉན་ལ་བརྟེན་ནས་སྙན་གྲགས་དང་མཛད་རྗེས་ཅན་དུ་གྱུར་པ་མ་ཟད། བོད་དུ་དབུ་མ་ཐལ་འགྱུར་བའི་ལྟ་གྲུབ་ཐོག་མར་སྤེལ་མཁན་དུ་འདོད།&nbsp; ཁོང་གིས་ཁ་ཆེའི་ཡུལ་དུ་མི་ལོ་ཉེར་གསུམ་ཙམ་བཞུགས་པ་དང་། དེ་ཡང་གཙོ་བོར་གྲོང་ཁྱེར་དཔེ་མེད་ཀྱི་རིན་ཆེན་སྦས་པའི་གཙུག་ལག་ཁང་དུ་བཞུགས་ནས་བསྟན་བཅོས་མང་དུ་བསྒྱུར་བ་རྣམས་ཕྱིས་སུ་ལྷ་སའི་ཇོ་ཁང་དང་ར་མོ་ཆེའི་གཙུག་ལག་ཁང་དུ་འགྱུར་བཅོས་གནང་ཡོད།&nbsp; ཁོང་གིས་བསྒྱུར་བའི་བསྟན་བཅོས་ཉེར་དྲུག་བཀའ་བསྟན་ཁྲོད་དུ་བཞུགས་ཡོད།</span></p>'''@tibetan ;
	.

told:_FormattedContent_Biography_Summary_8342
	gist:containedText """<p>
	<style type=\"text/css\">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 14.0px Kailasa}
span.s1 {font: 14.0px 'Times New Roman'}	</style>
</p>
<p class=\"p1\">
	བོད་ཀྱི་ལོ་རྒྱུས་ལྟར་ན་ཐོན་མི་སམྦྷོ་ཊ་ནི་དུས་རབས་བདུན་པའི་བོད་ཀྱི་བཙན་པོ་སྲོང་བཙན་སྒམ་པོའི་བློན་པོ་ཆེས་གཙོ་བོ་དང་།<span class=\"s1\"> </span>བོད་ཀྱི་ལོ་ཙཱ་བ་ཆེས་ཐོག་མ་ཡིན།<span class=\"s1\"> </span>ཁོང་གི་མཛད་རྣམ་ནི་སྒྲུང་གཏམ་གྱིས་གཡོག་ཡོད་ནའང་།<span class=\"s1\"> </span>ཁོང་ཉིད་བོད་ཡིག་གསར་བཟོ་མཛད་མཁན་ལ་བརྩི་བཞིན་ཡོད་ལ།<span class=\"s1\"> </span>གཞོན་པའི་དུས་ནས་བཟུང་རྒྱ་གར་དུ་ལེགས་སྦྱར་སློབ་ཏུ་ཕྱིན།<span class=\"s1\"> </span>གཞན་ཡང་བློན་པོ་མགར་དང་འགྲོགས་ཏེ་བལ་བོ་དང་རྒྱ་ནག་ལ་བལ་བཟའ་ཁྲི་བཙུན་དང་རྒྱ་མབཟའ་ཀོང་ཇོ་གཉིས་ཆོས་རྒྱལ་སྲོང་བཙན་སྒམ་པོའི་བཙུན་མོར་བསུ་རུ་ཕེབས་ཤིང་།<span class=\"s1\"> </span>བརྡ་སྤྲོད་པའི་བསྟན་བཅོས་དྲུག་མཛད་པ་ལས་གཉིས་ནི་དེང་སྐབས་ཀྱང་བོད་ཀྱི་བརྡ་སྤྲོད་གཞུང་གི་ཕྱི་མོར་ཆགས་ཡོད་པ་ཡིན།<span class=\"s1\">&nbsp;</span></p>"""@tibetan ;
	.

told:_FormattedContent_Biography_Summary_8343
	gist:containedText """<p>
	<style type=\"text/css\">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 12.0px Kailasa}
span.s1 {font: 12.0px 'Times New Roman'}	</style>
</p>
<p class=\"p1\">
	ཤེས་རབ་རྒྱལ་མཚནན་གྱིས་སྤྱི་ལོ<span class=\"s1\"> </span>༡༨༣༦<span class=\"s1\"> </span>ལོ་ནས<span class=\"s1\"> </span>༡༨༣༩<span class=\"s1\"> </span>ལོའི་བར་འབྲུག་རྗེ་མཁན་པོ་ཉེར་ལྔ་པའི་འགན་བཞེས་པ་དང་།<span class=\"s1\"> </span>ཀུན་བཟང་འོད་གསལ་གླིང་ཕྱག་བཏབ་ཅིང་།<span class=\"s1\"> </span>སྐྱིད་ཆུ་ལྷ་ཁང་རྒྱ་བསྐྱེད་གནང་།</p>"""@tibetan ;
	.

told:_FormattedContent_Biography_Summary_8355
	gist:containedText """<p>
	<style type=\"text/css\">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 12.0px Kailasa}
span.s1 {font: 12.0px 'Times New Roman'}	</style>
</p>
<p class=\"p1\">
	ཞབས་དྲུང་ཐུགས་སྤྲུལ་བཞི་པ་འཇིགས་མེད་ནོར་བུ་ནི་རྟེན་སྐྱ་བོ་ཡིན་ལ།<span class=\"s1\"> </span>ཁོང་གི་དུས་སྐབས་སུ་འབྲུག་རྗེ་མཁན་པོ་མང་པོས་དགེ་རྒན་དུ་བསྟེན་མྱོང་།</p>"""@tibetan ;
	.

told:_FormattedContent_Biography_Summary_8397
	gist:containedText """<p>
	<style type=\"text/css\">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 12.0px Kokonor}
span.s1 {font-kerning: none}
span.s2 {font: 12.0px 'Times New Roman'; font-kerning: none}	</style>
</p>
<p class=\"p1\">
	<span class=\"s1\">ཡེ་ཤེས་དངོས་གྲུབ་ནི་ཞབས་དྲུང་གསུང་སྤྲུལ་སྐུ་ཕྲེང་ལྔ་པ་ཡིན་ལ།</span><span class=\"s2\"> </span><span class=\"s1\">ལྷ་བཟོ་ཡང་གྲགས་ཆེན་ཞིག་ཡིན་པར་བཤད།</span><span class=\"s2\"> </span><span class=\"s1\">ཁོང་གིས་སྤྱི་ལོ</span><span class=\"s2\"> </span><span class=\"s1\">༡༩༠༣</span><span class=\"s2\"> </span><span class=\"s1\">ནས</span><span class=\"s2\"> </span><span class=\"s1\">༡༩༠༦</span><span class=\"s2\"> </span><span class=\"s1\">བར་སྡེ་སྲིད་ཀྱི་འགན་བཞེས་ཤིང་།</span><span class=\"s2\"> </span><span class=\"s1\">༡༩༡༥</span><span class=\"s2\"> </span><span class=\"s1\">ནས</span><span class=\"s2\"> </span><span class=\"s1\">༡༩༡༧</span><span class=\"s2\"> </span><span class=\"s1\">ལོའི་བར་བྱེས་མཁན་པོ་ང་གསུམ་པའི་འགན་བཞེས།</span><span class=\"s2\"> </span><span class=\"s1\">སྤ་གྲོ་གསང་ཆོས་འཁོར་གྱི་འདབས་སུ་ཀུན་དགའ་ཆོས་གླིང་ཕྱག་བཏབ།</span></p>"""@tibetan ;
	.

told:_FormattedContent_Biography_Summary_8472
	gist:containedText """<p>
	<style type=\"text/css\">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 14.0px Kailasa}
span.s1 {font: 14.0px 'Times New Roman'}	</style>
</p>
<p class=\"p1\">
	དུང་མཚོ་རས་པ་ཕྱི་མ་ནི་དུས་རབས་བཅོ་ལྔ་པའི་ནང་གི་གཏེར་སྟོན་ཞིག་ཡིན་ལ།<span class=\"s1\"> </span>དུས་རབས་བཅུ་བཞི་པའི་བཀའ་བརྒྱུད་ལུགས་ཀྱི་ཏེར་སྟོན་དུང་མཚོ་རས་པ་ཤེས་རབ་རྒྱལ་མཚན་གྱི་རྣམ་སྤྲུལ་དུ་གསུང་།<span class=\"s1\">&nbsp; </span>ཁོང་གིས་རྫོགས་ཆེན་ཡང་ཏི་ནག་པོ་གཏེར་ལས་བཞེས།</p>"""@tibetan ;
	.

told:_FormattedContent_Biography_Summary_8536
	gist:containedText """<p>
	<style type=\"text/css\">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 12.0px Kailasa}
span.s1 {font: 12.0px 'Lucida Grande'}
span.s2 {font: 12.0px Georgia}	</style>
</p>
<p class=\"p1\">
	མཁན་ཆེན་འཇམ་དབྱངས་རྒྱལ་མཚན་ནི་ཀཿཐོག་དགོན་པའི་སློབ་དཔོན་གྲགས་ཆེ་བ་ཞིག་ཡིན། བོད་གཞིས་བྱེས་གཉིས་སུ་༸རྒྱལ་མཆོག་སྐུ་ཕྲེང་བཅུ་བཞི་པ་དང་། ༸རྒྱལ་བ་ཀརྨ་པ་སྐུ་ཕྲེང་བཅུ་དྲུག་པ་གཙོས་པའི་སྐྱེས་ཆེན་དམ་པ་མང་པོ་དང་ཆོས་འབྲེལ་བསྐྱངས། ཁོང་གིས་དགོན་པའི་གདན་རབས་དང་སློབ་དཔོན་མང་པོའི་རྣམ་ཐར་འཁོད་པའི་ཀཿཐོག་དགོན་གྱི་ལོ་རྒྱུས་ཧྲག་བསྡུས་ཤིག་བརྩམས།</p>"""@tibetan ;
	.

told:_FormattedContent_Biography_Summary_8538
	gist:containedText '''<p>
	<style type="text/css">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 14.0px Kailasa}
span.s1 {font-kerning: none}
span.s2 {font: 14.0px Calibri; font-kerning: none}	</style>
</p>
<p class="p1">
	<span class="s1">ལས་རབ་གླིང་པའམ་</span><span class="s1">མཚན་ཡོངས་གྲགས་གཏེར་ཆེན་བསོད་རྒྱལ་</span><span class="s1">ཞེས་ཞུ་བ་ཁོང་ནི་ཁམས་ཁུལ་གྱི་གསང་སྔགས་རྙིང་མའི་གཏེར་ཆེན་མཚན་སྙན་ཆེ་བ་ཞིག་ཡིན།</span><span class="s2"> </span><span class="s1">༸རྒྱལ་དབང་སྐུ་ཕྲེང་བཅུ་གསུམ་པ་</span><span class="s1">སོགས་དུས་རབས་ཉི་ཤུ་པའི་སྐྱེས་ཆེན་མང་པོའི་བཤེས་གཉེན་མཛད།</span><span class="s2"> </span><span class="s1">ཁོང་གིས་གཏེར་ནས་གདན་དྲངས་པའི་གཏེར་ཆོས་གསུང་པོད་ཉི་ཤུ་ལྷག་བཞུགས།</span></p>'''@tibetan ;
	.

told:_FormattedContent_Biography_Summary_8539
	gist:containedText """<p>
	<style type=\"text/css\">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 12.0px Kailasa}
span.s1 {font: 12.0px 'Times New Roman'}	</style>
</p>
<p class=\"p1\">
	རྒྱལ་སྲས་བསོད་ནམས་ལྡེའུ་བཙན་ནི་ཀློང་གསལ་སྙིང་པོའི་གདུང་སྲས་དང་ཀཿཐོག་དགོན་གྱི་རྙིང་མའི་བླ་མ་རིག་འཛིན་བདུད་འདུལ་རྡོ་རྗེའི་སྤྲུལ་སྐུ་ཡིན་ལ།<span class=\"s1\"> </span>ཁོང་གི་སྤྲུལ་སྐུ་ནི་དྲི་མེད་ཞིང་སྐྱོང་སྐུ་ཕྲེང་དང་པོ་ཡིན།</p>"""@tibetan ;
	.

told:_FormattedContent_Biography_Summary_8543
	gist:containedText """<p>
	<style type=\"text/css\">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 12.0px Kokonor}
