span.s3 {font: 12.0px Arial; font-kerning: none; color: #1255cc}	</style>
</p>
<p class="p1">
	<span class="s1">ལྕགས་རྭ་སྤྲུལ་སྐུ་སྐུ་ཕྲེང་བདུན་པ་ངག་དབང་དཔལ་ལྡན་རྒྱལ་མཚན་ཆོས་ཀྱི་དབང་ཕྱུག་</span><span class="s1">ནི་ཆབ་མདོ་བྱམས་པ་གླིང་དགོན་པའི་</span><span class="s2">()</span><span class="s1">མཁན་པོ་ཞི་བ་ལྷ་སྐུ་ཕྲེང་བཞི་པ་</span><span class="s1">དང་།</span><span class="s2"> </span><span class="s1">དཀོན་རྡོར་སྤྲུལ་སྐུ་སྐུ་ཕྲེང་གསུམ་པ་</span><span class="s1">གཉིས་ཀྱི་སློབ་མ་ཡིན།</span><span class="s2"> </span><span class="s1">ཁོང་ལྷ་སའི་ཉེ་འགྲམ་གྱི་སེ་ར་དགོན་པར་</span><span class="s1">གསན་བསམ་སློབ་གཉེར་གནང་།</span><span class="s2"> </span><span class="s1">༸རྒྱལ་མཆོག་སྐུ་ཕྲེང་བརྒྱད་པའི་</span><span class="s1">དྲུང་ནས་ཆོས་མང་དུ་གསན།</span></p>'''@tibetan ;
	.

told:_FormattedContent_Biography_Summary_13099
	gist:containedText '''<p>
	<style type="text/css">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 12.0px Kailasa}
span.s1 {font-kerning: none}
span.s2 {font: 12.0px Arial; font-kerning: none}	</style>
</p>
<p class="p1">
	<span class="s1">ལྕགས་ར་སྤྲུལ་སྐུ་སྐུ་ཕྲེང་བརྒྱ</span><span class="s2"> </span><span class="s1">ད་པ་</span><span class="s1">ངག་དབང་བསྟན་པའི་འབྱུང་</span><span class="s2"> </span><span class="s1">གནས་འཕྲིན་ལས་ཆོས་ཀྱི་རྒྱལ་མཚན་</span><span class="s1">ནི་སྐུ་རབས་གོང་མ་རྣ</span><span class="s2"> </span><span class="s1">མས་དང་མི་འདྲ་བར་མངོན་ཤེས་དང་རྟོ</span><span class="s2"> </span><span class="s1">གས་པ་ལྡན་པའི་གསང་སྔགས་ཀྱི་གྲུ</span><span class="s2"> </span><span class="s1">བ་པ་འཛིན་པའི་ཉམས་ལེན་པ་ཞིག་ཡི</span><span class="s2"> </span><span class="s1">ན་པར་བཤད།</span><span class="s2"> </span><span class="s1">ཕྱི་ལོ་༡༩༡༢</span><span class="s2"> </span><span class="s1">ལོར་ཆབ་མདོ་དགོན་པ་</span><span class="s1">མེས་འཇིགས་པའི་དོན་རྐྱེ</span><span class="s2"> </span><span class="s1">ན་རྣམས་ཁོང་གིས་སྔོན་ཚུད་ནས་ལུ</span><span class="s2"> </span><span class="s1">ང་བསྟན་མཛད་ཡོད་པར་གྲགས།</span><span class="s2"> </span><span class="s1">འཕགས་པ་ལྷ་སྐུ་ཕྲེང་བཅུ་པ</span><span class="s1">སྐུ་ན་ཕྲ་བའི་སྐབས་ཁོང་ནས་</span><span class="s2"> </span><span class="s1">ཆབ་མདོ་ཁུལ་གྱི་ཆབ་སྲིད་ཀྱི་</span><span class="s2"> </span><span class="s1">འགན་དབང་ཡུན་ཙམ་བཞེས།</span><span class="s2"> </span><span class="s1">ལྕགས་ར་སྤྲུལ་སྐུ་སྐུ་ཕྲེང་རིམ་</span><span class="s2"> </span><span class="s1">བྱོན་རྣམས་ཕྱག་ན་རྡོ་རྗེའི་རྣམ་</span><span class="s2"> </span><span class="s1">སྤྲུལ་ཡིན་ཞེས་གྲགས།</span></p>'''@tibetan ;
	.

