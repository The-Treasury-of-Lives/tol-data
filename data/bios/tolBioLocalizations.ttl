span.s1 {font-kerning: none}
span.s2 {font: 12.0px Calibri; font-kerning: none}	</style>
</p>
<p class="p1">
	<span class="s1">ཕ་དམ་པ་སངས་རྒྱས་</span><span class="s1">ནི་བོད་དུ་ཤེར་ཕྱིན་དང་།</span><span class="s2"> </span><span class="s1">ཕྱག་རྒྱ་ཆེན་མོ།</span><span class="s2"> </span><span class="s1">དེ་བཞིན་ཞི་བྱེད་གཅོད་ཀྱི་གདམས་པར་གྱུར་པའི་ཆོས་སྐོར་ཁག་གཅིག་འཆད་སྤེལ་མཛད་ཅེས་ཡོངས་སུ་གྲགས་པའི་ནང་པའི་གྲུབ་ཆེན་ཞིག་ཡིན།</span><span class="s2"> </span><span class="s1">ཁོང་ཞི་བྱེད་གཅོད་ཀྱི་ལུགས་སུ་གཏོགས་པར་བཞེད་ཅིང་།</span><span class="s2"> </span><span class="s1">ལུགས་ཁག་གཅིག་གིས་ཁོང་ཞི་བྱེད་གཅོད་ཀྱི་སྲོལ་འབྱེད་མ་གཅིག་ལབ་ཀྱི་སྒྲོན་མའི་</span><span class="s1">བླ་མ་ཡིན་ཞེས་ཀྱང་བརྗོད།</span><span class="s2">&nbsp;</span></p>'''@tibetan ;
	.

told:_FormattedContent_Biography_Summary_2521
	gist:containedText """<p>
	<style type=\"text/css\">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 12.0px Kailasa}
span.s1 {font: 12.0px 'Times New Roman'}	</style>
</p>
<p class=\"p1\">
	རོང་བོ་གྲུབ་ཆེན་སྐུ་ཕྲེང་བདུན་པ་བློ་བཟང་འཕྲིན་ལས་ལུང་རྟོགས་རྒྱ་མཚོ་ནི་ཨ་མདོའི་རོང་བོ་དགོན་ཆེན་དུ་བཞུགས་པའི་དགེ་ལུགས་པའི་བླ་མ་ཞིག་ཡིན་ལ།<span class=\"s1\"> </span>ཁོང་གིས་བླ་བྲང་བཀྲ་འཁྱིལ་དུ་ཐོས་བསམ་མཛད།</p>"""@tibetan ;
	.

told:_FormattedContent_Biography_Summary_2523
	gist:containedText
		'''<p>
	<style type="text/css">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 12.0px Kailasa; color: #000000}	</style>
</p>
<p class="p1">
	ངག་དབང་ཆོས་ཀྱི་རྒྱལ་མཚན་ནི་དགའ་ལྡན་ཁྲི་ཐོག་སོ་བཞི་པ་ཡིན་ཞིང་། ཕྱི་ལོ་༡༦༢༧ ནས་༡༦༢༩ བར་ཁྲི་པ་མཛད། ཁོང་དགའ་ལྡན་ཁྲི་ཐོག་བཅུ་དགུ་པའི་ཡང་སྲིད་ཡིན་པར་བཞེད། ལྷ་སར་སློབ་གཉེར་གནང་སྟེ་རྒྱུད་སྨད་དང་དགའ་ལྡན་བྱང་རྩེ་བཅས་སུ་སློབ་དཔོན་མཛད། ཁོང་ཁྲི་པ་གནང་བའི་རིང་དགའ་ལྡན་དུ་བཞུགས་པའི་རྗེ་ཙོང་ཁ་པ་ཆེན་པོའི་དངུལ་གདུང་རིན་པོ་ཆེར་གསེར་གྱི་རྒྱ་ཕིབས་ཤིག་གསར་དུ་བཞེངས།</p>'''@tibetan ,
		"""<p>
	阿旺曲吉杰参于1627-1629年担任第三十四任甘丹赤巴，被认为是第十九任甘丹赤巴的转世。他曾在拉萨学习，并在下密院和甘丹绛孜学院担任教师。在任赤巴期间，他监督给甘丹寺宗喀巴的银制灵塔建造了金顶。</p>"""@chinese
		;
	.

told:_FormattedContent_Biography_Summary_2527
	gist:containedText """<p>
	<style type=\"text/css\">
