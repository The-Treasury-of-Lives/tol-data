told:_FormattedContent_Biography_Summary_13123
	gist:containedText """<p>
	<style type=\"text/css\">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 12.0px Kailasa}
span.s1 {font: 12.0px 'Times New Roman'}	</style>
</p>
<p class=\"p1\">
	པད་ཚལ་གླིང་སྐུ་ཕྲེང་གཉིས་པ་འཇིགས་མེད་བསྟན་པའི་རྒྱལ་མཚན་ནི་འབྲུག་ཡུལ་གྱི་སྒྲུབ་ཐོབ་རྣམ་རྒྱལ་ལྷུན་གྲུབ་ཀྱི་སྤྲུལ་སྐུ་ཡིན།<span class=\"s1\">&nbsp;</span></p>"""@tibetan ;
	.

told:_FormattedContent_Biography_Summary_13124
	gist:containedText """<p>
	<style type=\"text/css\">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 14.0px Kailasa}
span.s1 {font: 14.0px 'Times New Roman'}	</style>
</p>
<p class=\"p1\">
	མཁས་གྲུབ་འཇིགས་མེད་ཀུན་གྲོལ༼༡༧༥༠<span class=\"s1\">—</span>༡༨༢༥༽ནི་འབྲུག་ཡུལ་ཀྱི་རྙིང་མའི་བླ་མ་ཞིག་ཡིན་ལ།<span class=\"s1\"> </span>སྐུ་ན་ཕྲ་དུས་འབྲུག་པ་བཀའ་བརྒྱུད་ལ་སློབ་གཉེར་མཛད་ཅིང་།<span class=\"s1\"> </span>ཕྱིས་སུ་འཇིགས་མེད་གླིང་པའི་སློབ་མར་གྱུར་ཏེ་འབྲུག་ཡུལ་དུ་ཀློང་ཆེན་སྙིང་ཐིག་སྤེལ་མཁན་གྱི་མི་སྣ་གཙོ་ཤོས་ཡིན།<span class=\"s1\"> </span>ཁོང་གིས་གདུང་བསམ་ཡོངས་ལ་དགོན་ཕྱག་བཏབ།</p>"""@tibetan ;
	.

told:_FormattedContent_Biography_Summary_13125
	gist:containedText """<p>
	<style type=\"text/css\">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 14.0px Kailasa}
span.s1 {font: 14.0px 'Times New Roman'}	</style>
</p>
<p class=\"p1\">
	ཧུམ་རལ་སྐུ་ཕྲེང་དང་པོ་ནམ་མཁའ་རྒྱལ་མཚན་ནི་ཧུམ་རལ་རྫོང་དུ་གདན་ས་བྱས་ཤིང་།<span class=\"s1\"> </span>དུས་རབས་བཅོ་ལྔ་དང་བཅུ་དྲུག་བར་གྱི་འབྲུག་ཡུལ་གྱི་འབྲུག་པ་བཀའ་བརྒྱུད་ཀྱི་བླ་མ་ཞིག་ཡིན་ལ།<span class=\"s1\"> </span>ཁོང་ནི་ཧུམ་རལ་དྲུང་དྲུང་རྒྱལ་མཆོག་གི་གདུང་སྲས་ཡིན།<span class=\"s1\">&nbsp;</span></p>"""@tibetan ;
	.

told:_FormattedContent_Biography_Summary_13126
	gist:containedText """<p>
	པད་ཚལ་གླིང་སྐུ་ཕྲེང་བཞི་པ་ཀུན་བཟང་འཕྲིན་ལས་རྣམ་རྒྱལ་ནི་འབྲུག་ཡུལ་གྱི་རྙིང་མའི་བླ་མ་གྲགས་ཆེན་ཞིག་ཡིན།</p>"""@tibetan ;
	.

told:_FormattedContent_Biography_Summary_13127
	gist:containedText """<p>
	<style type=\"text/css\">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 14.0px Kailasa}
span.s1 {font: 14.0px 'Times New Roman'}	</style>
</p>
<p class=\"p1\">
	ངག་དབང་བསྟན་འཛིན་རྒྱ་མཚོ་ནི་འབྲུག་ཡུལ་གྱི་བླ་མ་གྲགས་ཅན་ཞིག་ཡིན་ལ།<span class=\"s1\"> </span>ཤཱཀྱ་ཤྲཱི་ཡི་བུ་སློབ་ཡིན།<span class=\"s1\"> </span>འབྲུག་ཡུལ་དུ་ལོག་ནས་འཆད་ཉན་སྤེལ་བའི་སྔོན་དུ་ཁམས་སུ་ཐོས་བསམ་མཛད་པ་རེད།</p>"""@tibetan ;
	.

told:_FormattedContent_Biography_Summary_13128
	gist:containedText """<p>
	<style type=\"text/css\">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 14.0px Kailasa}
span.s1 {font: 14.0px 'Times New Roman'}	</style>
</p>
<p class=\"p1\">
	པད་གླིང་ཐུགས་སྲས་སྐུ་ཕྲེང་བཅུ་པ་ཐེག་མཆོག་བསྟན་པའི་རྒྱལ་མཚན་ནི་བོད་དུ་སྐུ་འཁྲུངས་ཤིང་།<span class=\"s1\"> </span>སྤྱི་ལོ<span class=\"s1\"> </span>༡༩༦༠<span class=\"s1\"> </span>ལོ་སྟེ་དགུང་ལོ་དགུའི་སྟེང་འབྲུག་ཡུལ་ལ་བྲོས་བྱོལ་དུ་ཕེབས།<span class=\"s1\"> </span>ཁོང་གིས་འབྲུག་ཡུལ་དུ་འབངས་དང་སྲིད་གཞུང་ལ་རིམ་གྲོ་སྒྲུབ་ཞིང་།<span class=\"s1\"> </span>ལུང་དང་མན་ངག་སོགས་གནང་བཞིན་བཞུགས།</p>"""@tibetan ;
	.

