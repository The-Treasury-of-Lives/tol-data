span.s1 {font-kerning: none}
span.s2 {font: 14.0px 'Times New Roman'; font-kerning: none}	</style>
</p>
<p class=\"p1\">
	<span class=\"s1\">ངག་དབང་ཀུན་དགའ་བཀྲ་ཤིས་ནི་ས་སྐྱ་ཁྲི་འཛིན་ཉེར་དགུ་པ་ཡིན་ལ།</span><span class=\"s2\"> </span><span class=\"s1\">སྤྱི་ལོ</span><span class=\"s2\"> </span><span class=\"s1\">༡༦༨༥</span><span class=\"s2\"> </span><span class=\"s1\">ལོ་ནས་སྤྱི་ལོ</span><span class=\"s2\"> </span><span class=\"s1\">༡༧༡༡</span><span class=\"s2\"> </span><span class=\"s1\">ལོའི་བར་གདན་ས་བསྐྱངས།</span></p>"""@tibetan ;
	.

told:_FormattedContent_Biography_Summary_4259
	gist:containedText '''<p class="p1">
	<span class="s1">༸</span>རྒྱལ་དབང་སྐུ་ཕྲེང་བཅུ་གཅིག་པ་མཁས་གྲུབ་རྒྱ་མཚོ་ནི། སྐུ་ཚེ་དགུང་ལོ་བཅོ་བརྒྱད་ལས་མ་བཞུགས། ཕྱི་ལོ་༡༧༤༢ ལོར་གསེར་ཁྲིར་ཕེབས་ཏེ་ཕོ་བྲང་པོ་ཏ་ལ་དང་རི་བོ་དགེ་ལྡན་པའི་གདན་ས་གསུམ་ལ་སློབ་གཉེར་ཚུལ་བཞིན་མཛད། པཎ་ཆེན་སྐུ་ཕྲེང་བདུན་པ་ལས་དགེ་ཚུལ་གྱི་སྡོམ་པ་བཞེས། ཁོང་གིས་ནོར་གླིང་སྐལ་བཟང་ཕོ་བྲང་གི་དབུ་གཡབ་གཟིམ་ཆུང་གསར་བཞེངས་མཛད། ཕྱི་ལོ་༡༨༤༩ ལོར་གཟིམ་ཆུང་སྒོ་དབྱེའི་དགའ་སྟོན་རྒྱ་ཆེར་བསྐྱངས་པས་དེ་ལས་དེང་སང་དབྱར་སྟོན་ནམ་ནོར་གླིང་ཞོ་སྟོན་ཞེས་པ་དེ་བྱུང་བར་གྲགས།</p>'''@tibetan ;
	.

told:_FormattedContent_Biography_Summary_4265
	gist:containedText
		'''<p>
	<style type="text/css">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 12.0px Kailasa; color: #000000}	</style>
</p>
<p class="p1">
	ཚུལ་ཁྲིམས་ཆོས་འཕེལ་ནི་དགའ་ལྡན་ཁྲི་ཐོག་སོ་གཉིས་པ་ཡིན་ཞིང་། ཕྱི་ལོ་༡༦༢༠ ནས་༡༦༢༣ བར་ཁྲི་པ་མཛད། བཀྲ་ཤིས་ལྷུན་པོ་དང་སེ་ར་བཅས་སུ་གདན་སའི་སློབ་གཉེར་གནང་། དེ་ནས་དགའ་ལྡན་བྱང་རྩེ་གྲྭ་ཚང་དུ་འཆད་ཉན་སློབ་དཔོན་དང་། རི་བོ་བདེ་ཆེན་དགོན་སོགས་ཀྱི་མཁན་པོ་མཛད། ལྕངས་ལོ་དགོན་པར་བཞུགས་ཏེ་ཕྱག་ལེན་དང་ཞབས་རིམ་ལེགས་པར་བསྐྱངས་པས་མཚན་སྙན་ཆེས་ཆེར་དར་ཞིང་མཚན་ཡང་ལྕངས་ལོ་ཅན་པ་ཞེས་གསོལ།</p>'''@tibetan ,
		"""<p>
	初称曲培于1620-1623年任第三十二任甘丹赤巴。他在札什伦布寺及色拉寺接受教育，并担任过甘丹绛孜学院的导师。他是包括日乌德钦寺等许多寺院的堪布 。由于其在江洛寺居住过，并在该寺以杰出的修行成就而出名，因而他被称作江洛坚巴。</p>"""@chinese
		;
	.

told:_FormattedContent_Biography_Summary_4272
	gist:containedText """<p>
	<style type=\"text/css\">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 14.0px Kailasa}
span.s1 {font: 14.0px 'Times New Roman'}	</style>
</p>
<p class=\"p1\">
	རྡོ་གྲུབ་ཆེན་སྐུ་ཕྲེང་གཉིས་པ་འཇིགས་མེད་ཕུན་ཚོགས་འབྱུང་གནས་ནི་རྡོ་མཁྱེན་བརྩེ་ཡེ་ཤེས་རྡོ་རྗེ་ཡིས་ཁོང་གི་རྩ་བའི་བླ་མ་དང་ཆོས་གྲོགས་འཇིགས་མེད་འཕྲིན་ལས་འོད་ཟེར་གྱི་སྤྲུལ་སྐུར་ངོས་བཟུང་ཞིང་།<span class=\"s1\"> </span>སྤྱི་ལོ<span class=\"s1\"> </span>༡༨༦༢<span class=\"s1\"> </span>ལོར་མགོ་ལོག་རྡོ་ལུང་དུ་རྡོ་གྲུབ་ཆེན་སྐུ་ཕྲེང་བྱོན་གྱི་གདན་ས་གཙང་ཆེན་དངོས་གྲུབ་དཔལ་འབར་གླིང་ཕྱག་བཏབ་པ་དང་།<span class=\"s1\"> </span>ཕྱིས་སུ་རྡོ་གྲུབ་ཆེན་སྐུ་ཕྲེང་རིམ་བྱོན་གྱིས་རྒྱ་བསྐྱེད་གནང་ནས་རྡོ་གྲུབ་ཆེན་དགོན་ཞེས་མིང་ཐོགས།<span class=\"s1\"> </span>ཕྱིས་སུ་དར་རྩེ་མདོ་རུ་ལྷ་འབྲུམ་འགོས་ཏེ་སྐུ་གཤེགས།<span class=\"s1\">&nbsp;</span></p>"""@tibetan ;
	.

told:_FormattedContent_Biography_Summary_4276
	gist:containedText
		'''<p>
	<style type="text/css">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 12.0px Kailasa; color: #000000}	</style>
</p>
<p class="p1">
	ཁྲི་ཆེན་དཀོན་མཆོག་ཆོས་འཕེལ་ནི་དགའ་ལྡན་ཁྲི་ཐོག་སོ་ལྔ་པ་ཡིན་ཞིང་། ཕྱི་ལོ་༡༦༢༩ ནས་༡༦༣༧ བར་ལོ་ངོ་དགུའི་རིང་ཁྲི་པ་མཛད། སྐྱིད་ཤོད་དགོན་སོགས་སུ་སློབ་གཉེར་གནང་། གསང་ཕུ་ར་བ་སྟོད་དང་། རྒྱུད་སྟོད། དེ་བཞིན་འབྲས་སྤུངས་བློ་གསལ་གླིང་། དགའ་ལྡན་ཤར་རྩེ་བཅས་སུ་འཆད་ཉན་སློབ་དཔོན་མཛད། ཁོང་༧རྒྱལ་དབང་སྐུ་ཕྲེང་བཞི་པའི་ཡོངས་འཛིན་དང་། དགའ་ལྡན་གསེར་ཁྲིར་མ་ཕེབས་པའི་གོང་དུ་རྒྱུད་སྟོད་དང་། རིན་ཆེན་གླིང་། གསང་ཕུ་ར་བ་སྟོད་སོགས་དགོན་པ་ཁག་གཅིག་གི་མཁན་པོའང་མཛད།</p>'''@tibetan ,
		"""<p>
	赤钦贡却曲培于1629-1637年九年间担任第三十五任甘丹赤巴。他曾在吉效寺等许多寺院学习，并在桑浦内邬托寺及上密院做导师，也在哲蚌洛色林和甘丹夏孜教学。 他是四世达赖喇嘛的老师，在没有成为甘丹赤巴以前，他是上密院、仁青林寺、桑浦内邬托以及许多其他寺院的堪布。&nbsp;</p>"""@chinese
		;
	.

told:_FormattedContent_Biography_Summary_4285
	gist:containedText '''<p>
	<style type="text/css">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 12.0px Kailasa}
span.s1 {font-kerning: none}
span.s2 {font: 12.0px Arial; font-kerning: none}	</style>
</p>
<p class="p1">
	<span class="s1">རྒྱ་ར་སྐུ་ཕྲེང་བདུན་པ་</span><span class="s1">འཇིགས་མེད་ཆོས་ཀྱི་དབང་ཕྱུ</span><span class="s2"> </span><span class="s1">ག་</span><span class="s1">ནི་ཞི་བ་ལྷ་སྐུ་ཕྲེང་</span><span class="s2"> </span><span class="s1">ལྔ་པ་</span><span class="s1">དང་།</span><span class="s2"> </span><span class="s1">ལྕགས་ར་སྤྲུལ་སྐུ་སྐུ་ཕྲེང་བདུ</span><span class="s2"> </span><span class="s1">ན་པ་</span><span class="s1">བཅས་རྣམ་གཉིས་ཀྱི་སློབ་མ་</span><span class="s2"> </span><span class="s1">ཡིན།</span><span class="s2"> </span><span class="s1">འབྲས་སྤུངས་དགོན་པར་</span><span class="s1">སློབ་གཉེར་གནང་།</span><span class="s2"> </span><span class="s1">ཁམས་ཁུལ་དུ་གྲུ་གུ་དགོན་</span><span class="s1">སོགས་དགོན་པ་ཁག་གཅིག་</span><span class="s2"> </span><span class="s1">གི་མཁན་པོ་མཛད།</span><span class="s2"> </span><span class="s1">འཕགས་པ་ལྷ་སྐུ་ཕྲེང་བཅུ་པའི་</span><span class="s1">ཡོངས་འཛིན་གནང་།</span></p>'''@tibetan ;
	.

told:_FormattedContent_Biography_Summary_4291
	gist:containedText '''<p class="p1">
	ཀུན་མཁྱེན་འཇམ་དབྱངས་མཁྱེན་བརྩེ་དབང་པོ་ནི། དུས་རབས་བཅུ་དགུ་པའི་བོད་བརྒྱུད་ནང་བསྟན་གྱི་བླ་མ་མཚན་སྙན་ཆེ་བ་ཞིག་སྟེ། ས་དགེ་བཀའ་རྙིང་བོན་དང་བཅས་པ་རིས་སུ་མ་ཆད་པའི་བླ་མ་བརྒྱ་ཕྲག་ཕྱེད་དང་གཉིས་ཀྱི་ཞབས་ལ་གཏུགས། དུས་རབས་བཅུ་དགུ་པའི་སྨད་ལ་ཁོང་གི་ཞལ་སློབ་ཏུ་བོད་མདོ་ཁམས་ཁུལ་གྱི་བླ་སྤྲུལ་སོགས་སྐྱེ་ཆེན་དམ་པ་གྲངས་ལས་འདས་པ་བྱོན།&nbsp; དཔལ་ས་སྐྱ་ངོར་གྱི་ཡན་ལག་ཏུ་གྲགས་པ་རྫོང་སར་དགོན་པ་རང་གི་གདན་ས་མཛད་དེ་དབུས་སུ་ལན་གཉིས་ཙམ་དང་མདོ་ཁམས་ཡུལ་གྲུ་ཁག་ལ་ལན་མང་ཞབས་ཀྱིས་བཅགས། འཇམ་མགོན་ཀོང་སྤྲུལ་དང་གཏེར་སྟོན་མཆོག་གྱུར་གླིང་པ་རྣམ་གཉིས་དང་ལྷན་དུ་རྒྱལ་བའི་བསྟན་པ་རིན་པོ་ཆེར་དག་ཐེར་ལེགས་བཅོས་སོགས་ཀྱི་བྱ་བ་རླབས་ཆེན་མཛད་པའི་སྨིན་འབྲས་དུས་ད་ལྟའང་ཚོར་ཐུབ་པ་ཡིན། ཁོང་ནས་འཇམ་མགོན་ཀོང་སྤྲུལ་གྱིས་མཛད་པའི་མཛོད་ཆེན་ལྔ་དང་། དེ་བཞིན་མཆོག་གྱུར་གླིང་པས་བཏོན་པའི་གཏེར་མ་ཕྱོགས་བསྒྲིགས་པར་སྐྲུན་སོགས་ཀྱི་ཐད་མཐུན་འགྱུར་རྒྱ་ཆེར་བསྒྲུབས། འཇམ་དབྱངས་མཁྱེན་བརྩེ་དབང་པོ་ནི་འཇམ་མགོན་ཀོང་སྤྲུལ་གྱིས་གཏེར་སྟོན་རྒྱལ་པོ་ལྔའི་ཐ་མར་བགྲངས།&nbsp;</p>'''@tibetan ;
	.

told:_FormattedContent_Biography_Summary_4302
	gist:containedText """<p>
	<style type=\"text/css\">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 14.0px Kokonor}
span.s1 {font-kerning: none}
span.s2 {font: 14.0px 'Times New Roman'; font-kerning: none}	</style>
</p>
<p class=\"p1\">
	<span class=\"s1\">ངག་དབང་ཡེ་ཤེས་ཐུབ་བསྟན་ནི་སོག་ཡུལ་ཁལ་ཁ་ཏཱ་ཁུ་རེ་དགོན་གྱི་མཁན་པོ་ཡིན་ལ།</span><span class=\"s2\"> </span><span class=\"s1\">ཁོང་གིས་ལྷ་སར་རྒྱལ་དབང་སྐུ་ཕྲེང་བཅུ་པ་སོགས་ལས་ཐོས་བསམ་མཛད།</span></p>"""@tibetan ;
	.

told:_FormattedContent_Biography_Summary_4309
	gist:containedText """<p>
	<style type=\"text/css\">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 12.0px Kailasa}
span.s1 {font: 12.0px 'Times New Roman'}	</style>
</p>
<p class=\"p1\">
	ཁྲི་བྱང་སྐུ་ཕྲེང་གསུམ་པ་བློ་བཟང་ཡེ་ཤེས་བསྟན་འཛིན་རྒྱ་མཚོ་ནི་དུས་རབས་ཉི་ཤུ་པའི་ཆེས་སྙན་གྲགས་ཅན་གྱི་དགེ་ལུགས་པའི་སློབ་དཔོན་ཞིག་ཡིན་ལ།<span class=\"s1\"> </span>ཁོང་ནི་ཕ་བོང་ཁ་ཡི་བུ་སློབ་ཅིག་ཡིན་ཞིང་།<span class=\"s1\"> </span>དེ་ཉིད་ལས་དགའ་ལྡན་སྙན་བརྒྱུད་དང་གཞན་ཡང་རྡོ་རྗེ་ཤུགས་ལྡན་གྱི་བསྙེན་སྒྲུབ་སོགས་ཆོས་སྐོར་དུ་མ་བསླབས།<span class=\"s1\"> </span>དོན་དམ་པར་དེང་གི་དགེ་ལུགས་པའི་བླ་མ་ཡོངས་ཀྱིས་ཁོང་ཉིད་དམ་ཁོང་གི་དངོས་སློབ་གང་རུང་ལས་དབང་ལུང་མན་ངག་སོགས་ཐོས་བསམ་མཛད་གནང་ཡོད་པ་རེད།</p>"""@tibetan ;
	.

told:_FormattedContent_Biography_Summary_4314
	gist:containedText '''<p class="p1">
	<span class="s1">༸</span>རྒྱལ་དབང་སྐུ་ཕྲེང་བཅུ་པ་ཚུལ་ཁྲིམས་རྒྱ་མཚོ་ནི། <span class="s1">༸</span>རྒྱལ་མཆོག་སྐུ་ཕྲེང་རིམ་བྱོན་གྱི་ཁོངས་ནས་སྐུ་རབས་བཞི་ཙམ་སྐུ་གཞོན་ནུའི་དུས་སུ་གློ་བུར་དགོངས་པ་ཆོས་དབྱིངས་སུ་གཤེགས་པའི་ཁོངས་ནས་གཉིས་པ་དེ་ཡིན། ཁོང་དགུང་ལོ་ཉེར་གཉིས་ཐོག་དགོངས་པ་ཆོས་དབྱིངས་སུ་ཐིམ།</p>'''@tibetan ;
	.

told:_FormattedContent_Biography_Summary_4354
	gist:containedText
		'''<p class="p1">
	མར་པ་ཆོས་ཀྱི་བློ་གྲོས་སམ་<span class="s1">ཡོངས་གྲགས་སུ་མར་པ་ལོ་ཙཱ་ཞེས་མཚན་དུ་གྲགས་པ་འདི་ནི།</span><span class="s2"> </span><span class="s1">བོད་བརྒྱུད་ནང་བསྟན་ལས་</span>བཀའ་བརྒྱུད་པའི་བསྟན་པའི་<span class="s3">སྲོལ་འབྱེད་དུ་ངོས་འཛིན་ཞུ་གི་ཡོད་</span><span class="s1">ཅིང་</span>།<span class="s2"> </span><span class="s1">སྔ་ཕྱིར་</span>རྒྱ་གར་དུ་ལན་གསུམ་ཙམ་ཕེབས་ཏེ་གྲུབ་ཆེན་ནཱ་རོ་པ་སོགས་ཀྱི་དྲུང་ནས་གདམས་པ་མང་དུ་<span class="s4">ཞུས་པར་གྲགས།</span><span class="s2"> </span>བོད་དུ་<span class="s1">ལོག་</span>རྗེས་<span class="s3">གཙོ་བོར་</span>ནཱ་རོ་ཆོས་དྲུག་དང་ཕྱག་རྒྱ་ཆེན་མོའི་གདམས་པ་རྒྱ་ཆེར་སྤེལ། <span class="s1">སློབ་མ་</span><span class="s3">གྲགས་ཆེ་ཤོས་</span><span class="s1">ནི་མི་ལ་རས་པ་ཡིན་ནོ།།</span></p>'''@tibetan ,
		"""<p>
	玛尔巴却吉洛追通称玛尔巴译师，被认为是藏传佛教噶举派的创始人。据说他三赴印度从师那若巴及其他大师。返藏后，他在诸多教法中致力于传播那若六法与大手印法。他最有名的弟子为米拉日巴。</p>"""@chinese
		;
	.

told:_FormattedContent_Biography_Summary_4358
	gist:containedText """<p>
	<style type=\"text/css\">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 14.0px Kokonor}
span.s1 {font-kerning: none}
span.s2 {font: 14.0px 'Times New Roman'; font-kerning: none}	</style>
</p>
<p class=\"p1\">
	<span class=\"s1\">འཇམ་མགོན་ཀོང་སྤྲུལ་ནི་བོད་ཀྱི་ལོ་རྒྱུས་སུ་མཁས་དབང་ཆེན་པོ་ཞིག་ལ་ངེས་འཛིན་བཞིན་ཡོད།</span><span class=\"s2\"> </span><span class=\"s1\">ཁོང་ནི་ཀརྨ་བཀའ་བརྒྱུད་ཀྱི་བླ་མ་ཞིག་དང་གྲུབ་མཐའ་རིས་མེད་ལ་དོན་གཉེར་བྱེད་མཁན་གྱི་མིག་དཔེ་ལྟ་བུ་ཞིག་ཡིན།</span><span class=\"s2\"> </span><span class=\"s1\">ཁོང་གིས་ས་སྐྱ་བླ་མ་འཇམ་དབྱངས་མཁྱེན་བརྩེའི་དབང་པོ་དང་རྙིང་མའི་གཏེར་སྟོན་མཆོག་གྱུར་གླིང་པ་གཉིས་དང་ཟུང་འབྲེལ་སྒོས་གནས་སྒོ་དང་གཏེར་སྒོ་མང་དུ་ཕྱེས་པ་རེད།</span><span class=\"s2\"> </span><span class=\"s1\">ཁོང་གི་གསུང་རྩོམ་ཁག་ལ་མཛོད་ཆེན་པོ་ལྔ་ཡོད་ལ།</span><span class=\"s2\"> </span><span class=\"s1\">དེ་རུ་བོད་བརྒྱུད་ནང་བསྟན་གྱི་རྣམ་བཞག་དང་ཆོ་ག་ཕྱག་ལེན་སོགས་བརྗོད་བྱ་མང་དུ་འདུ་ཞིང་།</span><span class=\"s2\"> </span><span class=\"s1\">ཉམས་ལ་ཉེ་བའི་བོད་བརྒྱུད་ནང་བསྟན་གྱི་ཕྱག་ལེན་མང་པོ་ཞིག་ཉར་ཚགས་བྱས་པ་རེད།</span><span class=\"s2\"> </span><span class=\"s1\">ཁོང་ནི་ཐོག་མར་སྡེ་དགེའི་དཔལ་སྤུངས་དགོན་དུ་བཞུགས་ཤིང་།</span><span class=\"s2\"> </span><span class=\"s1\">ཕྱིས་སུ་སྒྲུབ་སྡེ་ཙཱ་འདྲ་རིན་ཆེན་བྲག་ཕྱག་བཏབ་པས་དེ་ཉིད་ཁོང་གི་གདན་སར་གྱུར།</span><span class=\"s2\"> </span><span class=\"s1\">ཁོང་ཚེ་ལས་འདས་རྗེས་སྤྲུལ་སྐུའི་སྐུ་ཕྲེང་མི་འདྲ་བ་འགའ་བྱུང་ཡོད་དེ།</span><span class=\"s2\"> </span><span class=\"s1\">གཙོ་ཤོས་དཔལ་སྤུངས་དགོན་གྱི་འཇམ་མགོན་ཀོང་སྤྲུལ་སྐུ་ཕྲེང་རིམ་བྱོན་དང་།</span><span class=\"s2\"> </span><span class=\"s1\">རྫོགས་ཆེན་ཀོང་སྤྲུལ་སྐུ་ཕྲེང་རིམ་བྱོན།</span><span class=\"s2\"> </span><span class=\"s1\">འཛི་སྒར་ཀོང་སྤྲུལ་སྐུ་ཕྲེང་རིམ་བྱོན་སོགས་ཡོད།</span></p>"""@tibetan ;
	.

told:_FormattedContent_Biography_Summary_4368
	gist:containedText '''<p>
	<style type="text/css">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 12.0px Kailasa}
span.s1 {font-kerning: none}
span.s2 {font: 12.0px Calibri; font-kerning: none}	</style>
</p>
<p class="p1">
	<span class="s1">རྗེ་ཕག་མོ་གྲུ་པའི་</span><span class="s1">ཐུགས་སྲས་སུ་བགྲངས་པ་རྒྱལ་བ་སྟག་ལུང་ཐང་པ་</span><span class="s1">ནི་སྟག་ལུང་བཀའ་བརྒྱུད་པའི་སྐྱེས་ཆེན་གཙོ་བོ་ཞིག་ཡིན།</span><span class="s2"> </span><span class="s1">ཁོང་གིས་ཕྱི་ལོ་༡༡༨༠</span><span class="s2"> </span><span class="s1">ལོར་སྟག་ལུང་ཐང་དགོན་པ་</span><span class="s1">ཕྱག་བཏབ།</span></p>'''@tibetan ;
	.

told:_FormattedContent_Biography_Summary_4372
	gist:containedText """<p>
	<style type=\"text/css\">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 12.0px Kailasa}
span.s1 {font: 12.0px 'Times New Roman'}	</style>
</p>
<p class=\"p1\">
	པད་གླིང་ཐུགས་སྲས་སྐུ་ཕྲེང་དང་པོ་ཟླ་བ་རྒྱལ་མཚན་ནི་པདྨ་གླིང་པའི་གདུང་སྲས་ཡིན་ལ།<span class=\"s1\"> </span>ཁོང་ནི་འབྲུག་ཡུལ་གྱི་རྙིང་མའི་བླ་མ་གྲགས་ཅན་ཞིག་ཡིན་ཅིང་།<span class=\"s1\"> </span>རྟ་མགྲིན་དང་ཤཱ་རིའི་བུ།<span class=\"s1\"> </span>ཨིན་དྲ་བྷུ་ཏི་བཅས་ཀྱི་རྣམ་སྤྲུལ་ཡིན་པར་གསུང་།<span class=\"s1\"> </span>ལྷུན་གྲུབ་བདེ་དབྱངས་དང་དགོངས་སྟོད་གསེར་གྱི་ལྷ་ཁང་སོགས་ཕྱག་བཏབ་ཅིང་།<span class=\"s1\"> </span>ཉིད་ཀྱི་གདུང་སྲས་རྒྱལ་སྲས་པདྨ་འཕྲིན་ལས་ནི་པདྨ་གླིང་པའི་བུ་སློབ་སྟེ་མཁན་ཆེན་ཚུལ་ཁྲིམས་དཔལ་འབྱོར་གྱི་སྤྲུལ་སྐུར་ངོས་བཟུང་པས།<span class=\"s1\"> </span>སྒང་སྟེང་སྐུ་ཕྲེང་དང་པོར་གྱུར་པ་རེད།</p>"""@tibetan ;
	.

told:_FormattedContent_Biography_Summary_4379
	gist:containedText """<p>
	<style type=\"text/css\">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 12.0px Kailasa}
span.s1 {font: 12.0px 'Times New Roman'}	</style>
</p>
<p class=\"p1\">
	སྒང་སྟེང་སྐུ་ཕྲེང་དང་པོ་རྒྱལ་སྲས་པདྨ་འཕྲིན་ལས་ནི་དུས་རབས་བཅུ་དྲུག་པའི་འབྲུག་ཡུལ་གྱི་རྙིང་མའི་བླ་མ་ཞིག་ཡིན་ལ།<span class=\"s1\"> </span>ཁོང་ནི་པདྨ་གླིང་པའི་ཚ་བོ་ཞིག་ཡིན་པ་དང་།<span class=\"s1\"> </span>པདྨ་གླིང་པའི་འཕྲིན་ལས་རྒྱུད་འཛིན་པ་ཡིན།<span class=\"s1\"> </span>ཁོང་གིས་དུས་རབས་བཅུ་དྲུག་པའི་དུས་མཇུག་ཏུ་སྒང་སྟེང་དགོན་ཕྱག་བཏབ།</p>"""@tibetan ;
	.

told:_FormattedContent_Biography_Summary_4380
	gist:containedText """<p>
	<style type=\"text/css\">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 14.0px Kokonor}
span.s1 {font-kerning: none}
span.s2 {font: 14.0px 'Times New Roman'; font-kerning: none}	</style>
</p>
<p class=\"p1\">
	<span class=\"s1\">རྟ་ཚག་རྗེ་དྲུང་སྐུ་ཕྲེང་དགུ་པ་ངག་དབང་བློ་བཟང་བསྟན་པའི་རྒྱལ་མཚན་ནི་ཁམས་སུ་སྐུ་འཁྲུངས་ཤིང་།</span><span class=\"s2\"> </span><span class=\"s1\">ལྷ་སའི་ཀུན་བདེ་གླིང་དང་འབྲས་སྤུངས་སྒོ་མང་གྲྭ་ཚང་དུ་ཐོས་བསམ་མཛད་དེ་ལྷ་རམས་དགེ་བཤེས་ཀྱི་མཚན་སྙན་ཐོབ།</span><span class=\"s2\"> </span><span class=\"s1\">ཁོང་གིས་རྒྱལ་དབང་སྐུ་ཕྲེང་བཅུ་གཅིག་པ་དང་གུང་ཐང་སྐུ་ཕྲེང་བཞི་པ་གཉིས་ལ་དཔེ་ཁྲིད་གནང་མྱོང་ལ།</span><span class=\"s2\"> </span><span class=\"s1\">རྟ་ཚག་སྐུ་ཕྲེང་བརྒྱད་པ་ནས་བཟུང་སྐུ་ཕྲེང་རིམ་ཕྲེང་རིམ་བྱོན་ལ་ཀུན་བདེ་གླིང་ཧུ་ཐོག་ཐུ་རུ་འབོད་པ་རེད།</span></p>"""@tibetan ;
	.

told:_FormattedContent_Biography_Summary_4402
	gist:containedText """<p>
	<style type=\"text/css\">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 14.0px Kailasa}
span.s1 {font: 14.0px 'Times New Roman'}	</style>
</p>
<p class=\"p1\">
	དངུལ་ཆུ་དབྱངས་ཅན་གྲུབ་པའི་རྡོ་རྗེ་ནི་བཀྲ་ཤིས་དགེ་འཕེལ་དགོན་དུ་བཞུགས་པའི་དགེ་ལུགས་པའི་མཁས་དབང་ཞིག་ཡིན་ལ།<span class=\"s1\"> </span>དངུལ་ཆུ་དྷརྨ་བྷ་དྲ་ཡི་བུ་སློབ་ཐུ་བོ་དང་དབོན་ཚ་ཡིན།<span class=\"s1\"> </span>ཁོང་ནི་བརྡ་སྤྲོད་དང་སྙན་ངག་ལ་མཁས་ཤིང་།<span class=\"s1\"> </span>ཁོང་གི་གསུང་རྩོམ་ཁ་ཤས་ནི་བོད་ཀྱི་བརྡ་སྤྲོད་པའི་ཚད་གཞིར་འཛིན།<span class=\"s1\"> </span>འཕགས་པ་ལྷ་སྐུ་ཕྲེང་དགུ་པ་སོགས་བུ་སློབ་ཀྱང་མང་དུ་བསྐྱངས།<span class=\"s1\">&nbsp;</span></p>"""@tibetan ;
	.

told:_FormattedContent_Biography_Summary_4425
	gist:containedText """<p>
	<style type=\"text/css\">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 14.0px Kailasa}
span.s1 {font: 14.0px 'Times New Roman'}	</style>
</p>
<p class=\"p1\">
	རྫ་དཔལ་སྤྲུལ་ཨོ་རྒྱན་འཇིགས་མེད་ཆོས་ཀྱི་དབང་པོ་ནི་ཀུན་བཟང་བླ་མའི་ཞལ་ལུང་གི་མཛད་པ་པོ་དང་།<span class=\"s1\"> </span>དུས་རབས་བཅུ་དགུ་པའི་ནང་དུ་ཀློང་ཆེན་སྙིང་ཐིག་སྤེལ་མཁན་གྱི་བླ་མ་གཙོ་ཤོས་ཡིན།<span class=\"s1\"> </span>ཁོང་ནི་ཁེངས་སྐྱུང་བྱེད་པར་དགའ་ཞིང་གཞུང་དྲང་པ།<span class=\"s1\"> </span>སྨྲ་ལྕེ་བདེ་བར་མ་ཟད།<span class=\"s1\"> </span>ཁོང་གི་བུ་སློབ་དང་།<span class=\"s1\"> </span>ཆོས་རྒྱུད་གྲུབ་མཐའ་བཞི་ཡི་དགེ་སློང་།<span class=\"s1\"> </span>མི་དྲག་དང་སྐུ་དྲག<span class=\"s1\"> </span>རོང་འབྲོག་སེར་སྐྱ་སུ་ལ་འཕྲད་ཀྱང་དམ་པའི་ཆོས་ཐབས་མཁས་ངང་འཆད་སྤེལ་མཛད་པར་མཁས་པས་༷ཤིན་ཏུ་སྙན་གྲགས་ཆེ།<span class=\"s1\">&nbsp;</span></p>"""@tibetan ;
	.

told:_FormattedContent_Biography_Summary_4469
	gist:containedText '''<p class="p1">
	<span class="s1">༸</span>རྒྱལ་དབང་སྐུ་ཕྲེང་དགུ་པ་ལུང་རྟོགས་རྒྱ་ཚོ་ནི་དགུང་ལོ་བཅུ་གཅིག་ལས་མ་བཞུགས། ཕྱི་ལོ་༡༨༠༥ ལོར་ཁམས་ཕྱོགས་སུ་འཁྲུངས། ཕྱི་ལོ་༡༨༠༨ ལ་གསེར་ཁྲིར་མངའ་གསོལ། ཕྱི་ལོ་༡༨༡༠ ལོར་ཁོང་སྐུ་ན་ཕྲ་བའི་དུས་ཕོ་བྲང་པོ་ཏ་ལ་ཉམས་གསོ་རྒྱ་ཆེར་མཛད། ཕྱི་ལོ་༡༨༡༥ ལོར་ཆོས་སྲིད་ཀྱི་ཐུགས་འགན་བཞེས་པའི་སྐུ་ནར་མ་སྨིན་པའི་སྔོན་ནས་སྐུ་མྱ་ངན་ལས་འདས། &nbsp;&nbsp;</p>'''@tibetan ;
	.

told:_FormattedContent_Biography_Summary_4478
	gist:containedText '''<p>
	<style type="text/css">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 14.0px Kailasa}
span.s1 {font-kerning: none}
span.s2 {font: 14.0px Calibri; font-kerning: none}	</style>
</p>
<p class="p1">
	<span class="s1">པད་གླིང་རྒྱལ་སྲས་</span><span class="s1">སམ་སྒང་སྟེང་སྤྲུལ་སྐུ་སྐུ་ཕྲེང་བརྒྱད་པ་ཨོ་རྒྱན་འཕྲིན་ལས་རྡོ་རྗེ་</span><span class="s1">ནི་སྒང་སྟེང་སྐུ་གོང་མའི་སྐུ་ཚ་དང་།</span><span class="s2"> </span><span class="s1">པད་གླིང་གསུང་སྤྲུལ་སྐུ་ཕྲེང་བརྒྱད་པ་བསྟན་འཛིན་ཆོས་ཀྱི་རྒྱལ་མཚན་</span><span class="s1">གྱི་སློབ་མ་ཡིན།</span><span class="s2"> </span><span class="s1">ཁོང་གིས་འབྲུག་ཐིམ་ཕུར་གུ་རུ་ལྷ་ཁང་</span><span class="s1">གསར་དུ་བཞེངས།</span></p>'''@tibetan ;
	.

told:_FormattedContent_Biography_Summary_4487
	gist:containedText
		'''<p>
	<style type="text/css">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 12.0px Kailasa; color: #000000}	</style>
</p>
<p class="p1">
	བློ་བཟང་ཆོས་འཕེལ་ནི་དགའ་ལྡན་ཁྲི་ཐོག་ཞེ་བདུན་པ་ཡིན་ཞིང་། ཕྱི་ལོ་༡༦༩༩ ནས་༡༧༠༡ བར་ཁྲི་པ་མཛད། དགའ་ལྡན་དང་། སེ་ར། རྒྱུད་སྟོད་བཅས་སུ་སློབ་གཉེར་གནང་། རྒྱུད་སྟོད་གྲྭ་ཚང་དུ་མཁན་པོ་སོགས་མཛད་འགན་དུ་མ་བཞེས། དེ་བཞིན་ལ་དྭགས་མཐོ་ལྡིང་དགོན་པའི་མཁན་པོ་མཛད། སྐབས་དེར་ཁོང་གིས་གསང་སྔགས་མངོན་སྤྱོད་ཀྱི་ལས་ལ་བརྟེན་ནས་སོག་པོའི་དམག་བཟློག་ཐུབ་པ་བྱུང་ཞེས་གྲགས། དེ་བཞིན་ལ་དྭགས་དང་རྒྱལ་ཁབ་གཞན་ཁག་གཅིག་གི་མཆོད་གནས་དང་དབུ་བླ་ཡང་མཛད།</p>'''@tibetan ,
		"""<p>
	洛桑曲培于1699至1701年担任第四十七任甘丹赤巴。他在甘丹、色拉和上密院学习，并在下密院担任过包括堪布等职位。他在拉达克的托林寺担任过堪布，并在此期间，被认为以密法抗拒了蒙古军队。他同时也是拉达克国王们及该地区其他王国的国师。</p>"""@chinese
		;
	.

told:_FormattedContent_Biography_Summary_4488
	gist:containedText
		"""<p>
	<style type=\"text/css\">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 12.0px Kailasa; color: #000000}
span.s1 {font: 12.0px 'Lucida Grande'}	</style>
</p>
<p class=\"p1\">
	དོན་གྲུབ་རྒྱ་མཚོ་ནི་དགའ་ལྡན་ཁྲི་ཐོག་ཞེ་བརྒྱད་པ་ཡིན་ཞིང་། ཕྱི་ལོ་༡༧༠༢<span class=\"s1\"> </span>ནས་༡༧༠༨<span class=\"s1\"> </span>བར་ཁྲི་པ་མཛད།<span class=\"s1\"> </span>འབྲས་སྤུངས་སྒོ་མང་དང་རྒྱུད་སྨད་གྲྭ་ཚང་དུ་སློབ་གཉེར་མཐར་ཕྱིན་པར་གནང་སྟེ་གྲྭ་ཚང་འདི་གཉིས་ཀྱི་མཁན་པོ་མཛད། དགའ་ལྡན་བྱང་རྩེའི་འཆད་ཉན་སློབ་དཔོན་དང་ཆོས་རྗེ་གནང་། དེ་ནས་དགའ་ལྡན་གྱི་གསེར་ཁྲིར་བཞུགས། ཁོང་༧རྒྱལ་དབང་སྐུ་ཕྲེང་དུག་པའི་ཡོངས་འཛིན་གནང་བའི་རྗེས་སུ་སོག་པོ་ལྷ་བཟང་ཁཱང་དང་འགལ་ཟླ་བྱུང་། ཁྲི་པའི་མཛད་འགན་གྲུབ་མཚམས་བྱ་ཡུལ་ཆོས་སྡེར་བཞུགས་ཏེ་སློབ་མ་མང་པོ་རྗེས་སུ་བཟུང་། ཁོང་གླིང་རིན་པོ་ཆེ་སྐུ་ཕྲེང་རིམ་བྱོན་གྱི་དང་པོར་བགྲངས།</p>"""@tibetan ,
		"""<p>
	顿月嘉措于1702至1708年担任第四十八任甘丹赤巴。他曾于哲蚌果芒及下密院学习，后担任这两寺院的堪布。他同时也是甘丹绛孜学院的导师和确杰，在那里他荣升为甘丹赤巴。他是六世达赖喇嘛的导师，因而与蒙古拉藏汗之间产生矛盾。在退休后，他驻锡加玉曲德寺，在那里教授弟子们并度过余生。他是林仁波切的第一世转世祖古。</p>"""@chinese
		;
	.

told:_FormattedContent_Biography_Summary_4489
	gist:containedText
		'''<p>
	<style type="text/css">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 12.0px Kailasa; color: #000000}	</style>
</p>
<p class="p1">
	བློ་བཟང་དར་རྒྱས་ནི་དགའ་ལྡན་ཁྲི་ཐོག་ཞེ་དགུ་པ་ཡིན་ཞིང་། ཕྱི་ལོ་༡༧༠༨ ནས་༡༧༡༤ བར་ཁྲི་པ་མཛད། ཅོ་ནེ་བཤད་སྒྲུབ་གླིང་དུ་སློབ་གཉེར་གནང་། རྗེས་སུ་སེ་ར་དགོན་པ་དང་རྒྱུད་སྟོད་གྲྭ་ཚང་དུ་གཞུང་ཆེན་མོར་གསན་བསམ་མཐར་ཕྱིན་པར་མཛད། ཁོང་སེ་ར་དགོན་པའི་དབུ་ཆོས་མཛད། དེ་ནས་རྒྱུད་སྟོད་གྲྭ་ཚང་གི་མཁན་པོར་ཕེབས། རྗེས་སུ་དགའ་ལྡན་ཤར་རྩེའི་མཁན་པོ་གནང་སྟེ་དགའ་ལྡན་གྱི་གསེར་ཁྲིར་མངའ་གསོལ། ཁོང་ཁྲི་པ་གནང་བའི་སྐབས་དགོན་པ་གསར་རྒྱག་དང་། སྐུ་འདྲ་གསར་བཞེངས། དར་ཆེན་སྒྲེང་འཛུགས་སོགས་བསྟན་པར་སྨན་པའི་བྱ་བ་རྒྱ་ཆེར་བསྒྲུབས།<span class="Apple-converted-space">&nbsp;</span></p>'''@tibetan ,
		"""<p>
	洛桑达杰于1708至1714年担任第四十九任甘丹赤巴。他在谢珠林学习，并在色拉及上密院学习。他是色拉寺的轨范师及维那师，后被提升至上密院的堪布。他同时也担任过甘丹夏孜学院的堪布，在那里他荣升为甘丹赤巴。在任职期间，他修建了新的建筑物，铸造了佛像并树立了巨大的祈愿旗杆。</p>"""@chinese
		;
	.

told:_FormattedContent_Biography_Summary_4490
	gist:containedText '''<style type="text/css">
p.p1 {margin: 0.0px 0.0px 0.0px 37.6px; text-indent: -0.9px; font: 12.0px Kailasa; color: #000000}</style>
<p class="p1">
	དཔལ་ལྡན་གྲགས་པ་ནི་དགའ་ལྡན་ཁྲི་ཐོག་ང་གཅིག་པ་ཡིན་ཞིང་། ཕྱི་ལོ་༡༧༢༡ ནས་༡༧༢༨ བར་ཁྲི་པ་ལོ་བདུན་མཛད། རྟ་ཚག་རྗེ་དྲུང་སྐུ་ཕྲེང་དྲུག་པ་དང་པཎ་ཆེན་སྐུ་ཕྲེང་གཉིས་པ་བཤེས་གཉེན་དུ་བསྟེན། འབྲས་སྤུངས་སྒོ་མང་དང་རྒྱུད་སྟོད་དུ་སློབ་གཉེར་གནང་། རྒྱུད་སྟོད་གྲྭ་ཚང་གི་མཁན་པོ་མཛད། དེ་ནས་ཤར་རྩེ་ཆོས་རྗེའི་ཁྲི་ལ་ཕེབས་ཏེ་རིམ་གྱིས་དགའ་ལྡན་གྱི་གསེར་ཁྲིར་མངའ་གསོལ། ༧རྒྱལ་དབང་སྐུ་ཕྲེང་བདུན་པའི་ཡོངས་འཛིན་གནང་། དེ་བཞིན་པཎ་ཆེན་སྐུ་ཕྲེང་གསུམ་པར་རབ་བྱུང་གི་སྡོམ་པ་འབོགས་གནང་མཛད། ཁོང་ནས་༧རྒྱལ་དབང་སྐུ་ཕྲེང་བདུན་པའི་བཀའ་དགོངས་ལྟར་ཨ་མདོ་ཁུལ་དུ་སྡེ་ཁག་ཕན་ཚུན་དབར་འཁྲུག་རྩོད་ཇི་བྱུང་ཞི་འགྲིག་འཆམ་མཐུན་ཐུབ་རྒྱུར་ཐུགས་འགན་གཙོ་བོ་བཞེས།</p>'''@tibetan ;
	.

told:_FormattedContent_Biography_Summary_4493
	gist:containedText """<p>
	ངག་དབང་ནམ་མཁའ་བཟང་པོ་ནི་དགའ་ལྡན་ཁྲི་ཐོག་ང་ལྔ་པ་ཡིན། ཕྱི་ལོ་༡༧༤༦ ལོར་ཁྲི་ལ་བཞུགས། སྐབས་དེར་བོད་ཀྱི་རྒྱལ་པོ་ཕོ་ལ་ནས་སྐུ་འདས་ནས་རིང་པོ་མ་ལོན་པ་ཁོང་གི་སྲས་ཞིག་གིས་དྲག་པོ་མངོན་སྤྱོད་ཀྱི་ལས་མཛད་དགོས་ཞུས་པར་མ་གསན་པའི་རྐྱེན་གྱིས་ཕྱི་ལོ་༡༧༥༠ ལོར་ཁྲི་པའི་གོ་གནས་ནས་ཕབ། དེ་སྔ་འབྲས་སྤུངས་སྒོ་མང་དང་རྒྱུད་སྟོད་གྲྭ་ཚང་དུ་སློབ་གཉེར་གནང་ནས་དེར་མཁན་པོ་མཛད། དེ་ནས་ཤར་རྩེ་ཆོས་རྗེའི་ཁྲིར་ཕེབས་ཏེ་རིམ་གྱིས་དགའ་ལྡན་གྱི་གསེར་ཁྲིར་མངའ་གསོལ། ཁོང་གི་ཡང་སྲིད་རིམ་བྱོན་ལ་ཡོངས་གྲགས་ཟམ་ཚ་གསེར་ཁྲི་སྤྲུལ་སྐུ་ཞེས་ཞུ་བ་ཡིན།</p>"""@tibetan ;
	.

told:_FormattedContent_Biography_Summary_4494
	gist:containedText """<p>
	བློ་བཟང་དྲི་མེད་ནི་དགའ་ལྡན་ཁྲི་ཐོག་ང་དྲུག་པ་ཡིན་ཞིང་། ཕྱི་ལོ་༡༧༥༠ ནས་༡༧༥༧ བར་ཁྲི་པ་མཛད། འབྲས་སྤུངས་བློ་གསལ་གླིང་དང་རྒྱུད་སྨད་གྲྭ་ཚང་དུ་སློབ་གཉེར་གནང་། གསང་སྔགས་མཁར་གྱི་མཁན་པོར་ཕེབས། ཚལ་དུ་འདུ་ཁང་གསར་པ་ཞིག་བཞེངས། ཁྲི་པའི་དུས་ཡུན་གྲུབ་མཚམས་སྟོད་བྱ་ཡུལ་ཆོས་སྡེར་བཞུགས་ཏེ་དེར་གསེར་ཟངས་ལས་གྲུབ་པའི་རྗེ་ཙོང་ཁ་པའི་སྐུ་འདྲ་སོགས་མཆོད་པའི་རྟེན་མང་པོ་བཞེངས།</p>"""@tibetan ;
	.

told:_FormattedContent_Biography_Summary_4524
	gist:containedText """<p>
	<style type=\"text/css\">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 12.0px Kailasa}
span.s1 {font: 12.0px 'Times New Roman'}	</style>
</p>
<p class=\"p1\">
	རོང་བོ་གྲུབ་ཆེན་སྐུ་ཕྲེང་བཞི་པ་བློ་བཟང་ཆོས་གྲགས་རྒྱ་མཚོ་ནི་ཨ་མདོ་རོང་བོ་དགོན་ཆེན་གྱི་ནང་པའི་མཁས་ཆེན་དམ་པ་ཞིག་ཡིན་ལ།<span class=\"s1\"> </span>ཁོང་གིས་ལྷ་སའི་དགའ་ལྡན་དགོན་དུ་ཐོས་བསམ་མཛད།</p>"""@tibetan ;
	.

told:_FormattedContent_Biography_Summary_4535
	gist:containedText
		'''<p>
	<style type="text/css">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 12.0px Kailasa; color: #000000}	</style>
</p>
<p class="p1">
	ཡེ་ཤེས་བཟང་པོ་ནི་འབྲས་སྤུངས་དགོན་དུ་སློབ་གཉེར་མཛད་པའི་རི་བོ་དགེ་ལུགས་པའི་བླ་མ་ཞིག་ཡིན། ཁོང་ནས་འབྲས་སྤུངས་དགོན་དུ་གླིང་སྲས་དགེ་བཤེས་ཞེས་པའི་སློབ་གཉེར་གྱི་རིམ་པ་གསར་པ་ཞིག་གཏན་འབེབས་མཛད། དགའ་ལྡན་ཁྲི་ཐོག་བཅུ་པར་མངའ་གསོལ་ཞིང་། ཕྱི་ལོ་༡༤༩༣ ནས་༡༤༩༨ བར་ཁྲི་པ་མཛད།<span class="Apple-converted-space">&nbsp;</span></p>'''@tibetan ,
		"""<p>
	益西桑波曾于哲蚌寺学习，并在哲蚌寺设立了岭塞格西学位系统；1493到1498年间，他担任第十任甘丹赤巴。</p>"""@chinese
		;
	.

told:_FormattedContent_Biography_Summary_4611
	gist:containedText """<p>
	<style type=\"text/css\">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 14.0px Kailasa}
span.s1 {font: 14.0px 'Times New Roman'}	</style>
</p>
<p class=\"p1\">
	ཞབས་དཀར་ཚོགས་དྲུག་རང་གྲོལ་ནི་དུས་རབས་བཅུ་དགུ་པའི་དུས་འགོའི་ཨ་མདོ་ཡུལ་གྱི་རྙིང་མའི་བླ་མ་ཞིག་ཡིན་ལ།<span class=\"s1\"> </span>རེབ་གོང་གི་སྔགས་གྲྭ་ཞིག་ཏུ་ཐོས་བསམ་མཛད་ཅིང་།<span class=\"s1\"> </span>ལ་ཕྱི་དང་གངས་རིན་པོ་ཆེ་སོགས་བོད་ཀྱི་ཡུལ་གྲུ་གང་སར་ཕེབས་ཏེ་གནས་ཆེན་ཁག་ཏུ་སྒོམ་སྒྲུབ་མཛད།<span class=\"s1\"> </span>ཁོང་གི་རང་རྣམ་ནི་གོ་བདེ་ཞིང་རྣལ་འབྱོར་པ་ཁོང་གི་བྱིས་དུས་ནས་གྲུབ་ཐོབ་ཀྱི་བར་དུ་ཞིབ་བུར་བྲིས་ཡོད་པས།<span class=\"s1\"> </span>བོད་ཀྱི་རྩོམ་རིག་གྲགས་ཅན་ཞིག་ཏུ་གྱུར་ཡོད་ལ།<span class=\"s1\"> </span>ཁམས་དང་ཨ་མདོ་ཡུལ་གྱི་དུས་རབས་བཅུ་དགུ་པའི་བླ་མ་མང་པོ་ཞིག་གིས་ཁོང་ཉིད་དགེ་རྒན་དུ་བསྟེན་མྱོང་།<span class=\"s1\">&nbsp;</span></p>"""@tibetan ;
	.

told:_FormattedContent_Biography_Summary_4626
	gist:containedText
		'''<p class="p1">
	གནུབས་ཆེན་སངས་རྒྱས་ཡེ་ཤེས་ནི།<span class="s1"> </span>སློབ་དཔོན་པདྨ་སཾབྷཱ་བའི་ཐུགས་སྲས་<span class="s2">རྗེ་</span><span class="s3">འབངས་ཉེར་ལྔའི་གྲས་ཤིག་ཡིན་ཅིང་</span>།<span class="s1"> </span>བོད་སིལ་བུར་ཐོར་བ་ནས་བསྟན་པ་ཕྱི་དར་མ་ཤར་བའི་བར་གྱི་<span class="s2">སྨག་རུམ་གྱི་དུས་སྐབས་དེའི་ནང་འཚོ་བཞུགས་གནང་མྱོང་བའི</span>་རྙིང་མའི་སློབ་དཔོན་གལ་ཆེན་ཞིག་ཡིན།<span class="s1"> </span>སྔ་འགྱུར་རྙིང་མ་བཀའ་མའི་ལུགས་སུ་ཁོང་དང་།<span class="s1"> </span>གཉགས་ཛྙཱན་ཀུམཱར།<span class="s1"> </span>ཟུར་ཆེན་ཤཱཀྱ་འབྱུང་གནས་བཅས་ལ་བཀའ་བབ་རྣམ་གསུམ་ཞེས<span class="s3">་གསུང་སྲོལ་ཡོད་པ་ལས།</span><span class="s4"> </span><span class="s3">ཁོང་ནི་བཀའ་བབ་གཉིས་པར་གསུང་།</span><span class="s1"> </span><span class="s5">དེ་ཡང་</span>སློབ་དཔོན་པདྨ་འབྱུང་གནས<span class="s5">་སོགས་ལས་རྒྱུད་སྡེ་མང་པོའི་</span><span class="s2">དབང་ལུང་ནོད་</span><span class="s5">ཅིང་།</span><span class="s6"> </span><span class="s5">ཁྱད་པར་དུ་</span>རྒྱ་གར་དང་།<span class="s1"> </span>བལ་ཡུལ།<span class="s1"> </span><span class="s2">བྲུ་ཤ་</span><span class="s5">བཅས་སུ་</span><span class="s2">སློབ་གཉེར་གནང་མྱོང</span><span class="s5">་ཡོད།</span><span class="s1"> </span>ཁོང་གིས་<span class="s2">མ་ཧཱ་</span><span class="s5">ཡོ་གའི་རྒྱུད་ཀྱི་རྩ་བ་</span>སངས་རྒྱས་ཐམས་ཅད་ཀྱི་དགོངས་པ་འདུས་པའི་མདོའི་དཀའ་འགྲེལ་མུན་པའི་གོ་ཆ་སོགས་མཛད་པ་མ་ཟད།<span class="s1"> </span>ད་ལྟ་རྙིང་མ་རྒྱུད་འབུམ་ནང་བཞུགས་པའི་རྒྱུད་སྡེ་ཁག་ཅིག་ཀྱང་<span class="s5">ཁོང་གི་སྒྱུར་ཡིན་ནོ།།</span></p>'''@tibetan ,
		"""<p>
	努钦桑杰耶喜是莲花生的二十五位弟子之一。他是活跃于所谓的“黑暗时期”，即吐蕃王朝衰落与佛教后弘期之间，西藏的重要宁玛派大师。他与涅智童尊者及素钦释迦迥乃都是宁玛派亲承语旨授传的关键人物，他在三位中是第二位接受密续亲承语旨传承的人。努钦于莲花生及其他多名大师处受取密续灌顶。据说他在印度、尼泊尔以及吉尔吉特求学过。他撰写了关于大瑜伽根续经典《诸佛密意集经》的著名论释《密意集经广注·除暗武器》，还有一些译文收录于宁玛密续集《十万部续》中。</p>"""@chinese
		;
	.

told:_FormattedContent_Biography_Summary_4631
	gist:containedText '''<p>
	<style type="text/css">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 12.0px Kailasa}
span.s1 {font-kerning: none}
span.s2 {font: 12.0px Arial; font-kerning: none}	</style>
</p>
<p class="p1">
	<span class="s1">དངུལ་ཆུ་དརྨ་བྷདྲ་</span><span class="s1">ནི་ལུག་རྫི་ཁྱིམ་</span><span class="s2"> </span><span class="s1">ཚམ་དབུལ་པོ་ཞིག་གི་ནང་སྐུ་འཁྲུ</span><span class="s2"> </span><span class="s1">ངས།</span><span class="s2"> </span><span class="s1">རྗེས་སུ་ཁོང་ཕྱི་ལོ་བརྒྱ་ཕྲག་</span><span class="s2"> </span><span class="s1">བཅུ་དགུ་པའི་ནང་གི་རི་བོ་དགེ་ལུ</span><span class="s2"> </span><span class="s1">གས་པའི་མཁས་པའི་ཁོངས་ནས་གྲགས་ཆེ</span><span class="s2"> </span><span class="s1">་བ་ཞིག་ཏུ་གྱུར།</span><span class="s2"> </span><span class="s1">དངུལ་ཆུ་རི་ཁྲོད་</span><span class="s1">དང་།</span><span class="s2"> </span><span class="s1">བཀྲ་ཤིས་ལྷུན་པོ་དགོན་པ་</span><span class="s1">བཅས་སུ་སློབ་གཉེར་</span><span class="s2"> </span><span class="s1">གནང་།</span><span class="s2"> </span><span class="s1">སྐུ་ཚེ་ཕལ་ཆེ་བར་མཚམས་བསྙེན་བསྒྲུ</span><span class="s2"> </span><span class="s1">བས་ཁོ་ན་བསྡམས།</span><span class="s2"> </span><span class="s1">བརྩམ་ཆོས་ཉིས་བརྒྱ་ལ་ཉེ་བ་མཛད་</span><span class="s2"> </span><span class="s1">པ་རྣམས་ད་ཆ་གསུང་པོད་བཅུའི་ནང་</span><span class="s2"> </span><span class="s1">བཞུགས།</span></p>'''@tibetan ;
	.

told:_FormattedContent_Biography_Summary_4642
	gist:containedText '''<p>
	<style type="text/css">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 12.0px Kailasa}
span.s1 {font-kerning: none}
span.s2 {font: 12.0px Calibri; font-kerning: none}	</style>
</p>
<p class="p1">
	<span class="s1">ཤེས་རབ་རྒྱ་མཚོ་</span><span class="s1">ནི་ཨ་མདོ་ནས་ཡིན་པའི་ནང་པའི་མཁས་པ་ཞིག་ཡིན་ཞིང་།</span><span class="s2"> </span><span class="s1">རྒྱ་ནག་གོ་མིན་ཏང་དང་དེ་རྗེས་གུང་ཁྲན་ཏང་སྲིད་གཞུང་ཆེད་ཕྱག་ལས་གནང་མཁན་བོད་མི་ཐོག་མའི་གྲས་ཡིན།</span><span class="s2"> </span><span class="s1">དཔལ་ལྡན་འབྲས་སྤུངས་དགོན་པར་</span><span class="s1">སློབ་གཉེར་དང་།</span><span class="s2"> </span><span class="s1">དེ་ནས་༸རྒྱལ་མཆོག་སྐུ་ཕྲེང་བཅུ་གསུམ་པ་</span><span class="s1">ཆེན་པོའི་མཚན་ཞབས་གནང་།</span><span class="s2"> </span><span class="s1">རྗེས་སུ་ཁོང་ལ་བུ་སྟོན་རིན་ཆེན་གྲུབ་</span><span class="s1">ཀྱི་གསུང་འབུམ་དང་ལྷ་ས་བཀའ་འགྱུར་བཅས་ཞུ་དག་གནང་རྒྱུའི་བཀའ་སློབ་ཀྱང་ཕེབས།</span><span class="s2"> </span><span class="s1">༸རྒྱལ་མཆོག་སྐུ་ཕྲེང་བཅུ་གསུམ་པ་སྐུ་མྱ་ངན་ལས་འདས་པའི་རྗེས་རྒྱ་ནག་ཏུ་ཕེབས།</span><span class="s2"> </span><span class="s1">རྒྱ་ནག་ཆེས་མཐོའི་གཙུག་ལག་སློབ་གཉེར་ཁང་དུ་ལས་གནས་ཐོབ་མཁན་གྱི་བོད་མི་ཐོག་མ་དེ་ཆགས།</span><span class="s2"> </span><span class="s1">རྒྱ་ནག་དམར་པོས་སྲིད་དབང་བཟུང་བའི་རྗེས་ཁོང་ནས་མཐོ་རིམ་གོ་གནས་འདྲ་མིན་ཐོག་ཕྱག་ལས་གནང་།</span><span class="s2"> </span><span class="s1">དེ་བཞིན་ལྷོ་དང་ལྷོ་ཤར་ཨེ་ཤི་ཡའི་ཡུལ་ཕྱོགས་གང་སར་རྒྱ་ནག་མི་དམངས་སྤྱི་མཐུན་རྒྱལ་ཁབ་ཀྱི་སྐུ་ཚབ་ཀྱི་ངོ་བོར་ཕེབས།</span><span class="s2"> </span><span class="s1">མཐར་ཕྱི་ལོ་༡༩༦༨</span><span class="s2"> </span><span class="s1">ལོར་དམར་དམག་གིས་ཉེས་རྡུང་བཏང་སྟེ་ལོ་དེ་གའི་ནང་སྐུ་དགོངས་པ་རྫོགས།</span></p>'''@tibetan ;
	.

told:_FormattedContent_Biography_Summary_4659
	gist:containedText """<p>
	<style type=\"text/css\">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 12.0px Kokonor}
span.s1 {font-kerning: none}
span.s2 {font: 12.0px 'Times New Roman'; font-kerning: none}	</style>
</p>
<p class=\"p1\">
	<span class=\"s1\">སེང་ཕྲུག་པདྨ་བཀྲ་ཤིས་ནི་རྫོགས་ཆེན་དགོན་གྱི་ཤྲཱི་སེངྷ་གྲྭ་ཚང་གི་མཁན་རབས་དང་པོ་ཡིན་ལ།</span><span class=\"s2\"> </span><span class=\"s1\">ཁོང་གིས་རྒྱལ་མཚན་གཞན་ཕན་མཐའ་ཡས་ལ་རོགས་རམ་མཛད་དེ་གྲྭ་ཚང་དེ་ཉིད་ཕྱག་འདེབས་མཛད།</span><span class=\"s2\"> </span><span class=\"s1\">ཁོང་ནི་རྫོགས་ཆེན་གྲུབ་དབང་སྐུ་ཕྲེང་གསུམ་པ་ངེས་དོན་བསྟན་འཛིན་བཟང་པོ་དང་རྫོགས་ཆེན་དཔོན་སློབ་སྐུ་ཕྲེང་གཉིས་པ་པདྨ་གསང་སྔགས་བསྟན་འཛིན་གཉིས་ཀྱི་བུ་སློབ་ཡིན།</span></p>"""@tibetan ;
	.

told:_FormattedContent_Biography_Summary_4665
	gist:containedText """<p>
	<style type=\"text/css\">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 12.0px Kailasa}
span.s1 {font: 12.0px 'Times New Roman'}	</style>
</p>
<p class=\"p1\">
	བིས་པ་མི་ཕམ་ཟླ་བ་ནི་ཨ་མདོ་ཡུལ་གྱི་དགེ་ལུགས་དགོན་སྡེ་གཙོ་ཤོས་རོང་བོ་དགོན་ཆེན་གྱི་གདན་རབས་ཉེར་གཉིས་པ་ཡིན་ལ།<span class=\"s1\"> </span>ཁོང་གི་གསུང་རྩོམ་ལ་དེང་གི་ཆར་ཡང་གདེང་འཇོག་མཐོན་པོ་ཐོབ་ཡོད་པ་རེད།</p>"""@tibetan ;
	.

told:_FormattedContent_Biography_Summary_4669
	gist:containedText
		'''<p>
	<style type="text/css">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 12.0px Kailasa; color: #000000}	</style>
</p>
<p class="p1">
	ལེགས་པ་རྒྱལ་མཚན་ནི་རྗེ་ཙོང་ཁ་པའི་སློབ་མ་དང་། དགའ་ལྡན་དགོན་པའི་དབུ་མཛད་ཐོག་མ་དེ་ཡིན། ཁོང་དགའ་ལྡན་ཁྲི་ཐོག་བཞི་པར་མངའ་གསོལ་ཞིང་། ཕྱི་ལོ་༡༤༣༨ ནས་༡༤༥༠ བར་ལོ་བཅུ་གསུམ་ཙམ་ཁྲི་པ་མཛད།</p>'''@tibetan ,
		"""<p>
	列巴嘉措是宗喀巴大师的亲传弟子，也是甘丹寺第一任维那师。从1438年至1450年间，他担任第四任甘丹赤巴十三年。</p>"""@chinese
		;
	.

