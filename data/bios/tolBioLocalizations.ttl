span.s1 {font: 12.0px 'Times New Roman'}	</style>
</p>
<p class=\"p1\">
	ཞི་བ་ལྷ་སྐུ་ཕྲེང་དྲུག་པ་ངག་དབང་འཇིགས་མེད་མཁྱེན་རབ་བསྟན་འཛིན་འཕྲིན་ལས་ནི་ཁམས་སུ་སྐུ་འཁྲུངས།<span class=\"s1\"> </span>ཐོག་མར་ཁམས་སུ་ཐོས་བསམ་གྱི་འགོ་བཟུང་ཞིང་།<span class=\"s1\"> </span>ཕྱིས་སུ་སེ་ར་དགོན་དུ་སློབ་གཉེར་གནང་།<span class=\"s1\"> </span>སྤྱི་ལོ<span class=\"s1\"> </span>༡༩༠༡<span class=\"s1\"> </span>ལོ་ནས་སྤྱི་ལོ<span class=\"s1\"> </span>༡༩༡༩<span class=\"s1\"> </span>ལོའི་བར་གྱི་ལོ་ངོ་བཅོ་བརྒྱད་རིང་ཆབ་མདོ་བྱམས་པ་གླིང་དུ་གདན་རབས་ཉེར་བརྒྱད་པའི་འགན་བཞེས།</p>"""@tibetan ;
	.

told:_FormattedContent_Biography_Summary_3795
	gist:containedText '''<p>
	<style type="text/css">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 12.0px Kailasa}
span.s1 {font-kerning: none}
span.s2 {font: 12.0px Calibri; font-kerning: none}
span.s3 {font: 12.0px Arial; font-kerning: none; color: #1255cc}	</style>
</p>
<p class="p1">
	<span class="s1">ཞི་བ་ལྷ་སྐུ་ཕྲེང་བདུན་པ་ངག་དབང་འཕྲིན་ལས་བསྟན་འཛིན་མཁྱེན་རབ་</span><span class="s1">ནི་བོད་དབུས་དྭགས་ཡུལ་དུ་སྐུ་འཁྲུངས།</span><span class="s2"> </span><span class="s1">དང་ཐོག་ཁམས་ཕྱོགས་སུ་སློབ་གཉེར་གནང་།</span><span class="s2"> </span><span class="s1">དེ་ནས་ལྷ་སར་ཕེབས་ཏེ་སེ་ར་དགོན་པར་</span><span class="s1">དགེ་བཤེས་ཀྱི་མཚན་གནས་བཞེས།</span><span class="s2"> </span><span class="s1">ཆབ་མདོ་བྱམས་པ་གླིང་དགོན་པའི་</span><span class="s1">ཕྱག་མཛོད་གནང་སྟེ་ལོ་ངོ་བརྒྱ་ཕྲག་སྔོན་གྱི་འདོན་ཆོག་དང་དུས་མཆོད་རྣམས་བསྐྱར་གསོ་མཛད།</span><span class="s2"> </span><span class="s1">རིག་གནས་གསར་བརྗེའི་སྐབས་རྒྱ་དམར་དཔུང་ཤུགས་ཀྱིས་ཆབ་མདོ་བྱམས་པ་གླིང་གཏོར་བཤིག་བཏང་བའི་རྗེས་ཀྱི་སྐུ་ཚེའི་ལོ་རྒྱུས་དང་འདས་ཚེས་སོགས་ཀྱི་གནས་ཚུལ་ཇི་བཞིན་ཁ་གསལ་མ་ཐོབ།</span></p>'''@tibetan ;
	.

told:_FormattedContent_Biography_Summary_3877
	gist:containedText '''<p>
	<style type="text/css">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 12.0px Kailasa}
span.s1 {font-kerning: none}
span.s2 {font: 12.0px Calibri; font-kerning: none}	</style>
</p>
<p class="p1">
	<span class="s1">ཀློང་རྡོལ་བླ་མ་ངག་དབང་བློ་བཟང་</span><span class="s1">ནི་༸རྒྱལ་མཆོག་སྐུ་ཕྲེང་བདུན་པ་</span><span class="s1">དང་།</span><span class="s2"> </span><span class="s1">༸པཎ་ཆེན་སྐུ་ཕྲེང་དྲུག་པ།<font face="Calibri">&nbsp;</font></span><span class="s1">དེ་བཞིན་ཆབ་མདོ་བྱམས་པ་གླིང་</span><span class="s1">དུ་མཇལ་བའི་ཕུར་ལྕོག་སྐུ་ཕྲེང་དང་པོ་</span><span class="s1">བཅས་ཀྱི་སློབ་མ་ཡིན་ཞིང་།</span><span class="s2"> </span><span class="s1">གཞན་ཡང་སྐྱེས་ཆེན་དུ་མའི་ཞབས་ལ་གཏུགས་ཏེ་གསན་བསམ་མཛད།</span><span class="s2"> </span><span class="s1">སྐུ་ཚེ་ཕལ་ཆེ་བ་མཚམས་བསྙེན་སྒྲུབ་བསྟེན།</span><span class="s2"> </span><span class="s1">བོད་དང་སོག་ཡུལ་ཕྱོགས་གང་སར་ཕེབས་ཏེ་སློབ་མ་བརྒྱ་ཕྲག་དུ་མ་རྗེས་སུ་བཟུང་།</span><span class="s2"> </span><span class="s1">ཁོང་གིས་བརྩམ་ཆོས་གྲངས་གོ་དྲུག་ཙམ་བརྩམས་པའི་ཁོངས་ནས་ཕལ་ཆེ་བ་ད་ལྟ་མཇལ་རྒྱུ་ཡོད།</span></p>'''@tibetan ;
	.

told:_FormattedContent_Biography_Summary_3883
	gist:containedText """<p class=\"p1\">
	པདྨ་རང་གྲོལ་ནི་རེབ་གོང་སྔགས་མང་གྲས་སུ་ཅུང་སྙན་གྲགས་ཡོད་པའི་རྙིང་མའི་བླ་མ་ཞིག་ཡིན་ལ།<span class=\"s1\"> </span>ངག་དབང་དར་རྒྱས་དང་ཞབས་དཀར་ཚོགས་དྲུག་རང་གྲོལ་བུ་སློབ་ཡིན།<span class=\"s1\">&nbsp;</span></p>
<style type=\"text/css\">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 14.0px Kailasa}
span.s1 {font: 14.0px 'Times New Roman'}</style>"""@tibetan ;
	.

told:_FormattedContent_Biography_Summary_3889
	gist:containedText """<p>
	<style type=\"text/css\">
