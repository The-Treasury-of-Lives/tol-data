span.s1 {font-kerning: none}
span.s2 {font: 14.0px Calibri; font-kerning: none}	</style>
</p>
<p class="p1">
	<span class="s1">རྫོགས་ཆེན་དཔོན་སློབ་སྐུ་ཕྲེང་དང་པོ་ནམ་མཁའ་འོད་གསལ་</span><span class="s1">ནི་རྫོགས་ཆེན་གྲུབ་དབང་སྐུ་ཕྲེང་དང་པོ་པདྨ་རིག་འཛིན</span><span class="s1">གྱི་སློབ་མ་དང་།</span><span class="s2"> </span><span class="s1">རྫོགས་ཆེན་དགོན་པའི་</span><span class="s1">མཁན་རབས་གཉིས་པ་ཡིན།</span><span class="s2"> </span><span class="s1">ཕྱི་ལོ་༡༦༨༤</span><span class="s2"> </span><span class="s1">ལོར་རྫོགས་ཆེན་དགོན་པ་ཕྱག་འདེབས་རྒྱུའི་ཐད་ཞབས་འདེགས་གང་འོས་བསྒྲུབས།</span><span class="s2"> </span><span class="s1">ཁོང་གིས་རྫ་ཁོག་ཏུ་ལེགས་དགོན་གསང་ཆེན་སྨིན་གྲོལ་གླིང་</span><span class="s1">ཕྱག་བཏབ།</span></p>'''@tibetan ;
	.

told:_FormattedContent_Biography_Summary_10898
	gist:containedText """<p>
	<style type=\"text/css\">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 14.0px Kokonor}
span.s1 {font-kerning: none}
span.s2 {font: 14.0px 'Times New Roman'; font-kerning: none}	</style>
</p>
<p class=\"p1\">
	<span class=\"s1\">བཀྲ་ཤིས་རྣམ་རྒྱལ་ནི་ཀརྨ་པ་སྐུ་ཕྲེང་དྲུག་པས་ཏའི་སི་ཏུ་སྐུ་ཕྲེང་གཉིས་པར་ཐུགས་ཐག་བཅད་མོད།</span><span class=\"s2\"> </span><span class=\"s1\">དེང་སྐབས་ཁོང་གི་མཛད་རྣམ་ནི་ཉུང་ངུ་ཙམ་ལས་རྟོགས་མི་འདུག</span></p>"""@tibetan ;
	.

told:_FormattedContent_Biography_Summary_10957
	gist:containedText """<p>
	<style type=\"text/css\">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 12.0px Kokonor}
span.s1 {font-kerning: none}
span.s2 {font: 12.0px 'Times New Roman'; font-kerning: none}	</style>
</p>
<p class=\"p1\">
	<span class=\"s1\">བློ་བཟང་ཆོས་གྲགས་ནི་རོང་བོ་དགོན་ཆེན་གྱི་གདན་རབས་གཉིས་པ་ཡིན་ལ།</span><span class=\"s2\"> </span><span class=\"s1\">སྤྱི་ལོ</span><span class=\"s2\"> </span><span class=\"s1\">༡༦༤༡</span><span class=\"s2\"> </span><span class=\"s1\">ལོ་ནས</span><span class=\"s2\"> </span><span class=\"s1\">༡༦༧༠</span><span class=\"s2\"> </span><span class=\"s1\">བར་གདན་ས་བསྐྱངས།</span></p>"""@tibetan ;
	.

told:_FormattedContent_Biography_Summary_11003
	gist:containedText """<p>
	<style type=\"text/css\">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 14.0px Kokonor}
span.s1 {font-kerning: none}
span.s2 {font: 14.0px 'Times New Roman'; font-kerning: none}	</style>
</p>
<p class=\"p1\">
	<span class=\"s1\">དཔལ་ཡུལ་མཆོག་སྤྲུལ་སྐུ་ཕྲེང་གཉིས་པའམ་དར་ཐང་མཆོག་སྤྲུལ་འཇམ་དཔལ་དགྱེས་པའི་རྡོ་རྗེ་ནི་རྙིང་མའི་ལུགས་ཀྱི་དཔལ་ཡུལ་གྱི་ཆོས་རྒྱུན་དང་འབྲེལ་བའི་བླ་མ་གཙོ་ཤོས་ཤིག་ཡིན་ལ།</span><span class=\"s2\"> </span><span class=\"s1\">ཚུལ་ཁྲིམས་རྣམ་པར་དག་བས་སྙན་པ་ཆེ།</span><span class=\"s2\"> </span><span class=\"s1\">པད་ནོར་སྐུ་ཕྲེང་གསུམ་པ་དང་དཔལ་ཡུལ་ལུགས་ཀྱི་བླ་མ་གྲགས་ཆེན་སྐོར་ཞིག་གི་ཡོངས་འཛིན་དུ་བཞུགས་པ་རེད།</span><span class=\"s2\"> </span><span class=\"s1\">ཁོང་ཉིད་སྤྱི་ལོ</span><span class=\"s2\"> </span><span class=\"s1\">༡༩༥༨</span><span class=\"s2\"> </span><span class=\"s1\">ལོའམ་ཡང་ན</span><span class=\"s2\"> </span><span class=\"s1\">སྤྱི་ལོ</span><span class=\"s2\"> </span><span class=\"s1\">༡༩༥༩</span><span class=\"s2\"> </span><span class=\"s1\">ལོར་རྒྱ་ནག་གིས་བཙོན་དུ་བཟུང་ནས་སྐུ་གཤེགས་པ་རེད།</span></p>"""@tibetan ;
	.

told:_FormattedContent_Biography_Summary_11092
	gist:containedText """<p>
	<style type=\"text/css\">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 12.0px Kokonor}
span.s1 {font-kerning: none}
span.s2 {font: 12.0px 'Times New Roman'; font-kerning: none}	</style>
</p>
<p class=\"p1\">
	<span class=\"s1\">ཀརྨ་པ་སྐུ་ཕྲེང་བཅུ་གཉིས་པ་བྱང་ཆུབ་རྡོ་རྗེ་ནི་མཚུར་ཕུ་དགོན་དུ་གདན་སར་བཀོད་ཅིང་།</span><span class=\"s2\"> </span><span class=\"s1\">ཞྭ་དམར་སྐུ་ཕྲེང་བརྒྱད་པ་ལས་ཐོས་བསམ་མཛད།</span><span class=\"s2\"> </span><span class=\"s1\">དབུས་ཀྱི་དུས་འཁྲུག་གི་རྐྱེན་གྱིས་བཀའ་བརྒྱུད་ཀྱི་བླ་མ་མང་པོ་དང་ལྷན་དུ་བལ་བོ་དང་རྒྱ་གར་ཕྱག་ཕེབས་ཤིང་།</span><span class=\"s2\"> </span><span class=\"s1\">ཕྱིས་སུ་ཆིང་གོང་མ་ཡོང་ཀྲིན་གྱིས་གདན་དྲངས་ནས་རྒྱ་ནག་ཏུ་ཕེབས་པའི་ལམ་ཁར་སྐུ་གཤེགས།</span></p>"""@tibetan ;
	.

told:_FormattedContent_Biography_Summary_11114
	gist:containedText '''<p class="p1">
	<span class="s1">༸</span>རྒྱལ་དབང་སྐུ་ཕྲེང་གཉིས་པ་དགེ་འདུན་རྒྱ་མཚོ་ནི། རྗེ་དགེ་འདུན་གྲུབ་ཀྱི་ཡང་སྲིད་ཡིན། བོད་དབུས་གཙང་ཁུལ་གྱི་གདན་ས་གསུམ་ཀའི་མཁན་པོ་མཛད་དེ་རི་བོ་དགེ་ལུགས་པའི་བསྟན་པ་དར་སྤེལ་རྒྱ་ཆེར་མཛད། དེ་བཞིན་རང་གི་ཕ་མེས་ཀྱི་ཆོས་ལུགས་རྙིང་མ་དང་། ཤངས་པ་བཀའ་བརྒྱུད། ས་སྐྱ་སོགས་དང་འབྲེལ་བ་ཚུལ་བཞིན་བསྐྱངས། ཕྱི་ལོ་༡༥༣༠ ལོར་འབྲས་སྤུངས་དགོན་པར་གནས་ཁང་ཞིག་བདག་བཞེས་ཀྱིས་དེ་ལ་དགའ་ལྡན་ཕོ་བྲང་ཞེས་མཚན་འདོགས་པར་མཛད། དེ་ཉིད་རིམ་བཞིན་གོང་ས་ཏཱ་ལའི་བླ་མ་སྐུ་ཕྲེང་རིམ་བྱོན་གྱི་བླ་བྲང་དང་། དུས་ཕྱིས་<span class="s1">༸</span>རྒྱལ་དབང་ལྔ་པ་ཆེན་པོས་སྲིད་དབང་བཞེས་པའི་སྐབས་བོད་ཅན་ལྗོངས་ཀྱི་ཆབ་སྲིད་དབང་ཆའི་བསྟི་གནས་སུ་འགྱུར། ཁོང་གདན་སའི་མཁན་པོ་མཛད་པའི་དུས་དེར་གཙང་གི་བཀའ་བརྒྱུད་པའི་དཔོན་རིགས་ཁག་དང་དགེ་ལུགས་པའི་ཕྱོགས་ཀྱི་ལྷ་སའི་དཔོན་རིགས་དབར་འཁྲུགས་རྩོད་བྱུང་བའི་སྐབས་དང་འཁེལ།</p>'''@tibetan ;
	.

told:_FormattedContent_Biography_Summary_11258
	gist:containedText """<p>
	<style type=\"text/css\">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 12.0px Kokonor}
span.s1 {font-kerning: none}
span.s2 {font: 12.0px 'Times New Roman'; font-kerning: none}	</style>
</p>
<p class=\"p1\">
	<span class=\"s1\">འཇམ་དཔལ་རྡོ་རྗེ་ནི་ཁམས་དཔལ་ཡུལ་དགོན་ཆེན་གྱི་མཁན་རབས་ལྔ་པ་ཡིན་ལ།</span><span class=\"s2\"> </span><span class=\"s1\">འཇུ་མི་ཕམ་དང་གཞན་ཕན་ཆོས་ཀྱི་ཉི་མ་སོགས་ལས་ཐོས་བསམ་མཛད།</span></p>"""@tibetan ;
	.

told:_FormattedContent_Biography_Summary_11299
	gist:containedText """<p>
	<style type=\"text/css\">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 14.0px Kokonor}
span.s1 {font-kerning: none}
span.s2 {font: 14.0px 'Times New Roman'; font-kerning: none}	</style>
</p>
<p class=\"p1\">
	<span class=\"s1\">ཇོ་སྣུབས་རྡོ་རྗེ་ཡེ་ཤེས་ནི་འབྲི་གུང་གདན་རབས་བརྒྱད་པ་ཡིན་ལ།</span><span class=\"s2\"> </span><span class=\"s1\">ཁོང་ནི་སྔ་རབས་འབྲི་གུང་ཁྲི་པའི་གྲས་སུ་སྐྱུ་རའི་གདུང་རྒྱུད་མ་ཡིན་པའི་དམིགས་བསལ་ཅན་ཞིག་ཡིན།</span><span class=\"s2\"> </span><span class=\"s1\">དེབ་ཐེར་ལ་ལར་ཡེ་ཤེས་རྡོ་རྗེ་དགོངས་པ་གཤེགས་སྐབས་འབྲི་གུང་གདན་རབས་ཕྱི་མ་བཅུ་གཉིས་པ་རྡོ་རྗེ་རིན་ཆེན་ལོ་ན་གཞོན་པས།</span><span class=\"s2\"> </span><span class=\"s1\">ཁོང་གིས་རྒྱལ་ཚབ་ཀྱི་འགན་བཞེས་པར་གྲགས།</span><span class=\"s2\"> </span><span class=\"s1\">ཁོང་ཁྲི་པར་བཞུགས་པའི་དུས་སྐབས་སུ་འབྲི་གུང་གིས་ས་སྐྱ་དང་སོག་པོས་བཟུང་བའི་བོད་ཀྱི་སྲིད་དབང་ལ་གྱེན་ལོག་བྱས་པས་ཕམ་ཁ་ཆེན་པོ་ཉོས་ཏེ།</span><span class=\"s2\"> </span><span class=\"s1\">འབྲི་གུང་དགོན་བཅོམ་ཞིང་།</span><span class=\"s2\"> </span><span class=\"s1\">རྡོ་རྗེ་ཡེ་ཤེས་ཀོང་པོར་བསྐྱུགས་པས།</span><span class=\"s2\"> </span><span class=\"s1\">ཁོང་ཉིད་དགོངས་པ་མ་རྫོགས་བར་དུ་དེ་རུ་བཞུགས་པ་རེད།</span></p>"""@tibetan ;
	.

told:_FormattedContent_Biography_Summary_11352
	gist:containedText """<p>
	<style type=\"text/css\">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 14.0px Kailasa}
span.s1 {font: 14.0px 'Times New Roman'}	</style>
</p>
<p class=\"p1\">
	བྱང་ཆུབ་བརྩོན་འགྲུས་ནི་འབྲུག་གི་དཔོན་རིགས་གཙོ་ཤོས་ཀྲོང་གསར་སློབ་དཔོན་འཇིགས་མེད་རྣམ་རྒྱལ་གྱི་བླ་མ་གཙོ་བོ་དང་།<span class=\"s1\"> </span>བྱ་རོག་གདོང་ཆེན་ཞེས་པའི་སྲུང་འཁོར་གྱི་ནུས་པ་ཅན་གྱི་ཞྭ་མོ་དེ་གསར་བཏོད་མཛད།<span class=\"s1\"> </span>ཁོང་ནི་བོད་ཀྱི་བྱང་ཁུལ་དུ་སྐུ་འཁྲུངས་ཤིང་གཞོན་དུས་ནས་འབྲུག་དང་འབྲེལ་ཆེ་ལ།<span class=\"s1\"> </span>མི་ཚེ་ཕལ་ཆེར་འབྲུག་དང་བོད་ཀྱི་བར་དང་།<span class=\"s1\"> </span>ལྷག་པར་ལྷོ་བྲག་དང་འབུམ་ཐང་བར་འགྲུལ་བཞུད་མཛད།<span class=\"s1\"> </span>ཁོང་ནི་ཡུལ་གྲུ་གང་སར་རང་དབང་སྒོས་ཕེབས་བཞུད་མཛད་པར་མོས་ཤིང་།<span class=\"s1\"> </span>ཆོས་རྒྱུད་གྲུབ་མཐའ་ཀུན་ལ་སྤྲོ་ཆེ་བ།<span class=\"s1\"> </span>ཟིང་ཟང་གི་ནོར་ལོགས་སྤྱོད་སྤངས་པའི་བླ་མ་ཞིག་ཡིན།<span class=\"s1\"> </span>འབྲུག་ཏུ་ཀླུ་དང་རྒྱལ་པོ་བཏུལ་བས་ལྷག་པར་སྙན་གྲགས་ཆེ་ཞིང་འཕྲིན་ལས་རྒྱས་པར་གྱུར།</p>"""@tibetan ;
	.

