told:_FormattedContent_Biography_Summary_7172
	gist:containedText """<p>
	<style type=\"text/css\">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 12.0px Kokonor}
span.s1 {font-kerning: none}
span.s2 {font: 12.0px 'Times New Roman'; font-kerning: none}	</style>
</p>
<p class=\"p1\">
	<span class=\"s1\">བསེ་ཚང་སྐུ་ཕྲེང་ལྔ་པ་བློ་བཟང་བཀྲ་ཤིས་འཕྲིན་ལས་རྒྱ་མཚོས་ནི་རོང་བོ་དགོན་ཆེན་དུ་ཐོས་བསམ་མཛད་ཅིང་།</span><span class=\"s2\"> </span><span class=\"s1\">དེ་རུ་ཁྲི་པའི་འགན་ཡང་བཞེས།</span><span class=\"s2\"> </span><span class=\"s1\">སྤྱི་ལོ</span><span class=\"s2\"> </span><span class=\"s1\">༡༩༡༩</span><span class=\"s2\"> </span><span class=\"s1\">ལོར་བསེ་ཚང་སྐུ་ཕྲེང་རིམ་བྱོན་གྱི་གདན་ས་གཏེར་ལུང་དགོན་ཁ་ཆེ་དམག་དཔུང་དང་མཱ་ཆིས་ཀྱིས་བཅོམས་རྗེས།</span><span class=\"s2\"> </span><span class=\"s1\">དེ་ཉིད་བསྐྱར་བཞེངས་སྐབས་སུ་གཟིགས་རྟོག་མཛད་ཅིང་།</span><span class=\"s2\">&nbsp;</span></p>"""@tibetan ;
	.

told:_FormattedContent_Biography_Summary_7230
	gist:containedText
		"""<p>
