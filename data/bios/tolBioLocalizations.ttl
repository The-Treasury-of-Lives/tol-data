	<style type="text/css">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 12.0px Kailasa; color: #000000}	</style>
</p>
<p class="p1">
	ཟམ་ཚ་གསེར་ཁྲི་སྐུ་ཕྲེང་བཞི་པ་འཇིགས་མེད་བསམ་གྲུབ་རྒྱ་མཚོ་ནི་འཇམ་དབྱངས་བཞད་པ་སྐུ་ཕྲེང་བཞི་པའི་སློབ་མ་ཡིན། ཁོང་ནས་ཨ་མདོ་བླ་བྲང་དགོན་གྱི་གདན་རབས་ང་གསུམ་པའི་མཛད་འགན་བཞེས།</p>'''@tibetan ,
		"""<p>
	第四世三木察赛赤，晋美三珠嘉措是第四世嘉木样活佛的弟子。他是拉卜楞寺第53代赤巴。</p>"""@chinese
		;
	.

told:_FormattedContent_Biography_Summary_6856
	gist:containedText """<p>
	<style type=\"text/css\">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 12.0px Kokonor}
