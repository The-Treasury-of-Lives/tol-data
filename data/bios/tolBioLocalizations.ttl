	gist:containedText """<p>
	<style type=\"text/css\">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 12.0px Kailasa}
span.s1 {font: 12.0px 'Times New Roman'}	</style>
</p>
<p class=\"p1\">
	དམུ་དགེ་བསམ་གཏན་རྒྱ་མཚོ་ནི་རིག་གནས་གསར་བརྗེ་ཆེན་པོའི་རྗེས་ཀྱི་མཁས་པ་མི་གསུམ་གྱི་ཡ་གྱལ་ཡིན་པས་སྙན་གྲགས་ཆེ་ལ།<span class=\"s1\"> </span>མཚན་འདི་ནི་བོད་ཀྱི་དུས་རབས་བཅུ་པའི་ལོ་རྒྱུས་སུ་གླང་དར་མས་དབུས་སུ་བསྟན་པ་བསྣུར་སྐབས་མཁས་པ་མི་གསུམ་གྱིས་བོད་ཀྱི་ཤར་ཁུལ་དུ་སངས་རྒྱས་ཀྱི་ཆོས་བསྣམས་ནས་བྲོས་ཡོང་པའི་ལོ་རྒྱུས་དེ་ལས་དྲངས་ཏེ་སྦྱར་པ་རེད།<span class=\"s1\"> </span>དེ་བས་ལོ་ངོ་ཉི་ཤུ་ལྷག་གི་ཆབ་སྲིད་ཀྱི་གོད་ཆགས་རྗེས་སུ་དམུ་དགེ་བསམ་གཏན་དང་།<span class=\"s1\"> </span>དུང་དཀར་བློ་བཟང་འཕྲིན་ལས།<span class=\"s1\"> </span>ཨ་ལག་ཚེ་ཏན་ཞབས་དྲུང་གསུམ་གྱིས་བོད་ཀྱི་དགོན་སྡེ་དང་སྐྱ་བོའི་སྡེ་ཡི་བོད་ཀྱི་ཤེས་རིག་སླར་གསོ་ལ་ནུས་པ་ཇི་འདྲ་ཞིག་ཐོན་པ་རྟོགས་ཡོང་།<span class=\"s1\"> </span>དེང་གི་རྒྱ་ནག་དང་ཕྱི་རྒྱལ་ཀྱི་བོད་རིག་པ་སྨྲ་བ་མང་ཆེ་བས་མཁས་པ་འདི་གསུམ་གང་རུང་ལས་སློབ་གཉེར་མཛད་མྱོང་པ་རེད།<span class=\"s1\"> </span>ཁོང་ནི་ཨ་མདོ་རུ་སྐུ་འཁྲུངས་ཤིང་།<span class=\"s1\"> </span>དམུ་དགེའི་བཀྲ་ཤིས་འཁོར་ལོ་དང་བླ་བྲང་དུ་མཁས་ཆེན་དུ་མ་ལས་ཐོས་བསམ་མཛད།<span class=\"s1\"> </span>དེང་རབས་སློབ་གསོ་ལ་སྤྲོ་ཆེ་ཞིང་།<span class=\"s1\"> </span>པེ་ཅིང་དུ་ཐེངས་གཉིས་ལ་ཕེབས་ཏེ་རྒྱ་ནག་གི་བོད་ཀྱི་སྐད་ཡིག་སྐོར་གྱི་སྲིད་ཇུས་གཏན་འབེབས་ལ་གཟིགས་རྟོགས་མཛད་མཁན་གྱི་གྲས་སུ་ཞུགས་པ་རེད།</p>"""@tibetan ;
	.

told:_FormattedContent_Biography_Summary_2952
	gist:containedText
		'''<p>
	<style type="text/css">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 12.0px Kailasa; color: #000000}	</style>
</p>
<p class="p1">
	དགེ་འདུན་རིན་ཆེན་རྒྱལ་མཚན་ནི་དགའ་ལྡན་ཁྲི་ཐོག་སོ་བདུན་པ་ཡིན་ཞིང་། ཕྱི་ལོ་༡༦༣༨ ནས་༡༦༤༢ བར་ཁྲི་པ་མཛད། སེ་ར་དང་རྒྱུད་སྟོད་བཅས་སུ་སློབ་གཉེར་གནང་སྟེ་རྗེས་སུ་དེར་འཆད་ཉན་སློབ་དཔོན་གྱི་མཛད་ཁུར་བཞེས། དེ་བཞིན་དགའ་ལྡན་བྱང་རྩེ་གྲྭ་ཚང་དུའང་འཆད་ཉན་སློབ་དཔོན་མཛད། དེ་ནས་དགའ་ལྡན་གྱི་གསེར་ཁྲིར་བཞུགས། ཁོང་གིས་ཐང་རིང་དགོན་པ་ཕྱག་བཏབ།</p>'''@tibetan ,
		"""<p>
	格顿仁青坚参于1638-1642年间担任第三十七任甘丹赤巴。他曾在色拉及上密院学习并随后担任导师。他同时也是甘丹绛孜的导师，后在那里荣升赤巴。他创建了龙合寺。</p>"""@chinese
		;
	.

told:_FormattedContent_Biography_Summary_2974
	gist:containedText """<p>
	<style type=\"text/css\">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 12.0px Kokonor}
span.s1 {font-kerning: none}
span.s2 {font: 12.0px 'Times New Roman'; font-kerning: none}	</style>
</p>
<p class=\"p1\">
	<span class=\"s1\">ཤིང་བཟའ་པཎྜི་ཏ་བློ་བཟང་དར་རྒྱས་རྒྱ་མཚོ་ནི་ཨ་མདོ་ཡུལ་གྱི་དགེ་ལུགས་པའི་མཁས་ཆེན་དམ་པ་ཡིན་ལ།</span><span class=\"s2\"> </span><span class=\"s1\">ཁོང་གིས་སེ་ར་དགོན་དུ་ཐོས་བསམ་མཛད་ཅིང་།</span><span class=\"s2\"> </span><span class=\"s1\">ཨ་མདོ་ཡུལ་གྱི་བླ་མ་ཆེ་གྲགས་ཕལ་ཆེ་བས་དགེ་རྒན་དུ་བསྟེན་མྱོང་།</span><span class=\"s2\"> </span><span class=\"s1\">ཁོང་ནི་སྐུ་འབུམ་དགོན་པའི་ཁྲི་རབས་བཞི་བཅུ་ཞེ་བཞི་པ་དང་རོང་བོ་དགོན་པའི་གདན་རབས་ཉེར་བརྒྱད་པ་ཡིན།</span></p>"""@tibetan ;
	.

told:_FormattedContent_Biography_Summary_3000
	gist:containedText
		'''<p class="p1">
	པདྨ་གླིང་པ་ནི་<span class="s1">གཏེར་ཆོས་མང་དུ་མངའ་བའི་</span>གཏེར་སྟོན་ཞིག་ཡིན་<span class="s2">ལ</span>།<span class="s3"> </span>འབྲུག<span class="s2">་པའི་</span>ལོ་རྒྱུས་ནང་གི་<span class="s4">ཆོས་ལུགས་</span>མི་སྣ་གྲགས་ཅན་གྱི་<span class="s4">གྲས་ཤིག་ཡིན།</span><span class="s3"> </span>ཁོང་<span class="s1">བུམ་ཐང་</span>དུ་སྐུ་འཁྲུངས་ཤིང་<span class="s2">ཐོག་མར་མགར་བའི་ལས་ཀ་བྱས།</span><span class="s3"> </span>རྗེས་སུ་གཏེར་ཆོས་མང་དུ་བཏོན་ཏེ་དམ་ཆོས་འཆད་སྤེལ་གྱི<span class="s5">ས་བསྟན་འགྲོའི་དོན་ཡུན་རིང་དུ་</span>བསྐྱངས་པའང་<span class="s2">བོད་ཡུལ་ལྷོ་ཕྱོགས་ཁུལ་</span><span class="s6">ཕལ་ཆེར་དུ་ཁྱབ།</span><span class="s3"> </span>ཁོང་གིས་འབྲུག་ཡུལ་དུ་གཏམ་ཞིང་ལྷུན་གྲུབ་ཆོས་གླིང་<span class="s1">ལྷ་ཁང་</span>ཕྱག་བཏབ་ནས་<span class="s6">གདན་ས་མཛད</span>།<span class="s3"> </span><span class="s5">ཡང་སྲིད་ཀྱང་སྐུ་གསུང་ཐུགས་ཀྱི་བརྒྱུད་པ་གསུམ་དུ་བྱོན་ཡོད་པའང་།</span><span class="s7"> </span>འབྲུག་ཡུལ་གྱི་སྔ་འགྱུར་རྙིང་མའི་<span class="s6">བསྟན་པའི་བདག་པོ་གཙོ་བོར་གྱུར་ཡོད་དོ།།</span></p>'''@tibetan ,
		"""<p>
	贝玛林巴是一位多产的掘藏师，也是不丹历史上最具影响力的宗教人物之一。他出生于苯塘，自小被训练成为一名铁匠。后来他开始了在青藏高原南部长期的掘藏及讲经事业。他建立了位于不丹的丹兴隆珠曲林寺。他的教派传承通过他的三个转世体系得以延续，并主导着不丹的宁玛派传统。</p>"""@chinese
		;
	.

told:_FormattedContent_Biography_Summary_3006
	gist:containedText """<p>
	<style type=\"text/css\">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 14.0px Kailasa}
span.s1 {font: 14.0px 'Times New Roman'}	</style>
</p>
<p class=\"p1\">
	མངའ་རིས་པཎ་ཆེན་པདྨ་དབང་རྒྱལ་ནི་དུས་རབས་བཅུ་དྲུག་པའི་ནང་གི་རྙིང་མའི་བླ་མ་སྔ་ཤོས་ཤིག་ཡིན་ལ།<span class=\"s1\"> </span>ཁོང་ནི་བལ་པོ་གློ་ཡུལ་དུ་སྐུ་འཁྲུངས་ཤིང་།<span class=\"s1\"> </span>ཁོང་གི་སྐུ་གཅུང་ལེགས་ལྡན་རྡོ་རྗེ་དང་ལྷན་དུ་བོད་ཀྱི་ཡུལ་གྲུ་གང་སར་ཕེབས་ཤིང་བྱང་གཏེར་གྱི་ཆོས་སྐོར་སྤེལ།<span class=\"s1\"> </span>འདུལ་ཁྲིམས་གཅེས་པའི་སྲོག་ལྟར་བསྲུངས་ཤིང་།<span class=\"s1\"> </span>རྙིང་མའི་ལུགས་ཀྱི་ལམ་གྱི་རིམ་པ་སྡོམ་གསུམ་རྣམ་ངེས་སོགས་གསུང་རྩོམ་མང་དུ་མཛད་པས་སྙན་གྲགས་ཆེ།<span class=\"s1\">&nbsp;</span></p>"""@tibetan ;
	.

told:_FormattedContent_Biography_Summary_3020
	gist:containedText '''<p>
	<style type="text/css">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 14.0px Kailasa}
span.s1 {font-kerning: none}
span.s2 {font: 14.0px Calibri; font-kerning: none}	</style>
</p>
<p class="p1">
	<span class="s1">མི་འགྱུར་ནམ་མཁའི་རྡོ་རྗེ་</span><span class="s1">ནི་རྫོགས་ཆེན་གྲུབ་དབང་སྐུ་ཕྲེང་བཞི་པ་</span><span class="s1">དང་།</span><span class="s2"> </span><span class="s1">ཁམས་རྫོགས་ཆེན་དགོན་</span><span class="s1">གྱི་མཁན་རབས་བདུན་པ་ཡིན།</span><span class="s2"> </span><span class="s1">ཁོང་རྡོ་གྲུབ་ཆེན་སྐུ་ཕྲེང་དང་པོའི་</span><span class="s1">སློབ་མ་ཡིན་ཞིང་།</span><span class="s2"> </span><span class="s1">ཁམས་ཁུལ་དུ་རྫོགས་པ་ཆེན་པོའི་གྲུབ་པ་འཛིན་པའི་སྐྱེས་ཆེན་བཅུ་ཕྲག་བརྒལ་བ་རྗེས་སུ་བཟུང་ཞེས་རྒྱ་ཆེར་བསྔགས།</span><span class="s2"> </span><span class="s1">༸གོང་ས་ཏཱ་ལའི་བླ་མ་སྐུ་ཕྲེང་དགུ་པའི་</span><span class="s1">ཉེ་འབྲེལ་ཡིན་པ་ཙམ་དུ་མ་ཟད་།</span><span class="s2"> </span><span class="s1">འབྲེལ་བའང་དམ་ཟབ་བསྐྱངས།</span><span class="s2"> </span><span class="s1">ཕྱི་ལོ་༡༨༤༢</span><span class="s2"> </span><span class="s1">ལོར་རྫོགས་ཆེན་དགོན་པར་ས་འགུལ་གྱི་འཇིགས་པ་ཆེན་པོ་བྱུང་བར་ཁོང་ནས་སྡེ་དགེ་རྒྱལ་པོའི་རྒྱུ་སྦྱོར་ཡོན་འབུལ་ལ་བརྟེན་ནས་དགོན་པ་ཉམས་གསོ་མཛད།</span></p>'''@tibetan ;
	.

told:_FormattedContent_Biography_Summary_303
	gist:containedText
		'''<p class="p1">
	སྣ་ནམ་རྡོ་རྗེ་བདུད་འཇོམས་ནི།<span class="s1"> </span>བོད་ཀྱི་རྒྱལ་པོ་ཁྲི་སྲོང་ལྡེའུ་བཙན་གྱི་བློན་<span class="s2">པོ</span>་དང་།<span class="s1"> </span>སློབ་དཔོན་པདྨ་འབྱུང་གནས་ཀྱི་དངོས་སློབ་རྗེས་འབངས་ཉེར་ལྔའི་ཡ་གྱལ་ཞིག་ཡིན།<span class="s1"> </span>ཁོང་ནི་སློབ་དཔོན་རིན་པོ་ཆེ་བོད་དུ་<span class="s3">གདན་འདྲེན་ཞུ་མཁན་</span>གྱི་ཁོངས་སུ་ཡོད་ལ།<span class="s1"> </span>མདོ་སྔགས་གཞུང་ལུགས་མང་དག་ཅིག་ཀྱང་བོད་སྐད་ཐོག་བསྒྱུར།<span class="s1"> </span>རྡོ་རྗེ་བདུད་འཇོམས་ནི་རྫུ་འཕྲུལ་ལ་མངའ་བརྙེས་ཤིང་བྲག་དང་ཕ་བོང་སོགས་སུ་ཐོགས་མེད་དུ་རྒྱུ་བར་བཤད་དོ།།</p>'''@tibetan ,
		"""<p>
	纳南&bull;多杰邓炯曾任赤松德赞法王的大臣，也是莲花生二十五位弟子之一。他与另一些人将莲花生大师迎请至西藏并担任显密经典的翻译。相传多杰邓炯有穿石的能力。</p>"""@chinese
		;
	.

told:_FormattedContent_Biography_Summary_3040
	gist:containedText """<p>
	<style type=\"text/css\">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 12.0px Kailasa}
span.s1 {font: 12.0px 'Times New Roman'}	</style>
</p>
<p class=\"p1\">
	གྲགས་པ་རྒྱལ་མཚན་ནི་པཎ་ཆེན་སྐུ་ཕྲེང་བཞི་པའི་བུ་སློབ་དང་ཕྱོགས་གཏོགས་ཡིན་ལ།<span class=\"s1\"> </span>ཕལ་ཆེར་ཁོ་རང་འོས་སྤྲུལ་དུ་བབས་མྱོང་བའི་རྒྱལ་དབང་ལྔ་པའི་ཁ་གཏད་དུ་ལངས་མཁན་ཞིག་ཡིན་ངེས།<span class=\"s1\"> </span>ཁོང་ནི་ལྕེབས་པའམ་ལྐོག་གསོད་བྱས་པས།<span class=\"s1\"> </span>ཁོང་གི་གཤེགས་རྐྱེན་དེ་རྡོ་རྗེ་ཤུགས་ལྡན་སྐོར་གྱི་ངག་རྒྱུན་མང་པོ་དེའི་འབྱུང་རྐྱེན་དུ་གྱུར་པ་རེད།</p>"""@tibetan ;
	.

told:_FormattedContent_Biography_Summary_3061
	gist:containedText """<p>
	<style type=\"text/css\">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 12.0px Kailasa}
span.s1 {font: 12.0px 'Lucida Grande'}
span.s2 {font: 12.0px Georgia}	</style>
</p>
<p class=\"p1\">
	བློ་བཟང་ཐུབ་བསྟན་དགེ་ལེགས་རྒྱལ་མཚན་ནི་ཨ་མདོ་ཁུལ་གྱི་རི་བོ་དགེ་ལུགས་པའི་བླ་མ་ཞབས་དྲུང་དཀར་པོ་སྐུ་ཕྲེང་རིམ་བྱོན་ནང་གི་སྐུ་རབས་བཞི་པ་དེ་ཡིན། སྐུ་རབས་གོང་མ་ལྟར་ཨ་མདོ་ཡུལ་གྱི་ས་ཁུལ་ཁྱབ་ཆེན་པོར་ཆབ་སྲིད་ཀྱི་འགན་དབང་བཞེས།</p>"""@tibetan ;
	.

told:_FormattedContent_Biography_Summary_3062
	gist:containedText """<p>
	<style type=\"text/css\">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 12.0px Kailasa}
span.s1 {font: 12.0px 'Lucida Grande'}
span.s2 {font: 12.0px Georgia}	</style>
</p>
<p class=\"p1\">
	ངག་དབང་བློ་བཟང་བསྟན་པའི་རྒྱལ་མཚན་ནི་ཨ་མདོ་ཁུལ་གྱི་རི་བོ་དགེ་ལུགས་པའི་བླ་མ་ཞབས་དྲུང་དཀར་པོ་སྐུ་ཕྲེང་རིམ་བྱོན་ནང་གི་སྐུ་རབས་གསུམ་པ་དེ་ཡིན། ཁོང་གིས་ལ་མོ་བདེ་ཆེན་དགོན་ཕྱག་བཏབ་ཅིང་། དགོན་པ་འདི་ཉིད་ཞབས་དྲུང་དཀར་པོ་སྐུ་རབས་རིམ་བྱོན་རྣམས་ཀྱི་གདན་སར་གྱུར།</p>"""@tibetan ;
	.

told:_FormattedContent_Biography_Summary_3064
	gist:containedText """<p>
	<style type=\"text/css\">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 12.0px Kokonor}
span.s1 {font-kerning: none}
span.s2 {font: 12.0px 'Times New Roman'; font-kerning: none}	</style>
</p>
<p class=\"p1\">
	<span class=\"s1\">ཨ་མདོ་ཞྭ་དམར་སྐུ་ཕྲེང་དང་པོ་ངག་དབང་འཕྲིན་ལས་ནི་ཨ་མདོ་རུ་སྐུ་འཁྲུངས་ཤིང་།</span><span class=\"s2\"> </span><span class=\"s1\">འབྲས་སྤུངས་སྒོ་མང་གྲྭ་ཚང་དུ་ཐོས་བསམ་མཛད།</span><span class=\"s2\"> </span><span class=\"s1\">ཕྱིས་སུ་ཕྱིར་ཨ་མདོར་ཕེབས་ཏེ་བླ་བྲང་བཀྲ་ཤིས་འཁྱིལ་དང་ལ་མོ་བདེ་ཆེན་དགོན་གྱི་ཁྲི་པར་བཞུགས།</span></p>"""@tibetan ;
	.

told:_FormattedContent_Biography_Summary_3085
	gist:containedText '''<p class="p1">
	<span class="s1">༸</span>རྒྱལ་དབང་སྐུ་ཕྲེང་བཞི་པ་ཡོན་ཏན་རྒྱ་མཚོ་ནི། <span class="s1">༸</span>རྒྱལ་དབང་སྐུ་ཕྲེང་གསུམ་པ་བསོད་ནམས་རྒྱ་མཚོ་སོག་ཡུལ་དུ་གདན་འདྲེན་ཞུ་མཁན་སོག་པོ་ཇིང་གེར་ཨལ་ཏན་རྒྱལ་པོའོ་དབོན་པོར་སོག་ཡུལ་དུ་སྐུ་བལྟམས། སྐུ་ན་ཆུང་ངུ་ལས་མ་བཞུགས་པར་དགོངས་པ་ཞི་བར་གཤེགས་ཀྱང་ཁོང་སོག་པོར་འཁྲུངས་པའི་རྒྱུ་མཚན་གྱིས་སོག་པོ་དང་དགེ་ལུགས་པའི་བར་འབྲེལ་བ་དམ་ཟབ་ཏུ་གྱུར་ཏེ་སྐབས་དེའི་འབྲས་སྤུངས་ཁྲི་པར་ཡང་བོད་ཀྱི་སྲིད་དབང་ཐད་དབང་ཆ་གང་འཚམས་ཞིག་ཐོབ་པར་བཤད།</p>'''@tibetan ;
	.

told:_FormattedContent_Biography_Summary_3107
	gist:containedText '''<p class="p1">
	<span class="s1">༸</span>རྒྱལ་དབང་སྐུ་ཕྲེང་བདུན་པ་སྐལ་བཟང་རྒྱ་མཚོ་ནི། བོད་ཀྱི་ལོ་རྒྱུས་ནང་གངས་ཅན་ལྗོངས་འདི་སོག་དམག་གི་འཐབ་རྭ་ནས་མན་ཆིང་གིས་སྲུང་སྐྱོབ་གྲོགས་དན་བྱས་པའི་རྒྱལ་ཁབ་ཅིག་ཏུ་གྱུར་པའི་རྙོག་ཟིང་ཆེ་བའི་སྐབས་ཤིག་ལ་སྐུ་བལྟམས། རབ་བྱུང་གི་སྡོམ་པ་ཡོངས་སུ་སྲུངས་ཤིང་ཕྱི་ནང་རིག་གནས་མཐའ་དག་ལ་ལྷག་པར་བྱན་ཆུབ་པའི་མཁས་པ་ཞིག་ཏུ་མཆིས་ཀྱང་། ཆུང་བྱིས་པའི་དུས་ནས་སྐུ་ནར་མ་སོན་གྱི་བར་དཀའ་རྙོག་ཇི་སྙེད་ཅིག་བྱུང་བ་ལ་བརྟེན་ནས་ཆབ་སྲིད་ཀྱི་ཐུགས་འགན་མ་བཞེས་པར་ནར་མར་བཞུགས། ཕྱི་ལོ་༡༧༤༧<span class="s2">-</span>༡༧༥༠ བར་གྱི་དོན་རྐྱེན་ལ་གཞིགས་ཏེ་མཐར་དགུང་ལོ་ཞེ་གསུམ་ཐོག་བོད་ཀྱི་ཆབ་སྲིད་ཀྱི་ཐུགས་འགན་ཡོངས་སུ་བཞེས། རྒྱལ་མཆོག་ལྔ་པ་ཆེན་པོའི་སྐུ་དུས་ནས་ཆོས་སྲིད་གཉིས་ཀའི་མངའ་དབང་གིས་ཕྱུག་པའི་ཏཱ་ལའི་བླ་མའི་སྒྲིག་འཛུགས་འདི་ཉིད་<span class="s1">༸</span>རྒྱལ་དབང་སྐུ་ཕྲེང་བདུན་པའི་དུས་ནས་འཕེལ་རྒྱས་བྱུང་བ་དང་། ཡང་མན་ཇུ་དང་འབྲེལ་ལམ་དམ་ཟབ་བསྐྱངས་པས་རྗེས་སུ་ཆིང་རྒྱལ་རབས་ཀྱི་སུ་བོད་རྒྱའི་འབྲེལ་ལམ་གྱི་སྒྲོམ་གཞི་དེའང་ཁོང་གི་སྐུ་དུས་ནས་སྐྲུན་ཞེས་བརྗོད་ཆོག</p>'''@tibetan ;
	.

told:_FormattedContent_Biography_Summary_3121
	gist:containedText """<p>
	<style type=\"text/css\">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 14.0px Kailasa}
span.s1 {font: 14.0px 'Times New Roman'}	</style>
</p>
<p class=\"p1\">
	དུང་མཚོ་རས་པ་སྔ་མ་ནི་དྭགས་པོ་བཀའ་བརྒྱུད་ལུགས་ཀྱི་གཏེར་སྟོན་ཞིག་ཡིན་ལ།་སྒམ་པོ་པ་ཡིས་དྭགས་ལྷ་སྒམ་པོའི་སྟོད་ཀྱི་མཚེའུ་ཞིག་ཏུ་སྦས་པའི་གཏེར་ཆོས་གཏེར་ལས་འདོན་པར་མཛད་ཅིང་།<span class=\"s1\"> </span>གཏེར་ཆོས་འདི་ནི་ཟུར་མང་སྙན་བརྒྱུད་ལ་ཁྱབ་གདལ་དུ་གྱུར།<span class=\"s1\">&nbsp;</span></p>"""@tibetan ;
	.

told:_FormattedContent_Biography_Summary_3125
	gist:containedText '''<p>
	<style type="text/css">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 12.0px Kailasa; -webkit-text-stroke: #000000}
span.s1 {font-kerning: none}	</style>
</p>
<p class="p1">
	<span class="s1">འཁྲུལ་ཞིག་སྣའུ་བ་བྱ་བྲལ་རྡོ་རྗེ་མཛེས་ནི་དུང་མཚོ་རས་པ་སྔ་མའི་སློབ་མ་ཡིན།</span></p>'''@tibetan ;
	.

told:_FormattedContent_Biography_Summary_3134
	gist:containedText """<p>
	<style type=\"text/css\">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 12.0px Kailasa}
span.s1 {font: 12.0px 'Lucida Grande'}
span.s2 {font: 12.0px Georgia}	</style>
</p>
<p class=\"p1\">
	སྟོང་འཁོར་སྐུ་ཕྲེང་དྲུག་པ་ངག་དབང་འཇམ་དབྱངས་བསྟན་འཛིན་རྒྱ་མཚོ་ནི་སྟོང་འཁོར་སྐུ་ཕྲེང་ལྔ་པ་ངག་དབང་བསོད་ནམས་རྒྱ་མཚོའི་ཡང་སྲིད་གཉིས་ཀྱི་ཡ་གྱལ་ཡིན། ཨ་མདོ་སྟོང་འཁོར་དགོན་པར་བཞུགས། ཕྱི་ལོ་༡༧༦༦ ལོར་ཆུ་ནག་དགོན་པ་ཕྱག་བཏབ། སེ་ར་སྨད་གྲྭ་ཚང་གི་མཁན་པོ་མཛད། སྟོང་འཁོར་སྐུ་ཕྲེང་དྲུག་པ་ཅིག་ཤོས་ནི་ཁམས་ཕྱོགས་སུ་བཞུགས་པའི་བླ་མ་འཇམ་དཔལ་དགེ་འདུན་རྒྱ་མཚོ་ཞུ་བ་ཁོང་ཡིན།</p>"""@tibetan ;
	.

told:_FormattedContent_Biography_Summary_3139
	gist:containedText '''<p>
	<style type="text/css">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 12.0px Kailasa}
span.s1 {font-kerning: none}
span.s2 {font: 12.0px Calibri; font-kerning: none}	</style>
</p>
<p class="p1">
	<span class="s1">སངས་རྒྱས་ཡར་བྱོན་ཤེས་རབ་བླ་མ་</span><span class="s1">ནི་སྟག་ལུང་དགོན་</span><span class="s1">པའི་མཁན་རབས་གསུམ་པ་ཡིན།</span><span class="s2"> </span><span class="s1">ཁོང་གིས་རིན་ཆེན་གསེར་དངུལ་ལས་བྱས་པའི་སྐུ་བརྙན་གྲངས་ལས་འདས་པ་གསར་བཞེངས་མཛད་དེ་དགོན་པ་རྒྱ་བསྐྱེད་ཟམ་མ་ཆད་པར་གནང་།</span><span class="s2"> </span><span class="s1">ས་སྐྱ་དང་ཐུགས་ཐག་ཉེ་ཞིང་།</span><span class="s2"> </span><span class="s1">འགྲོ་མགོན་ཆོས་རྒྱལ་འཕགས་པ་</span><span class="s1">དགུང་ལོ་བདུན་ཅུའི་ཐོག་མཇལ།</span></p>'''@tibetan ;
	.

told:_FormattedContent_Biography_Summary_3141
	gist:containedText """<p>
	<style type=\"text/css\">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 14.0px Kailasa}
span.s1 {font: 14.0px 'Times New Roman'}	</style>
</p>
<p class=\"p1\">
	ལྕང་སྐྱ་སྐུ་ཕྲེང་གསུམ་པ་རོལ་པའི་རྡོ་རྗེ་ནི་དུས་རབས་བཅོ་བརྒྱད་པའི་ནང་དུ་ཆིང་གོང་མའི་ཕོ་བྲང་གི་རྩ་བའི་བླ་མ་དང་།<span class=\"s1\"> </span>གོང་མ་ཆན་ལུང་གི་དབུ་བླ་ཡིན་ལ།<span class=\"s1\"> </span>ཆིང་གོང་མ་དང་ཨེ་ཤ་ཡའི་སྐམ་སའི་དབུས་ཁུལ་བར་དུ་འབྲེལ་བ་འཛུགས་མཁན་གཙོ་ཤོས་ཡིན།<span class=\"s1\"> </span>ཁོང་ནི་གདུང་རྒྱུད་སོག་པོ་ཡིན་ལ།<span class=\"s1\"> </span>བོད་ཀྱི་བྱང་ཤར་ཁུལ་དུ་སྐུ་འཁྲུངས་ཤིང་།<span class=\"s1\"> </span>དང་ཐོག་ཆིང་གོང་མའི་ཕོ་བྲང་དུ་འཚོ་ཞིང་སློབ་གཉེར་མཛད།<span class=\"s1\"> </span>ཁོང་གི་བོད་ཡུལ་གྱི་གདན་ས་གཙོ་བོ་ནི་ཨ་མདོའི་བྱང་གི་དགོན་ཆེན་བཞིའི་ཡ་གྱལ་དགོན་ལུང་བྱམས་པ་གླིང་ཡིན།<span class=\"s1\"> </span>ཁོང་ནི་པཎ་ཆེན་སྐུ་ཕྲེང་དྲུག་པའི་ཕྱག་རོགས་ཤིག་ཡིན་ཞིང་།<span class=\"s1\"> </span>སྐུ་ཚེ་གང་བོར་གོང་མ་ཆན་ལུང་གི་ནང་བསྟན་གྱི་ལོ་ཙཱ་བ་དང་།<span class=\"s1\"> </span>དབུ་བླ།<span class=\"s1\"> </span>རྒྱལ་ཁབ་ཡོངས་ཀྱི་སློབ་དཔོན་མཛད་ནས་བཞུགས་པ་རེད།</p>"""@tibetan ;
	.

told:_FormattedContent_Biography_Summary_3153
	gist:containedText '''<p>
	<style type="text/css">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 14.0px Kailasa}
span.s1 {font-kerning: none}
span.s2 {font: 14.0px Calibri; font-kerning: none}	</style>
</p>
<p class="p1">
	<span class="s1">རྒྱལ་སྲས་ཐོགས་མེད་བཟང་པོ་</span><span class="s1">ནི་དུས་རབས་བཅུ་བཞི་པའི་བཀའ་གདམས་པའི་སློབ་དཔོན་ཞིག་ཡིན།</span><span class="s2"> </span><span class="s1">དངུལ་ཆུ་ཆོས་རྫོང་</span><span class="s1">དུ་བཞུགས་ཤིང་དེར་ལོ་ཉི་ཤུ་མཚམས་བསྙེད་སྒྲུབ་མཛད།</span><span class="s2"> </span><span class="s1">ཕྱི་ལོ་༡༣༢༦</span><span class="s2"> </span><span class="s1">ནས་༡༣༣༥</span><span class="s2"> </span><span class="s1">བར་ལོ་དགུ་ཡི་རིང་བོ་དོང་ཨེ་དགོན་པའི་</span><span class="s1">མཁན་པོའི་ཁྲི་ལ་བཞུགས།</span><span class="s2"> </span><span class="s1">བློ་སྦྱོང་གི་མན་ངག་སྤེལ་བའི་སློབ་དཔོན་གཙོ་བོ་ཞིག་ཡིན་ཞིང་།</span><span class="s2"> </span><span class="s1">ནང་པའི་བརྩམ་ཆོས་ཁག་ནས་ཕུལ་བྱུང་དུ་བསྔགས་པ་རྒྱལ་སྲས་ལག་ལེན་སོ་བདུན་སོགས་བློ་སྦྱོང་གི་གཞུང་ཁག་གཅིག་བརྩམས།</span><span class="s2"> </span><span class="s1">འཕགས་པ་ཐུགས་རྗེ་ཆེན་པོའི་གསང་སྔགས་ཀྱི་ཆོས་སྐོར་ལ་ལྷག་པར་མཁས་པའི་སློབ་དཔོན་འདི་ནི་བུ་སྟོན་རིན་ཆེན་གྲུབ་</span><span class="s1">ཀྱི་སློབ་མ་དང་།</span><span class="s2"> </span><span class="s1">རེད་མདའ་བ་གཞོན་ནུ་བློ་གྲོས་</span><span class="s1">ཀྱི་བླ་མ་ཡིན།</span><span class="s2"> </span><span class="s1">ཁོང་ནི་བཀའ་གདམས་བླ་བརྒྱུད་ནང་གི་བླ་རབས་དོན་གསུམ་པར་བགྲངས།</span></p>'''@tibetan ;
	.

told:_FormattedContent_Biography_Summary_3171
	gist:containedText '''<p>
	<style type="text/css">
p.p1 {margin: 0.0px 0.0px 0.0px 37.6px; text-indent: -0.9px; font: 12.0px Kailasa; color: #000000}	</style>
</p>
<p class="p1">
	ངག་དབང་ཚེ་འཕེལ་ནི་དགའ་ལྡན་ཁྲི་ཐོག་ང་གཉིས་པར་བགྲངས་པའི་དགེ་ལུགས་པའི་སྐྱེས་ཆེན་ཞིག་ཡིན་ཞིང་། ཕྱི་ལོ་༡༧༢༨ ནས་༡༧༣༢ བར་ཁྲི་པ་ལོ་བཞི་མཛད། དགའ་ལྡན་དང་། དྭགས་པོ། རྒྱུད་སྨད་བཅས་སུ་སློབ་གཉེར་མཐར་ཕྱིན་པར་གནང་། དྭགས་པོ་གྲྭ་ཚང་གི་མཁན་པོ་དང་། རྒྱུད་སྨད་གྲྭ་ཚང་གི་བླ་མ་དབུ་མཛད་དང་མཁན་པོ་བཅས་གནང་། དེ་ནས་རིམ་གྱིས་དགའ་ལྡན་གྱི་གསེར་ཁྲིར་མངའ་གསོལ། <span class="Apple-converted-space">&nbsp;</span></p>'''@tibetan ;
	.

told:_FormattedContent_Biography_Summary_3173
	gist:containedText
		'''<p>
	<style type="text/css">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 12.0px Kailasa; color: #000000}	</style>
</p>
<p class="p1">
	དགེ་འདུན་ཕུན་ཚོགས་ནི་འཇམ་དབྱངས་བཞད་པ་སྐུ་ཕྲེང་དང་པོའི་སློབ་མ་དང་དགའ་ལྡན་ཁྲི་ཐོག་ལྔ་བཅུ་པ་ཡིན་ཞིང་། ཕྱི་ལོ་༡༧༡༤ ནས་༡༧༢༡ བར་ཁྲི་པ་མཛད། འབྲས་སྤུངས་སྒོ་མང་དང་རྒྱུད་སྨད་གྲྭ་ཚང་དུ་སློབ་གཉེར་གནང་། ཁོང་ནི་གསང་སྔགས་ལ་ཞུགས་པའི་རྣལ་འབྱོར་པ་མཚན་སྙན་ཆེ་བ་ཞིག་ཡིན་ཞིང་། རྗེ་ཙོང་ཁ་པའི་དངུལ་གདུང་ཆེན་མོ་དེ་ཉིད་རྫུ་འཕྲུལ་གྱིས་གསེར་གདུང་དུ་བསྒྱུར་བར་སོག་པོ་ལྷ་བཟང་ཁཱང་ནས་ཀྱང་ཆེ་བསྟོད་རྒྱ་ཆེར་གནང་ཞེས་ཟེར། ཁོང་གི་ཡང་སྲིད་རིམ་བྱོན་རྣམས་ལ་གུང་ཐང་བླ་མ་ཞེས་པའི་མཚན་གསོལ།<span class="Apple-converted-space">&nbsp;</span></p>'''@tibetan ,
		"""<p>
	根登彭措是第一世嘉木样活佛的弟子，于1714至1721年担任第五十任甘丹赤巴。他在哲蚌果芒寺及下密院接受教育。他以杰出的密法修行者闻名，被认为曾将宗喀巴白银灵塔以神通转成黄金灵塔，并因此得到拉藏汗的奖赏。他的转世祖古便是贡唐喇嘛。</p>"""@chinese
		;
	.

told:_FormattedContent_Biography_Summary_3178
	gist:containedText '''<p class="p1">
	བོད་དུ་སྙན་པའི་གྲགས་པ་མཆོག་ཏུ་རྒྱས་པའི་གྲུབ་པའི་དབང་ཕྱུག་རྗེ་བཙུན་མི་ལ་རས་པ་ནི། མཉམ་མེད་བཀའ་བརྒྱུད་པའི་བྱུང་རབས་ལོ་རྒྱུས་ནང་ཆོས་ལུགས་འདི་ཉིད་གསར་གཏོད་ཐད་མཛད་རྗེས་ཆེ་ཞིང་། ཕྱིས་བྱུང་<span class="s1">སྒྲུབ་</span>པ་ཉམས་ལེན་པ་རྣམས་ཀྱི་མིག་དཔེར་འོས་པའི་<span class="s1">སྒྲུབ་</span>པའི་རྒྱལ་མཚན་འཛིན་པའི་བསྟན་འཛིན་གྱི་སྐྱེས་ཆེན་ཞིག་ཡིན། རྣམ་ཐར་ཁག་ཏུ་ཁོང་གི་སྐུ་ཚེའི་ལོ་རྒྱུས་ནི་གཏམ་རྒྱུད་དང་དངོས་<span class="s1">བྱུང</span>་འདྲེས་མའི་ཚུལ་དུ་བཞུགས། ཁོང་ཆུང་ངུའི་དུས་སུ་རང་ཉིད་ཀྱི་ཕ་གཞིས་ཤོར་བའི་ལན་དུ་མི་ཉི་ཤུ་ལྷག་ཙམ་བསད་པ་དང་། དེ་ནས་འགྱོད་པ་དྲག་པོས་ཀུན་ནས་བསླངས་ཏེ་ཆོས་ལ་ཞུགས་པར་བཤད། རྗེས་སུ་ལྷོ་བྲག་རྗེ་མར་པའི་ཞབས་ལ་གཏུགས། ཆོས་ཀྱི་ཆེད་དུ་དཀའ་བ་ཚད་མེད་སྤྱད་དེ་སྔོན་བསགས་ལས་ཀྱི་སྒྲིབ་པ་མཐའ་དག་བྱངས་པའི་མཐར་དབང་དང་གདམས་པ་ཡོངས་རྫོགས་ཐོབ། དེ་ནས་སྐུ་ཚེ་ཧྲིལ་པོ་དབེན་པ་བསྟེན་ཏེ་བྲག་ཕུག་ནང་སྒོམ་ཉམས་ལེན་མཛད། བོད་<span class="s2">ཡུལ་ལྷོ་ཕྱོགས་ཀྱི་</span>བྲག་ཕུག་དང་རི་ཁྲོད་མང་པོར་ཞབས་ཀྱིས་བཅགས་པས་དེ་དག་<span class="s2">ཡང་</span>གནས་ཆེན་དུ་གྱུར་<span class="s2">ནས་ཡོད</span>།</p>'''@tibetan ;
	.

told:_FormattedContent_Biography_Summary_3182
	gist:containedText '''<p>
	<style type="text/css">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 12.0px Kailasa}
span.s1 {font-kerning: none}
span.s2 {font: 12.0px Calibri; font-kerning: none}
span.s3 {font: 12.0px Arial; font-kerning: none; color: #1255cc}	</style>
</p>
<p class="p1">
	<span class="s1">ཞང་གཡུ་བྲག་པ་བརྩོན་འགྲུས་གྲགས་པའམ་</span><span class="s1">མཚན་ཡོངས་གྲགས་བླ་མ་ཞང་</span><span class="s1">ཞེས་ཞུ་བ་ཁོང་ནི།</span><span class="s2"> </span><span class="s1">དཔལ་ཕྱག་རྒྱ་ཆེན་མོའི་མང་ངག་འཆད་ཚུལ་གྱི་འགྲོས་ཐུན་མོང་མ་ཡིན་པ་གསར་གཏོད་མཛད་པ་དང་།</span><span class="s2"> </span><span class="s1">དབུས་གཙང་ཁུལ་གྱི་ས་ཁྱོན་མི་ཉུང་བ་ཞིག་གི་ཐོག་སྲིད་དབང་བཟུང་སྐབས་དྲག་པོ་གནོད་འཚེའི་ལས་བརྩམས་པའི་རྒྱུ་མཚན་གྱིས་དེང་སང་གླེང་གཞི་ཅན་གྱི་མི་སྣ་ཞིག་ཏུ་ངོས་འཛིན་བྱས།</span><span class="s2"> </span><span class="s1">དེར་བརྟེན་ཁོང་བོད་བརྒྱུད་ནང་བསྟན་དང་བོད་ཀྱི་ཆབ་སྲིད་ལོ་རྒྱུས་གཉིས་ཀའི་ཐད་ནས་གནད་འགག་ཆེ་བའི་མི་སྣ་ཞིག་ཀྱང་ཆགས་ཡོད།</span><span class="s2"> </span><span class="s1">ཁོང་གིས་ཚལ་པ་བཀའ་བརྒྱུད་པའི་ལུགས་གསར་དུ་གཏོད།</span><span class="s2"> </span><span class="s1">དེ་བཞིན་ལྷ་སའི་ཉེ་འགྲམ་དུ་གདན་ས་ཚལ་གུང་ཐང་</span><span class="s1">ཕྱག་བཏབ།</span></p>'''@tibetan ;
	.

told:_FormattedContent_Biography_Summary_3225
	gist:containedText """<p>
	<style type=\"text/css\">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 14.0px Kailasa}
span.s1 {font: 14.0px 'Times New Roman'}	</style>
</p>
<p class=\"p1\">
	ཐུའུ་བཀྭན་སྐུ་ཕྲེང་གཉིས་པ་ངག་དབང་ཆོས་ཀྱི་རྒྱ་མཚོ་ནི་ལྕང་སྐྱ་སྐུ་ཕྲེང་གཉིས་པའི་བུ་སློབ་ཡིན་ལ།<span class=\"s1\"> </span>དགོན་ལུང་བྱམས་པ་གླིང་དང་འབྲས་སྤུངས་སྒོ་མང་གྲྭ་ཚང་གཉིས་ནས་ཐོས་བསམ་མཛད།<span class=\"s1\"> </span>ཁོང་གིས་དགོན་ལུང་དགོན་གྱི་ཁྲི་རབས་ཉི་ཤུ་ཉེར་བཞི་པའི་འགན་བཞེས་ཤིང་།<span class=\"s1\"> </span>རྒྱ་ནག་གོང་མའི་བཀའ་ལྟར་རྒྱལ་དབང་སྐུ་ཕྲེང་བདུན་པའི་ཁྲི་འདོན་མཛད་སྒོ་རྩ་འཛུགས་མཛད།<span class=\"s1\"> </span>ཕྱིས་སུ་གོང་མ་ལས་མམཚན་ཐོབ་དང་འཇའ་ས་ཡང་བསྩལ།<span class=\"s1\"> </span>མཚོ་སྔོན་དུས་འཁྲུགས་ཏེ་སོག་པོ་དང་བོད་རིགས་ཀྱིས་ཆིང་གོང་མར་གྱེན་ལོག་བྱས་པས་དགོན་སྡེ་མང་པོར་གོ་ཆག་བྱུང་བ་ཁོང་གིས་བསྐྱར་བཞེངས་མཛད་ཅིང་།<span class=\"s1\"> </span>དགོན་ལུང་གི་ལྟག་རྒྱབ་ཏུ་རི་ཁྲོད་ཅིག་ཕྱག་བཏབ་ནས་ཚེ་སྨད་དུ་དེ་རུ་བཞུགས་པར་མཛད།</p>"""@tibetan ;
	.

told:_FormattedContent_Biography_Summary_3274
	gist:containedText """<p>
	<style type=\"text/css\">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 12.0px Kailasa}
span.s1 {font: 12.0px 'Times New Roman'}	</style>
</p>
<p class=\"p1\">
	ཕུར་ལྕོག་སྐུ་ཕྲེང་གསུམ་པ་བྱམས་པ་རྒྱ་མཚོ་ནི་དགེ་ལུགས་པའི་བླ་མ་གྲགས་ཆེན་ཞིག་ཡིན་ལ།<span class=\"s1\"> </span>པཎ་ཆེན་རིན་པོ་ཆེ་དང་རྒྱལ་དབང་གཉིས་ཀར་འབྲེལ་བ་དམ།<span class=\"s1\"> </span>ཁོང་ནི་པཎ་ཆེན་སྐུ་ཕྲེང་དྲུག་པ་ལས་རབ་ཏུ་བྱུང་ཞིང་སེ་ར་དགོན་དུ་ཐོས་བསམ་མཛད།<span class=\"s1\"> </span>ཕྱིས་སུ་རྒྱལ་དབང་སྐུ་ཕྲེང་བཅུ་གཉིས་པ་དང་བཅུ་གསུམ་པ་གཉིས་ཀའི་ཡོངས་འཛིན་མཛད་ཅིང་།<span class=\"s1\"> </span>རྒྱལ་དབང་སྐུ་ཕྲེང་བཅུ་གསུམ་པ་ཉིད་ཁོང་ལས་རབ་ཏུ་བྱུང་བ་ཡིན།</p>"""@tibetan ;
	.

told:_FormattedContent_Biography_Summary_3296
	gist:containedText """<p>
	<style type=\"text/css\">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 12.0px Kokonor}
span.s1 {font-kerning: none}
span.s2 {font: 12.0px 'Times New Roman'; font-kerning: none}	</style>
</p>
<p class=\"p1\">
	<span class=\"s1\">ཨ་མདོ་ཞྭ་དམར་སྐུ་ཕྲེང་བཞི་པ་དགེ་འདུན་བསྟན་འཛིན་རྒྱ་མཚོ་ནི་ཨ་མདོ་ཡུལ་གྱི་དགེ་ལུགས་པའི་མཁས་ཆེན་དམ་པ་ཞིག་ཡིན་ལ།</span><span class=\"s2\"> </span><span class=\"s1\">ཁོང་གིས་གཙོ་བོ་ལ་མོ་བདེ་ཆེན་དགོན་དང་བླ་བྲང་བཀྲ་ཤིས་འཁྱིལ་དུ་ཨ་རོལ་སྐུ་ཕྲེང་གཉིས་པ་བློ་བཟང་ལུང་རྟོགས་རྒྱ་མཚོ་དང་།</span><span class=\"s2\"> </span><span class=\"s1\">དྲུང་ཡིག་ཤེས་རབ་རྒྱ་མཚོ་སོགས་ལས་ཐོས་བསམ་མཛད།</span><span class=\"s2\"> </span><span class=\"s1\">ཁོང་གིས་སྤྱི་ལོ</span><span class=\"s2\"> </span><span class=\"s1\">༡༩༠༣</span><span class=\"s2\"> </span><span class=\"s1\">ལོར་ངྷི་ཚ་དགོན་ཕྱག་འདེབས་མཛད།</span></p>"""@tibetan ;
	.

told:_FormattedContent_Biography_Summary_3307
	gist:containedText
		'''<p class="p1">
	༧རྒྱལ་དབང་སྐུ་ཕྲེང་བཅུ་གསུམ་པ་ཐུབ་བསྟན་རྒྱ་མཚོ་ནི་འཛམ་གླིང་སྤྱི་དང་ལྷག་པར་བོད་གངས་ཅན་པའི་ལོ་རྒྱུས་ནང་དུས་ཚོད་དཀའ་རྙོག་ཆེ་ཤོས་ཤིག་གི་སྐབས་བྱོན་པ་དང་།<span class="s1"> </span><span class="s2">ཁོང་ནི་</span><span class="s3">ཐོག་མར་</span><span class="s2">དབྱིན་ཇིའི་</span><span class="s3">བཙན་འཛུལ་</span><span class="s2">དང།</span><span class="s4"> </span><span class="s2">དེ་རྗེས་མན་ཆིང་རྒྱ་ནག་གིས་བཙན་འཛུལ་བྱས་པ་ལ་བརྟེན་ནས་</span><span class="s5">ཕྱི་རྒྱལ་དུ་བྲོས་</span><span class="s2">བྱོལ་ལ་</span>ཕེབས་དགོས་བྱུང་ཡོད།<span class="s1"> </span>འོན་ཀྱང་<span class="s3">སྐབས་དེར་</span>ཁོང་ནས་<span class="s2">དེང་རབས་ཀྱི་ཚན་རིག་ལག་རྩལ་</span>དང་<span class="s6">སྲིད་གཞུང་སྣ་ཚོགས་</span>སོགས་ལ་<span class="s2">མཁྱེན་རྟོགས་ཆེན་པོ་གནང་ཐུབ་པ་བྱུང་ཡོད</span>།<span class="s1"> </span>དེ་ནས་རྒྱ་ནག་<span class="s6">མན་ཆིང་རྒྱལ་རབས་ཀྱི་སྲིད་གཞུང་</span>མགོ་རྟིང་ལོག་<span class="s5">རྗེས་</span>ཁོང་གིས་བོད་རང་བཙན་གཙང་མ་ཡིན་པའི་གསལ་བསྒྲགས་གནང་།<span class="s1"> </span>ཁོང་གིས་གསར་བརྗེའི་ལས་འགུལ་དང་ཆོས་ལུགས<span class="s6">་མཐུན་ལམ་</span>སོགས་ལས་གཞི་མང་པོ་ཞིག་བརྩམས་པར་བརྟེན། <span class="s7">རྙིང་ཞེན་ཅན་གྱི་དགེ་ལྡན་པའི་བླ་སྤྲུལ་སོགས་མང་པོ་ཞིག་གིས་འགོག་རྐྱེན་བྱས་ཤིང་།</span> <span class="s2">མཐའ་མ་བོད་དེ་དེང་རབས་ཅན་གྱི་ལམ་དུ་བསྐྱོད་རྒྱུའི་དགོངས་བཞེད་མངོན་གྱུར་མ་ཐུབ་པར་ལུས་སོ།།</span></p>'''@tibetan ,
		"""<p>
	十三世达赖喇嘛土登嘉措生活在西藏及世界历史上动荡的年代。他在英国和中国的先后侵略下被迫两次流亡，这期间他了解学习了现代科技以及各种政体。随着清政府的崩溃，他宣告了西藏的独立。他的一系列改革以及宗教折衷主义使他与许多格鲁派的保守势力产生冲突。他试图将西藏现代化的尝试遭到了他们的阻挠。</p>"""@chinese
		;
	.

told:_FormattedContent_Biography_Summary_3414
	gist:containedText """<p>
	<style type=\"text/css\">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 12.0px Kailasa}
span.s1 {font: 12.0px 'Times New Roman'}	</style>
</p>
<p class=\"p1\">
	ཕུར་ལྕོག་སྐུ་ཕྲེང་གཉིས་པ་བློ་བཟང་བྱམས་པ་ནི་ཁོང་གི་དུས་སྐབས་སུ་དགེ་སློང་གི་སྡོམ་རྒྱུན་གྱི་འབྱུང་ཁུངས་གཙོ་ཤོས་ཤིག་ཡིན་ལ།<span class=\"s1\"> </span>ཚེ་གང་བོར་དགེ་སློང་སྟོང་ཕྲག་མང་པོར་སྡོམ་པ་བསྩལ།<span class=\"s1\"> </span>ཁོང་ནི་པཎ་ཆེན་སྐུ་ཕྲེང་དྲུག་པ་དང་ཡོངས་འཛིན་ཡེ་ཤེས་རྒྱལ་མཚན་གཉིས་ཀྱི་བུ་སློབ་ཡིན།</p>"""@tibetan ;
	.

