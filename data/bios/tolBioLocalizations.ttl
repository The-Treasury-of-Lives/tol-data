span.s1 {font-kerning: none}
span.s2 {font: 12.0px Arial; font-kerning: none}	</style>
</p>
<p class="p1">
	<span class="s1">འཁྲུལ་ཞིག་སེངྒེ་རྒྱབ་པ་</span><span class="s1">ནི་རྫོགས་ཆེན་སྙིང་ཏིག་</span><span class="s2"> </span><span class="s1">གི་བརྒྱུད་པ་འཛིན་པའི་སྐྱེས་ཆེ</span><span class="s2"> </span><span class="s1">ན་ཞིག་ཡིན།</span><span class="s2"> </span><span class="s1">ཁོང་གུ་རུ་ཇོ་འབེར་</span><span class="s1">གྱི་སློབ་མ་དང་།</span><span class="s2"> </span><span class="s1">མེ་ལོང་རྡོ་རྗེའི་</span><span class="s1">བླ་མ་ཡིན།</span></p>'''@tibetan ;
	.

told:_FormattedContent_Biography_Summary_1852
	gist:containedText """<p>
	<style type=\"text/css\">
