span.s1 {font: 14.0px 'Times New Roman'}	</style>
</p>
<p class=\"p1\">
	འགྲོ་མགོན་གཡོར་པོ་མེ་དཔལ་ནི་རྫོགས་ཆེན་བོན་ཨ་ཁྲིད་ཀྱི་ཆོས་སྐོར་བརྒྱུད་པའི་བླ་རབས་ལྔ་པ་ཡིན་ལ།<span class=\"s1\"> </span>ཁོང་ནི་ཆོས་སྐོར་འདི་ལ་ཨ་ཁྲིད་ཅེས་བྱ་བའི་མིང་དངོས་སུ་འདོགས་མཁན་ཡིན།</p>"""@tibetan ;
	.

told:_FormattedContent_Biography_Summary_13092
	gist:containedText """<p>
	<style type=\"text/css\">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 14.0px Kailasa}
span.s1 {font: 14.0px 'Times New Roman'}	</style>
</p>
<p class=\"p1\">
	འ་ཞ་བློ་གྲོས་རྒྱལ་མཚན་ནི་བོན་ཨ་ཁྲིད་ཀྱི་ཆོས་སྐོར་བརྒྱུད་པའི་བླ་རབས་བདུན་པ་ཡིན་ལ།<span class=\"s1\"> </span>རྫོགས་ཆེན་ལ་སོགས་པའི་མདོ་སྔགས་ཀྱི་བསྟན་བཅོས་ལ་འགྲེལ་བ་མང་དུ་མཛད་ཅིང་།<span class=\"s1\"> </span>ཁོང་གི་གསུང་རྩོམ་ལ་དེང་གི་ཆར་ཡང་སློབ་གཉེར་བྱེད་བཞིན་ཡོད།</p>"""@tibetan ;
	.

told:_FormattedContent_Biography_Summary_13093
	gist:containedText """<p>
	<style type=\"text/css\">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 14.0px Kailasa}
span.s1 {font: 14.0px 'Times New Roman'}	</style>
</p>
<p class=\"p1\">
	བྲུ་སྟོན་འདུལ་བ་རྒྱལ་མཚན་ནི་བོན་ཨ་ཁྲིད་ཀྱི་ཆོས་སྐོར་བརྒྱུད་པའི་བླ་རབས་བརྒྱད་པ་དང་།<span class=\"s1\"> </span>དུས་རབས་བཅུ་གསུམ་པའི་དུས་མཇུག་གི་གཡས་རུ་དབེན་ས་ཁའི་ཁྲི་པ་གཙོ་ཤོས་ཤིག་ཀྱང་ཡིན།</p>"""@tibetan ;
	.

told:_FormattedContent_Biography_Summary_13094
	gist:containedText """<p>
	<style type=\"text/css\">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 12.0px Kailasa}
span.s1 {font: 12.0px 'Times New Roman'}	</style>
</p>
<p class=\"p1\">
	ངག་དབང་འཕྲིན་ལས་དཔལ་བཟང་ནི་ལྕགས་ར་སྐུ་ཕྲེང་དྲུག་པ་ཡིན་ལ།<span class=\"s1\"> </span>རྒྱལ་དབང་སྐུ་ཕྲེང་བདུན་པ་དང་སེ་ར་ཐེག་ཆེན་གླིང་གི་མཁས་ཆེན་དུ་མ་ལས་ཐོས་བསམ་མཛད།<span class=\"s1\"> </span>རྒྱ་ནག་གོང་མ་དང་རྒྱལ་དབང་སྐུ་ཕྲེང་བདུན་པས་ཧོ་ཐོག་ཐུ་ཞེས་པའི་མཚན་དང་འཇའ་ས་བསྩལ།<span class=\"s1\"> </span>ཁོང་གིས་ལྡན་ཆོས་འཁོར་གླིང་དུ་ཁྲི་བའི་འགན་བཞེས་ཤིང་།<span class=\"s1\"> </span>ལྕགས་ར་དགོན་ཡང་ཆབ་མདོ་བྱམས་པ་གླིང་ལ་ཕུལ་ནས་གཞི་གཅིག་ཏུ་བསྒྲིལ།</p>"""@tibetan ;
	.

told:_FormattedContent_Biography_Summary_13095
	gist:containedText '''<p>
	<style type="text/css">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 12.0px Kailasa}
span.s1 {font-kerning: none}
span.s2 {font: 12.0px Arial; font-kerning: none}	</style>
</p>
<p class="p1">
	<span class="s1">ལྕགས་ར་སྤྲུལ་སྐུ་སྐུ་ཕྲེང་དང་</span><span class="s1">པོ་</span><span class="s1">སངས་རྒྱས་དཔལ་འབྱོར་</span><span class="s1">ནི་ཕྱི་ལོ་བརྒྱ་ཕྲག་བཅོ་</span><span class="s2"> </span><span class="s1">ལྔ་པའི་སྨད་དང་བཅུ་དྲུག་པའི་བཞི</span><span class="s2"> </span><span class="s1">་ཆ་དང་པོའི་ནང་བྱོན་པའི་བོད་ཤར་</span><span class="s2"> </span><span class="s1">ཕྱོགས་ཆབ་མདོ་ཡུལ་གྱི་བླ་མ་ཞིག་</span><span class="s2"> </span><span class="s1">ཡིན།</span><span class="s2"> </span><span class="s1">ཁོང་འཕགས་པ་ལྷ་སྐུ་ཕྲེང་དང་པོའི</span><span class="s1">་</span><span class="s1">སྐུ་ཚ་དང་སློབ་མ་ཡིན་ཞིང་།</span><span class="s2"> </span><span class="s1">འཕགས་པ་ལྷས་བོད་ལྷོ་ཤར་ཁུལ་དུ་</span><span class="s2"> </span><span class="s1">དགོན་པ་མང་པོ་ཕྱག་འདེབས་སྐབས་</span><span class="s2"> </span><span class="s1">ཞབས་འདེགས་རྒྱ་ཆེར་བསྒྲུབས།</span><span class="s2"> </span><span class="s1">ལྕགས་ར་སྤྲུལ་སྐུ་སྐུ་ཕྲེང་རིམ་</span><span class="s2"> </span><span class="s1">བྱོན་རྣམས་ཕྱག་ན་རྡོ་རྗེའི་རྣམ་</span><span class="s2"> </span><span class="s1">སྤྲུལ་ཡིན་པར་བཤད།</span></p>'''@tibetan ;
	.

