span.s1 {font-kerning: none}
span.s2 {font: 12.0px 'Helvetica Neue'; font-kerning: none}	</style>
</p>
<p class=\"p1\">
	<span class=\"s1\">ཏིཤྲི་རས་པ་ཤེས་རབ་སེངྒེ་ནི་བླ་མ་ཞང་དང་།</span><span class=\"s2\"> </span><span class=\"s1\">ཡང་བཀའ་བརྒྱུད་པའི་བླ་མ་སྔ་རབས་པ་ཁག་གཅིག་དང་ཐུགས་འདྲིས་ཆེ་ཡང་།</span><span class=\"s2\"> </span><span class=\"s1\">དོན་དངོས་བ་རོམ་པ་དར་མ་དབང་ཕྱུག་གི་ཐུགས་སྲས་གཙོ་བོ་ཡིན་པར་བཤད།</span><span class=\"s2\"> </span><span class=\"s1\">ཕྱི་ལོ་༡༡༩༦</span><span class=\"s2\"> </span><span class=\"s1\">ལོར་མི་ཉག་རྒྱལ་ཁམས་སུ་ཕེབས་ཏེ་དེར་ལོ་ངོ་སུམ་ཅུ་ཙམ་དབུ་བླའི་ངོ་བོར་བཞུགས།</span><span class=\"s2\">&nbsp;</span></p>"""@tibetan ;
	.

told:_FormattedContent_Biography_Summary_7644
	gist:containedText """<p>
