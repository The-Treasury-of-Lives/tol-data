span.s1 {font-kerning: none}
span.s2 {font: 14.0px Calibri; font-kerning: none}	</style>
</p>
<p class="p1">
	<style type="text/css">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 14.0px Kailasa}
span.s1 {font-kerning: none}
span.s2 {font: 14.0px Calibri; font-kerning: none}	</style>
</p>
<p class="p1">
	<span class="s1">རྫོགས་ཆེན་པ་ནམ་མཁའ་ཚེ་དབང་མཆོག་གྲུབ་</span><span class="s1">ནི་རྫོགས་ཆེན་དགོན་པའི་</span><span class="s1">མཁན་རབས་དྲུག་པ་ཡིན་ཞིང་།</span><span class="s2"> </span><span class="s1">ཕྱི་ལོ་༡༧༩༢</span><span class="s2"> </span><span class="s1">ནས་ཕྱི་ལོ་བརྒྱ་ཕྲག་བཅུ་དགུ་པའི་ལོ་ངོ་བཅུ་ཕྲག་དང་པོའི་མཇུག་ཙམ་བར་མཁན་པོའི་ཁྲི་ལ་བཞུགས།</span><span class="s2"> </span><span class="s1">ཁོང་གིས་ཟླ་སྟོད་ཡང་ཤར་དུ་བཀྲ་ཤིས་རྟེན་ཆགས་དགོན་པ་</span><span class="s1">ཕྱག་བཏབ།</span></p>
<style type="text/css">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 14.0px Kailasa}
span.s1 {font-kerning: none}</style>'''@tibetan ;
	.

told:_FormattedContent_Biography_Summary_10832
	gist:containedText '''<p>
	<style type="text/css">
