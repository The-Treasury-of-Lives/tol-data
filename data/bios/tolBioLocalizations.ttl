p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 14.0px Kailasa}
span.s1 {font: 14.0px 'Times New Roman'}	</style>
</p>
<p class=\"p1\">
	ལྕང་ལུང་དཔལ་ཆེན་ནམ་མཁའ་འཇིགས་མེད་ནི་རེབ་གོང་ཡུལ་ཀྱི་ཁྱུང་དགོན་ཕྱག་འདེབས་མཁན་ཡིན་ལ།<span class=\"s1\"> </span>རེབ་གོང་སྔགས་མང་གྲས་སུ་སྙན་གྲགས་ཆེ།</p>"""@tibetan ;
	.

told:_FormattedContent_Biography_Summary_9593
	gist:containedText """<p>
	<style type=\"text/css\">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 12.0px Kailasa}
span.s1 {font: 12.0px 'Lucida Grande'}
span.s2 {font: 12.0px Georgia}	</style>
</p>
<p class=\"p1\">
	མཁན་ཆེན་ཀུན་བཟང་དཔལ་ལྡན་ནི་སྔ་འགྱུར་རྙིང་མའི་ལུགས་ལ་མཁས་པའི་ཀཿཐོག་དགོན་པའི་སློབ་དཔོན་ཞིག་ཡིན། རྫ་དཔལ་སྤྲུལ་དང་།<span class=\"s1\"> </span>འཇུ་མི་ཕམ་སོགས་རྙིང་མའི་སྐྱེས་ཆེན་མང་པོའི་ཞབས་ལ་གཏུགས། ཀློང་ཆེན་སྙིང་ཏིག་གི་གདམས་པ་འཛིན་པའི་བླ་མ་གཙོ་བོ་ཞིག་ཏུ་གྱུར། ཁོང་གིས་བྱང་ཆུབ་སེམས་དཔའི་སྤྱོད་པ་ལ་འཇུག་པའི་འགྲེལ་པ་གྲགས་ཆེ་བ་ཞིག་བརྩམས། དེ་བཞིན་ཀཿཐོག་དགོན་པའི་བཤད་གྲྭ་བཤད་སྒྲུབ་ནོར་བུ་ལྷུན་པོའི་མཁན་པོ་དང་པོ་མཛད་དེ་ལོ་གསུམ་རིང་གནང་། དེ་མཇུག་སྒྲིལ་མཚམས་ཕྱིར་རང་ཡུལ་དུ་ཕེབས་ཏེ་ཕྱི་ལོ་༡༩༤༤ ལོར་སྐུ་དགོངས་པ་མ་རྫོགས་ཀྱི་བར་ཆོས་འཆད་སྤེལ་མཛད་དེ་བཞུགས།&nbsp;</p>"""@tibetan ;
	.

told:_FormattedContent_Biography_Summary_9601
	gist:containedText """<p>
	<style type=\"text/css\">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 12.0px Kokonor}
span.s1 {font-kerning: none}
span.s2 {font: 12.0px 'Times New Roman'; font-kerning: none}	</style>
</p>
<p class=\"p1\">
	<span class=\"s1\">རྒྱལ་སྲས་གཞན་ཕན་མཐའ་ཡས་འོད་ཟེར་ནི་རྫོགས་ཆེན་དགོན་གྱི་ཤྲཱི་སེངྷ་གྲྭ་ཚང་འཛུགས་མཁན་དང་དེ་ཉིད་ཀྱི་མཁན་རབས་གཉིས་པ།</span><span class=\"s2\"> </span><span class=\"s1\">རྫོགས་ཆེན་དགོན་གྱི་གདན་རབས་བརྒྱད་པ་ཡིན།</span><span class=\"s2\"> </span><span class=\"s1\">ཕྱིས་སུ་དགེ་མང་དགོན་ཕྱག་འདེབས་མཛད་ཅིང་།</span><span class=\"s2\"> </span><span class=\"s1\">གཏེར་བདག་གླིང་པའི་རྣམ་སྤྲུལ་དུའང་བཤད།</span></p>"""@tibetan ;
	.

told:_FormattedContent_Biography_Summary_9622
	gist:containedText """<p>
	<style type=\"text/css\">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 12.0px Kailasa}
span.s1 {font: 12.0px 'Lucida Grande'}
span.s2 {font: 12.0px Georgia}
span.s3 {font: 12.0px Helvetica}
span.s4 {font: 12.0px 'Times New Roman'}	</style>
</p>
<p class=\"p1\">
	གཞན་ཕན་ཆོས་ཀྱི་སྣང་བ་ནི་ཨོ་རྒྱན་བསྟན་འཛིན་ནོར་བུའི་སློབ་མ་དང་རྫོགས་ཆེན་ཤྲཱི་སིཾཧ་བཤད་གྲྭའི་མཁན་རབས་བཅུ་དགུ་པ་ཡིན།<span class=\"s1\">&nbsp; </span>ཁོང་གིས་རྫོང་སར་ཁམས་བྱེ་བཤད་གྲྭ་ཕྱག་བཏབ་སྟེ་དགོན་པའི་མཁན་པོ་དང་པོའི་ཐུགས་འགན་བཞེས། དེ་བཞིན་རྙིང་མ་དང་། བཀའ་བརྒྱུད། ས་སྐྱ་བཅས་ཀྱི་བླ་མ་སྐྱེས་ཆེན་གྲངས་ལས་འདས་པ་རྗེས་སུ་བཟུང་། ཁོང་དང་ཁོང་གི་སློབ་མ་རྣམས་ཀྱིས་རྒྱ་གར་གཞུང་ཆེན་བཅུ་གསུམ་གསན་བསམ་གནང་སའི་བཤད་སྒྲུབ་ཀྱི་སྡེ་བརྒྱ་ལས་བརྒལ་བ་ཕྱག་བཏབ་པར་གྲགས།&nbsp;</p>"""@tibetan ;
	.

told:_FormattedContent_Biography_Summary_9634
	gist:containedText """<p>
	<style type=\"text/css\">
p.p1 {margin: 0.0px 0.0px 0.0px 0.0px; font: 14.0px Kailasa}
span.s1 {font: 14.0px 'Times New Roman'}	</style>
</p>
<p class=\"p1\">
	ཞྭ་དམར་སྐུ་ཕྲེང་དང་པོ་གྲགས་པ་སེངྒེ་ནི་ཀརྨ་པ་སྐུ་ཕྲེང་གསུམ་པ་རང་བྱུང་རྡོ་རྗེའི་བུ་སློབ་གཙོ་ཤོས་ཀྱི་གྲས་ཡིན་ལ།<span class=\"s1\"> </span>ཀརྨ་པས་ཁོང་ལ་མདོག་དམར་ནག་ཅན་གྱི་ཞྭ་མོ་གྲགས་ཅན་དེ་བསྩལ་བས་ཁོང་གི་མིང་ལའང་ཞྭ་དམར་པ་ཞེས་ཐོགས།<span class=\"s1\"> </span>ཁོང་གིས་བཀའ་གདམས་པའི་གསང་ཕུ་དགོན་དུ་ལོ་དུ་མར་ཐོས་བསམ་གནང་ནས་རྒྱ་གཞུང་མང་པོར་ནང་བྱན་ཆུབ་པར་མཛད་མོད།<span class=\"s1\"> </span>སྡོམ་པ་ནི་བདེ་ཆེན་སྟེང་སོགས་བཀའ་བརྒྱུད་པའི་དགོན་སྡེ་མི་གཅིག་པའི་བླ་མ་སྐོར་ཞིག་ལས་བླངས་ཤིང་།<span class=\"s1\"> </span>བཀའ་བརྒྱུད་པའི་སྔགས་ཀྱི་རྗེས་གནང་ཡང་མང་པོ་ཐོབ།<span class=\"s1\"> </span>ཁོང་ནི་སྐུ་ཚེ་གང་བོར་རྗེ་མི་ལ་རས་པ་དང་འབྲེལ་བའི་རི་ཁྲོད་ཁག་ཏུ་སྒོམ་སྒྲུབ་ལ་གཞོལ་ཞིང་།<span class=\"s1\"> </span>མཚུར་ཕུ་དགོན་གྱི་ཉེ་སར་གནས་ནང་དགོན་ཕྱག་བཏབ།<span class=\"s1\">&nbsp;</span></p>"""@tibetan ;
	.

told:_FormattedContent_Biography_Summary_9690
	gist:containedText """<p>
