told:_IntellectualProperty_140
	a gist:IntellectualProperty ;
	skos:prefLabel "Pang Lotsawa with Jangchub Tsemo and Drakpa Gyeltsen"@en ;
	gist:description """<p>
	This mural from Jora Monastery in Lhoka, Tibet depicts Pang Lotsawa in the center with his nephews Jangchub Tsemo to the left and Drakpa Gyeltsen to the right. The Jora incarnations are considered emanations of Bodong Panchen, himself a nephew of Drakpa Gyeltsen.</p>"""@en ;
	gist:isCategorizedBy tolx:_WorkType_painting ;
	gist:isMemberOf told:_ArtCollection_jorra_monastery ;
	gist:name "Pang Lotsawa with Jangchub Tsemo and Drakpa Gyeltsen"@en ;
	tolo:credit "Gedun Rabsal"^^xsd:string ;
	.

told:_IntellectualProperty_15
	a gist:IntellectualProperty ;
	skos:prefLabel "Jetsun Drakpa Gyeltsen"@en ;
	gist:description """<p>
	Drakpa Gyaltsen and Sakya Pandita, uncle and nephew, teacher and student surrounded by the lineage Kings of Shambhala. This composition belongs to a larger set of paintings depicting the Lamdre Lineage of the Sakya Tradition of Tibetan Buddhism in a two figure per composition configuration.</p>"""@en ;
	gist:isCategorizedBy tolx:_WorkType_painting ;
