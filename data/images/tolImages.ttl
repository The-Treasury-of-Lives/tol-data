told:_IntellectualProperty_119
	a gist:IntellectualProperty ;
	skos:prefLabel "Avalokiteśvara"@en ;
	gist:description """<p>
        This sixteenth-century thangka&nbsp;of Avalokiteśvara depicts the teaching lineage named for&nbsp;<a href=\"https://treasuryoflives.org/biographies/view/Tsembupa/TBRC_P9999\">Tsembupa</a>&nbsp;known as&nbsp;'tshem bu lugs', one of the five great systems of Avalokiteśvara practice in Tibet. This system is well preserved in Geluk and Sakya traditions.</p>"""@en ;
	gist:isCategorizedBy tolx:_WorkType_painting ;
	gist:isConnectedTo told:_HistoricalPeriod_61 ;
