told:_IntellectualProperty_70
	a gist:IntellectualProperty ;
	skos:prefLabel "Rinchen Sadutshang with Taklha Phuntsok Tashi"@en ;
	gist:description """<p>
	Rinchen Sadutshang, a fifth rank official at the Tibetan foreign ministry, with his colleague Takla Phuntsok Tashi, a brother in law of the Fourteenth Dalai Lama, in front of the Potala in 1952. Sadutshang would later become a Kalon in India in 1978 and would become the Representative at the Bureau of the Dalai Lama in Delhi, his last post before retirement.&nbsp;</p>
<p>
	&nbsp;</p>"""@en ;
	gist:isCategorizedBy tolx:_WorkType_photograph ;
	gist:isConnectedTo told:_HistoricalPeriod_79 ;
	gist:name "Rinchen Sadutshang with Taklha Phuntsok Tashi"@en ;
