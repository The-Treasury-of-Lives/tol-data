	a gist:IntellectualProperty ;
	skos:prefLabel "Wangdu Nyingpo and other masters"@en ;
	gist:description """<p>
	Wangdu Nyinpo was the Twenty-ninth Sakya Tridzin. This painting gives visual representation to his previous incarnations, which include Padmasambhava, and some of his disciples.</p>"""@en ;
