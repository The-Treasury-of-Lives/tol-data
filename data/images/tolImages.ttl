	gist:description """<p>
	Lo Gendun Sadutshang with Khampas he had gathered as armed guards to escort the young Fourteenth Dalai Lama, who had just assumed full political power, from the capital Lhasa to Yatung by the border for safety, in December 1951.&nbsp;</p>
<div>
	&nbsp;</div>"""@en ;
	gist:isCategorizedBy tolx:_WorkType_photograph ;
	gist:isConnectedTo told:_HistoricalPeriod_79 ;
	gist:name "Lo Gendun Sadutshang with Khampas, 1951"@en ;
	tolo:credit "A Life Unforeseen: A Memoir of Service to Tibet by Rinchen Sadutshang"^^xsd:string ;
	.

told:_IntellectualProperty_72
