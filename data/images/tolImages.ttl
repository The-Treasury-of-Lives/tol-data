told:_IntellectualProperty_1
	a gist:IntellectualProperty ;
	skos:prefLabel "Tsongkhapa"@en ;
	gist:description """<p>
	A painting of Tsongkapa, founder of the Geluk tradition, with the two principal students, Gyaltsab on the left and Khedrub on the right.</p>"""@en ;
	gist:isCategorizedBy tolx:_WorkType_painting ;
	gist:isConnectedTo told:_HistoricalPeriod_59 ;
	gist:isIdentifiedBy told:_ID_har_595 ;
	gist:isMemberOf told:_ArtCollection_rubin_museum_of_of_himlayan_art ;
	gist:name "Tsongkhapa"@en ;
	tolo:credit "Rubin Museum of Himalayan Art"^^xsd:string ;
	.

told:_IntellectualProperty_10
	a gist:IntellectualProperty ;
	skos:prefLabel "Damarupa"@en ;
	gist:description """<p>
	Damarupa and Avadhutipa, two Indian Siddhas. On the left is the siddha Damarupa holding upraised in his right hand a damaru drum and a skullcup in the left. On the viewer's right is Avadhutipa holding a skullcup to the heart with the left hand and pointing downwards with the right hand.</p>"""@en ;
	gist:isCategorizedBy tolx:_WorkType_painting ;
	gist:isConnectedTo told:_HistoricalPeriod_61 ;
	gist:isIdentifiedBy told:_ID_har_946 ;
	gist:isMemberOf <https://w3id.org/treasuryoflives/ns/data/tol/_ArtCollection_collection_of_shelley_&_donald_rubin_> ;
	gist:name "Damarupa"@en ;
	.

told:_IntellectualProperty_100
	a gist:IntellectualProperty ;
	skos:prefLabel "Machik Labdron"@en ;
	gist:description """<p>
	19th Century painting of Machig Labdron as a wisdom dakini.</p>"""@en ;
	gist:isCategorizedBy tolx:_WorkType_painting ;
	gist:isConnectedTo told:_HistoricalPeriod_73 ;
	gist:isIdentifiedBy told:_ID_har_57037 ;
	gist:isMemberOf told:_ArtCollection_rubin_museum_of_himalayan_art ;
	gist:name "Machik Labdron"@en ;
	.

told:_IntellectualProperty_101
	a gist:IntellectualProperty ;
	skos:prefLabel "Machik Labdron and Chod Refuge Field"@en ;
	gist:description """<p>
	Mid-20th century painting of Machik Labdron and the Chod refuge field displaying teachers and deities.&nbsp;</p>"""@en ;
	gist:isCategorizedBy tolx:_WorkType_painting ;
	gist:isConnectedTo told:_HistoricalPeriod_79 ;
	gist:isIdentifiedBy told:_ID_har_223 ;
	gist:isMemberOf told:_ArtCollection_rubin_museum_of_himalayan_art ;
	gist:name "Machik Labdron and Chod Refuge Field"@en ;
	.

told:_IntellectualProperty_102
	a gist:IntellectualProperty ;
	skos:prefLabel "Padmasambhava - Guru Drakpo"@en ;
	gist:description '''<p>
	This 20th century painting depicts Padmasambhava in wrathful form as Guru Dragpo, in the treasure tradition of Padmasambhava biographer <a href="/biographies/view/Nyangrel-Nyima-Ozer/TBRC_P364">Nyangrel Nyima Ozer</a>.</p>'''@en ;
	gist:isCategorizedBy tolx:_WorkType_painting ;
	gist:isConnectedTo told:_HistoricalPeriod_77 ;
	gist:isIdentifiedBy told:_ID_har_9 ;
	gist:isMemberOf told:_ArtCollection_rubin_museum_of_himalayan_art ;
	gist:name "Padmasambhava - Guru Drakpo"@en ;
	.

told:_IntellectualProperty_103
	a gist:IntellectualProperty ;
	skos:prefLabel "Namkhai Nyingpo"@en ;
	gist:description """<p>
	Namkhai Nyingpo, one of the twenty-five disciples of <a href=\"/biographies/view/Padmasambhava/TBRC_P4956\">Padmasambhava</a>, is depicted with long-life ritual implements. Other details of this nineteenth century painting from Kham suggest a elements from <a href=\"/biographies/view/Jamgon-Kongtrul's/TBRC_P264\">Jamgon Kongtrul's</a> story of Namkhai Nyingpo and Dorje Tso.&nbsp;</p>"""@en ;
	gist:isCategorizedBy tolx:_WorkType_painting ;
	gist:isConnectedTo told:_HistoricalPeriod_73 ;
	gist:isIdentifiedBy told:_ID_har_678 ;
	gist:isMemberOf told:_ArtCollection_rubin_museum_of_himalayan_art ;
	gist:name "Namkhai Nyingpo"@en ;
	.

told:_IntellectualProperty_104
	a gist:IntellectualProperty ;
	skos:prefLabel "Avalokiteśvara"@en ;
	gist:description """<p>
	Ivory sculpture of Avalokiteśvara is attributed to the Tenth Karmapa, Choying Dorje, and is dated to 1647/1648 or 1658.</p>"""@en ;
	gist:isCategorizedBy tolx:_WorkType_sculpture ;
	gist:isConnectedTo told:_HistoricalPeriod_65 ;
	gist:isIdentifiedBy told:_ID_har_31668 ;
	gist:isMemberOf told:_ArtCollection__cleveland_museum_of_art ;
	gist:name "Avalokiteśvara"@en ;
	tolo:credit "Cleveland Museum of Art"^^xsd:string ;
	tolo:hasCreator told:_Person_2662 ;
	.

told:_IntellectualProperty_105
	a gist:IntellectualProperty ;
	skos:prefLabel "Pehar Gyelpo"@en ;
	gist:description """<p>
	The protector deity Pehar Gyelpo is depicted with three Geluk masters above.&nbsp;</p>"""@en ;
	gist:isCategorizedBy tolx:_WorkType_painting ;
	gist:isConnectedTo told:_HistoricalPeriod_73 ;
	gist:isIdentifiedBy told:_ID_har_213 ;
	gist:isMemberOf told:_ArtCollection_rubin_museum_of_himalayan_art ;
	gist:name "Pehar Gyelpo"@en ;
	.

told:_IntellectualProperty_106
	a gist:IntellectualProperty ;
	skos:prefLabel "Jnanatapa"@en ;
	gist:description """<p>
        Jnanatapa is the central figure in this fourteenth-century painting from Tibet. The Eight Mahasiddhas are depicted along with lineage figures from Taklung and Riwoche Monasteries.&nbsp;</p>"""@en ;
	gist:isCategorizedBy tolx:_WorkType_painting ;
	gist:isConnectedTo told:_HistoricalPeriod_55 ;
	gist:isIdentifiedBy told:_ID_har_101352 ;
	gist:isMemberOf told:_ArtCollection_the_metropolitan_museum_of_art ;
	gist:name "Jnanatapa"@en ;
	.

told:_IntellectualProperty_107
	a gist:IntellectualProperty ;
	skos:prefLabel "Bodhisattva with Atisa and Dromton"@en ;
	gist:description """<p>
	This eighteenth century painting of a Bodhisattva depicts Atiśa and Kadam founder Dromton on the top (left and right). Tara and Jambala are pictured along the bottom. Dromton is considered an emanation of Padmapani Avalokiteśvara, who is the central figure in this image according to some sources. However, the presence of a sword and book suggests that the central figure is Mañjuśrī.</p>"""@en ;
	gist:isCategorizedBy tolx:_WorkType_painting ;
	gist:isConnectedTo told:_HistoricalPeriod_70 ;
	gist:isIdentifiedBy told:_ID_har_59247 ;
	gist:isMemberOf told:_ArtCollection_the_cleveland_museum_of_art ;
	gist:name "Bodhisattva with Atisa and Dromton"@en ;
	tolo:credit "Cleveland Museum of Art"^^xsd:string ;
	.

told:_IntellectualProperty_108
	a gist:IntellectualProperty ;
	skos:prefLabel "Atiśa"@en ;
	gist:description """<p>
	This painting of Atiśa is from the early to mid twelfth century and features extensive inscriptions on the reverse side.&nbsp;</p>"""@en ;
